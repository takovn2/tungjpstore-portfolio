# Local 9Router only. Never commit a real key or expose it as PUBLIC_*.
ROUTER_IMAGE_ENDPOINT=http://localhost:20128/v1/images/generations
ROUTER_IMAGE_MODEL=cx/gpt-5.5-image
ROUTER_API_KEY=
ROUTER_IMAGE_SIZE=1792x1024
ROUTER_IMAGE_QUALITY=high
ROUTER_IMAGE_BACKGROUND=opaque
ROUTER_IMAGE_DETAIL=high
ROUTER_IMAGE_FORMAT=png
ROUTER_IMAGE_OUTPUT=public/generated/image.png
PUBLIC_CLOUDFLARE_ANALYTICS_TOKEN=

# Shop payment infrastructure. Keep real values out of git; production uses
# Cloudflare Worker Secrets set with `wrangler secret put`.
# payOS is the payment provider. VietQR only renders the customer-facing QR.
SHOP_PUBLIC_ORIGIN=https://tung.codes
SHOP_ORDER_TOKEN_SECRET=
SHOP_KEY_ENCRYPTION_SECRET=
SHOP_KEY_ENCRYPTION_KEY_VERSION=v1
VIETQR_BANK_ACCOUNT=
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# Public contact protection and transactional mail (production secrets stay in
# the Worker secret store; these placeholders are for local shape only).
CONTACT_HASH_SECRET=
TURNSTILE_SECRET_KEY=
TRANSACTIONAL_EMAIL_FROM_ADDRESS=orders@tungjpstore.net
TRANSACTIONAL_EMAIL_FROM_NAME=TUNG Shop
TRANSACTIONAL_EMAIL_DELIVER_KEYS=0

# Crypto verification providers. Keep real values in Cloudflare Worker Secrets;
# the admin UI stores only destination UID/wallet configuration, never keys.
BYBIT_API_KEY=
BYBIT_API_SECRET=
BINANCE_API_KEY=
BINANCE_API_SECRET=
# Optional staging/testnet endpoint overrides.
BYBIT_API_BASE_URL=
BINANCE_API_BASE_URL=
# Private cron authentication for provider reconciliation.
SHOP_CRON_SECRET=

# Legacy Telegram environment fallback. New bots are onboarded through the
# encrypted /admin registry; never commit real fallback values.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Dedicated 32-byte canonical-base64url root key for encrypting dynamic bot
# credentials. Keep this separate from SHOP_KEY_ENCRYPTION_SECRET and never
# copy a production value into this file.
TELEGRAM_TOKEN_ENCRYPTION_SECRET=
TELEGRAM_TOKEN_ENCRYPTION_KEY_VERSION=v1
# JSON object of old key-version -> base64url root, stored only as a Worker
# secret during a bounded rewrap window; leave empty during normal operation.
TELEGRAM_TOKEN_ENCRYPTION_PREVIOUS_KEYS=
