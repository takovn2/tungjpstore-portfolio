---
/**
 * AuroraCanvas — lightweight HTML5 canvas ambience for the Porcelain White shop.
 * Draws a slow-drifting constellation of soft dots with hairline links on white.
 * Progressive enhancement: hidden when JS/canvas unavailable, static frame when
 * prefers-reduced-motion. Zero dependencies, ~1.5KB.
 */
interface Props {
  /** Unique id for the canvas element (needed when multiple canvases exist). */
  id?: string;
  /** Render the fine dot-grid overlay on top of the canvas. */
  dotgrid?: boolean;
  class?: string;
}
const { id = `shop-aurora-canvas-${Math.random().toString(36).slice(2, 8)}`, dotgrid = false, class: className } = Astro.props;
---

<div class:list={["shop-aurora", className]} aria-hidden="true">
  <canvas data-aurora-canvas id={id}></canvas>
  {dotgrid && <div class="shop-dotgrid"></div>}
</div>

<script is:inline>
  (() => {
    if (window.__shopAuroraInit) return;
    window.__shopAuroraInit = true;
    const canvases = document.querySelectorAll("canvas[data-aurora-canvas]");
    if (!canvases.length) return;
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    const initCanvas = (canvas) => {
      const ctx = canvas.getContext && canvas.getContext("2d");
      if (!ctx) return null;
      const host = canvas.parentElement;
      if (host && getComputedStyle(host).position === "static") host.style.position = "relative";
      const state = { canvas, ctx, dots: [], w: 0, h: 0, dpr: 1 };
      sizeCanvas(state);
      return state;
    };
    const sizeCanvas = (state) => {
      const rect = state.canvas.parentElement.getBoundingClientRect();
      state.w = Math.max(1, Math.round(rect.width));
      state.h = Math.max(1, Math.round(rect.height));
      state.dpr = Math.min(2, window.devicePixelRatio || 1);
      state.canvas.width = state.w * state.dpr;
      state.canvas.height = state.h * state.dpr;
      state.ctx.setTransform(state.dpr, 0, 0, state.dpr, 0, 0);
      const target = Math.min(46, Math.max(14, Math.round((state.w * state.h) / 26000)));
      while (state.dots.length < target) {
        state.dots.push({
          x: Math.random() * state.w,
          y: Math.random() * state.h,
          vx: (Math.random() - 0.5) * 0.16,
          vy: (Math.random() - 0.5) * 0.13,
          r: 0.9 + Math.random() * 1.7,
          phase: Math.random() * Math.PI * 2,
        });
      }
      state.dots.length = target;
    };
    const drawFrame = (state, t) => {
      const { ctx, w, h, dots } = state;
      ctx.clearRect(0, 0, w, h);
      for (const dot of dots) {
        dot.x += dot.vx; dot.y += dot.vy;
        if (dot.x < -8) dot.x = w + 8; else if (dot.x > w + 8) dot.x = -8;
        if (dot.y < -8) dot.y = h + 8; else if (dot.y > h + 8) dot.y = -8;
      }
      ctx.lineWidth = 1;
      for (let i = 0; i < dots.length; i++) {
        for (let j = i + 1; j < dots.length; j++) {
          const dist = Math.hypot(dots[i].x - dots[j].x, dots[i].y - dots[j].y);
          if (dist < 130) {
            ctx.strokeStyle = `rgba(59, 76, 108, ${((1 - dist / 130) * 0.1).toFixed(3)})`;
            ctx.beginPath();
            ctx.moveTo(dots[i].x, dots[i].y);
            ctx.lineTo(dots[j].x, dots[j].y);
            ctx.stroke();
          }
        }
      }
      for (const dot of dots) {
        const breathe = 0.55 + 0.45 * Math.sin(t * 0.7 + dot.phase);
        ctx.fillStyle = `rgba(59, 76, 108, ${(0.1 + 0.14 * breathe).toFixed(3)})`;
        ctx.beginPath();
        ctx.arc(dot.x, dot.y, dot.r, 0, Math.PI * 2);
        ctx.fill();
      }
    };

    const instances = [];
    canvases.forEach((canvas) => {
      const state = initCanvas(canvas);
      if (state) instances.push(state);
    });
    if (!instances.length) return;

    if (reduced) {
      instances.forEach((state) => drawFrame(state, 0));
      return;
    }
    let raf = 0;
    const tick = (now) => {
      for (const state of instances) drawFrame(state, now / 1000);
      raf = requestAnimationFrame(tick);
    };
    raf = requestAnimationFrame(tick);
    document.addEventListener("visibilitychange", () => {
      if (document.hidden) { cancelAnimationFrame(raf); raf = 0; }
      else if (!raf) raf = requestAnimationFrame(tick);
    });
    let resizeTimer = 0;
    window.addEventListener("resize", () => {
      window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => instances.forEach(sizeCanvas), 150);
    });
  })();
</script>
