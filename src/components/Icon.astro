---
type IconName =
  | "compass"
  | "layout"
  | "database"
  | "cloud"
  | "flow"
  | "layers"
  | "shield"
  | "arrow"
  | "clock"
  | "article";

interface Props {
  name: IconName;
  title?: string;
  size?: number;
  strokeWidth?: number;
  class?: string;
}

const { name, title, size = 24, strokeWidth = 1.6, class: className } = Astro.props;
const labelled = Boolean(title);
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  role={labelled ? "img" : undefined}
  aria-label={labelled ? title : undefined}
  aria-hidden={labelled ? undefined : "true"}
>
  {name === "compass" && <><circle cx="12" cy="12" r="8.5" /><path d="m15.4 8.6-1.8 5-5 1.8 1.8-5 5-1.8Z" /></>}
  {name === "layout" && <><rect x="3.5" y="4" width="17" height="16" rx="1" /><path d="M3.5 9h17M9 9v11" /><path d="M13 13h4M13 16h2.5" /></>}
  {name === "database" && <><ellipse cx="12" cy="5.5" rx="7.5" ry="3" /><path d="M4.5 5.5v6c0 1.7 3.4 3 7.5 3s7.5-1.3 7.5-3v-6M4.5 11.5v6c0 1.7 3.4 3 7.5 3s7.5-1.3 7.5-3v-6" /></>}
  {name === "cloud" && <><path d="M7.2 18.5h10.2a3.6 3.6 0 0 0 .4-7.2A5.8 5.8 0 0 0 6.7 9.7a4.4 4.4 0 0 0 .5 8.8Z" /><path d="M9 15.5h6M12 12.5v6" /></>}
  {name === "flow" && <><circle cx="5" cy="6" r="2" /><circle cx="19" cy="6" r="2" /><circle cx="12" cy="18" r="2" /><path d="M7 6h10M6.5 7.5l4.4 8.8M17.5 7.5l-4.4 8.8" /></>}
  {name === "layers" && <><path d="m12 3 8 4.5-8 4.5-8-4.5L12 3Z" /><path d="m4 12 8 4.5 8-4.5M4 16.5l8 4.5 8-4.5" /></>}
  {name === "shield" && <><path d="M12 3 5.5 5.7v5.5c0 4.1 2.5 7.6 6.5 9.8 4-2.2 6.5-5.7 6.5-9.8V5.7L12 3Z" /><path d="m9.2 12 1.8 1.8 4-4" /></>}
  {name === "arrow" && <><path d="M5 12h13M13 7l5 5-5 5" /></>}
  {name === "clock" && <><circle cx="12" cy="12" r="8.5" /><path d="M12 7v5l3.2 1.8" /></>}
  {name === "article" && <><path d="M6 3.5h9l3 3V20.5H6z" /><path d="M15 3.5v3h3M9 11h6M9 15h6" /></>}
</svg>
