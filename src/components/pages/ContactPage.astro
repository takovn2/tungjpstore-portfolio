---
import BaseLayout from "../../layouts/BaseLayout.astro";
import FlywheelBand from "../shop/FlywheelBand.astro";
import { getTranslation, type Locale } from "../../i18n/dictionaries";
import { siteConfig } from "../../content/site";
import type { PublicSiteSection } from "../../lib/public-content";
import { env } from "cloudflare:workers";

type Copy = ReturnType<typeof getTranslation>;
interface Props { locale: Locale; contactContent?: Copy["contact"]; contactSection?: PublicSiteSection | null; contactEmail?: string | null; }

const { locale, contactContent, contactSection, contactEmail } = Astro.props;
const t = getTranslation(locale);
const base = contactContent ?? t.contact;
const c = contactSection ? {
  ...base,
  metaTitle: contactSection.seoTitle || base.metaTitle,
  metaDescription: contactSection.seoDescription || contactSection.excerpt || base.metaDescription,
  label: contactSection.eyebrow || base.label,
  heading: contactSection.title || base.heading,
  intro: contactSection.excerpt || base.intro,
} : base;
const directEmail = contactEmail?.trim() || siteConfig.email || "hello@tung.codes";
const directEmailHref = `mailto:${encodeURIComponent(directEmail)}`;
const turnstileSiteKey = (env as { TURNSTILE_SITE_KEY?: string }).TURNSTILE_SITE_KEY?.trim() || "";
const structuredData = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  mainEntity: {
    "@id": "https://tung.codes/#person",
    "@type": "Person",
    name: "TUNG",
    contactPoint: {
      "@type": "ContactPoint",
      contactType: "sales",
      description: "Project inquiries for website design, SME infrastructure, security/performance/SEO and full-stack SaaS development.",
      email: directEmail,
      availableLanguage: ["vi", "en", "ja", "zh"],
    },
  },
};
---

<BaseLayout title={c.metaTitle} description={c.metaDescription} locale={locale} structuredData={structuredData}>
  <article class="content-page contact-page">
    <header class="page-hero shell">
      <p class="section-label">{c.label}</p>
      <h1 class="page-title">{c.heading}</h1>
      <div class="page-hero__meta">
        <span class="mono-label">{c.responseNote}</span>
        <p class="lead">{c.intro}</p>
      </div>
    </header>

    <section class="shell contact-layout">
      <div>
        <p class="section-label">{c.formTitle}</p>
        <p class="contact-note">{c.responseNote}</p>
        <p class="contact-note">{c.fallback}</p>
        <a class="text-link" href={directEmailHref}>{c.directEmail} ↗</a>
        <p class="section-label" style="margin-top: 2rem;">{c.serviceTitle}</p>
        <ul class="line-list" role="list">
          {c.serviceItems.map((item) => <li>{item}</li>)}
        </ul>
        <p class="mono-label" style="margin-top: 1.5rem;">{c.expectationLabel}</p>
        <ul class="line-list" role="list">{c.expectationItems.map((item) => <li>{item}</li>)}</ul>
        <p class="contact-note" style="margin-top: 1.25rem;">{c.fitSummary}</p>
      </div>

      <form class="contact-form" method="post" action="/api/contact" data-contact-form>
        <div class="form-grid">
          <label>
            <span>{c.fields.name}</span>
            <input name="name" autocomplete="name" placeholder={c.placeholders.name} required minlength="2" maxlength="80" />
          </label>
          <label>
            <span>{c.fields.email}</span>
            <input name="email" type="email" autocomplete="email" placeholder={c.placeholders.email} required maxlength="160" />
          </label>
          <label>
            <span>{c.fields.company}</span>
            <input name="company" autocomplete="organization" placeholder={c.placeholders.company} maxlength="120" />
          </label>
          <label>
            <span>{c.fields.website}</span>
            <input name="website" type="url" autocomplete="url" placeholder={c.placeholders.website} maxlength="300" />
          </label>
        </div>
        <label>
          <span>{c.fields.building}</span>
          <textarea name="building" rows="3" placeholder={c.placeholders.building} required minlength="10" maxlength="1000"></textarea>
        </label>
        <label>
          <span>{c.fields.problem}</span>
          <textarea name="message" rows="5" placeholder={c.placeholders.problem} required minlength="20" maxlength="1900"></textarea>
        </label>
        <label class="honeypot" aria-hidden="true">
          <span>{c.fields.honeypot}</span>
          <input name="website_confirm" tabindex="-1" autocomplete="off" />
        </label>
        <input type="hidden" name="locale" value={locale} />
        {turnstileSiteKey && <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-theme="dark" data-size="flexible" data-refresh-expired="auto" data-refresh-timeout="auto"></div>}
        <button class="button-link primary" type="submit" data-submit-button>{c.submit} <span aria-hidden="true">↗</span></button>
        <p class="form-status" id="contact-form-status" role="status" aria-live="polite" aria-atomic="true" data-form-status></p>
        <noscript><p class="noscript-note">{c.fallback}</p></noscript>
      </form>
    </section>
  </article>
  <Fragment slot="page-scripts">
    {turnstileSiteKey && <script is:inline async defer src="https://challenges.cloudflare.com/turnstile/v0/api.js"></script>}
    <script is:inline define:vars={{ copy: c, locale }}>
  // This script is emitted as plain JavaScript, so keep DOM queries free of TypeScript syntax.
  const form = document.querySelector("[data-contact-form]");
  const status = document.querySelector("[data-form-status]");
  const submitButton = document.querySelector("[data-submit-button]");
  const turnstileWidget = form?.querySelector?.(".cf-turnstile");
  let invalidField = null;
  const resetTurnstile = () => {
    try {
      if (turnstileWidget) window.turnstile?.reset?.(turnstileWidget);
    } catch { /* The widget may not have rendered yet. */ }
  };
  const readTurnstileToken = (data) => {
    const fieldToken = String(data.get("cf-turnstile-response") || "").trim();
    if (fieldToken) return fieldToken;
    try {
      return String(window.turnstile?.getResponse?.(turnstileWidget) || "").trim();
    } catch { return ""; }
  };

  // Keep native browser validation available when this enhancement cannot run.
  form?.setAttribute?.("novalidate", "");

  const field = (name) => form?.querySelector(`[name="${name}"]`);
  const clearFieldError = (input) => {
    input?.removeAttribute("aria-invalid");
    input?.removeAttribute("aria-errormessage");
    if (invalidField === input) invalidField = null;
  };
  const showError = (input, message) => {
    clearFieldError(invalidField);
    input?.setAttribute("aria-invalid", "true");
    input?.setAttribute("aria-errormessage", "contact-form-status");
    invalidField = input;
    status.textContent = message;
    status.dataset.state = "validation";
    input?.focus();
  };

  form?.addEventListener("input", (event) => {
    const input = event.target;
    if (input?.getAttribute?.("aria-invalid") !== "true") return;
    clearFieldError(input);
    if (status?.dataset.state === "validation") {
      status.textContent = "";
      delete status.dataset.state;
    }
  });

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!status) return;

    form.querySelectorAll("[aria-invalid], [aria-errormessage]").forEach(clearFieldError);
    const data = new FormData(form);
    const name = String(data.get("name") || "").trim();
    const email = String(data.get("email") || "").trim();
    const company = String(data.get("company") || "").trim();
    const projectWebsite = String(data.get("website") || "").trim();
    const building = String(data.get("building") || "").trim();
    const message = String(data.get("message") || "").trim();
    const turnstileToken = readTurnstileToken(data);

    if (name.length < 2) { showError(field("name"), copy.validation.nameRequired); return; }
    if (!email) { showError(field("email"), copy.validation.emailRequired); return; }
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) { showError(field("email"), copy.validation.emailInvalid); return; }
    if (projectWebsite) {
      try {
        const url = new URL(projectWebsite);
        if (url.protocol !== "http:" && url.protocol !== "https:") throw new Error("unsupported_protocol");
      } catch {
        showError(field("website"), copy.validation.generic);
        return;
      }
    }
    if (building.length < 10) { showError(field("building"), copy.validation.buildingRequired); return; }
    if (message.length < 20) { showError(field("message"), copy.validation.problemRequired); return; }

    status.textContent = copy.sending;
    status.dataset.state = "sending";
    if (submitButton) submitButton.disabled = true;
    const payload = {
      name,
      email,
      company,
      projectWebsite,
      building,
      message,
      website: String(data.get("website_confirm") || ""),
      locale,
      turnstileToken,
    };

    try {
      const response = await fetch("/api/contact", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify(payload),
      });
      const result = await response.json();
      if (!response.ok || !result.ok) throw new Error(result.code);
      status.textContent = copy.success;
      status.dataset.state = "success";
      form.reset();
    } catch {
      status.textContent = `${copy.error} ${copy.fallback}`;
      status.dataset.state = "error";
    } finally {
      if (submitButton) submitButton.disabled = false;
      resetTurnstile();
    }
  });
    </script>
  </Fragment>

  <FlywheelBand locale={locale} surface="contact" />
</BaseLayout>
