  </div>

  <ConciergePanel locale={locale} />

  <button type="button" class="shop-cart-overlay" data-shop-cart-overlay data-shop-cart-close aria-label={locale === "vi" ? "Đóng giỏ hàng" : locale === "ja" ? "カートを閉じる" : locale === "zh" ? "关闭购物车" : "Close cart"} hidden></button>
  <aside class="shop-cart-drawer" id="shop-cart-drawer" data-shop-cart-drawer role="dialog" aria-modal="true" aria-labelledby="shop-cart-title" aria-hidden="true" tabindex="-1" hidden>
    <div class="shop-cart-drawer__head">
      <div>
        <p class="shop-cart-drawer__kicker">TUNG Shop</p>
        <h2 id="shop-cart-title">{labels.cartTitle}</h2>
      </div>
      <button type="button" data-shop-cart-close aria-label={locale === "vi" ? "Đóng giỏ hàng" : locale === "ja" ? "カートを閉じる" : locale === "zh" ? "关闭购物车" : "Close cart"}>×</button>
    </div>
    <div class="shop-cart-drawer__items" data-shop-cart-items><p class="shop-cart-drawer__empty">{labels.cartEmpty}</p></div>
    <div class="shop-cart-drawer__foot">
      <div><span>{labels.units}</span><strong data-shop-cart-total>0</strong></div>
      <a class="storefront__button" href={checkoutPath} data-shop-cart-checkout>{labels.checkout}</a>
      <a class="shop-cart-drawer__continue" href="#catalog" data-shop-cart-close>{labels.continue}</a>
    </div>
  </aside>

  <Fragment slot="page-scripts">
    <script is:inline define:vars={{ cartPath, shopImageRevision: SHOP_IMAGE_REVISION, labels: { cartEmpty: labels.cartEmpty, checkout: labels.checkout, units: labels.units, increase: locale === "vi" ? "Tăng số lượng" : locale === "ja" ? "数量を増やす" : locale === "zh" ? "增加数量" : "Increase quantity", decrease: locale === "vi" ? "Giảm số lượng" : locale === "ja" ? "数量を減らす" : locale === "zh" ? "减少数量" : "Decrease quantity", remove: locale === "vi" ? "Xóa sản phẩm" : locale === "ja" ? "商品を削除" : locale === "zh" ? "删除商品" : "Remove item" }, locale }}>
      const cartStorageKey = "tung:shop:cart:v1";
      const cartDrawer = document.querySelector("[data-shop-cart-drawer]");
      const cartOverlay = document.querySelector("[data-shop-cart-overlay]");
      const cartItemsElement = document.querySelector("[data-shop-cart-items]");
      const cartTotalElement = document.querySelector("[data-shop-cart-total]");
      const countElements = Array.from(document.querySelectorAll("[data-shop-cart-count]"));
      const money = (minor, currency) => new Intl.NumberFormat(locale === "vi" ? "vi-VN" : locale === "ja" ? "ja-JP" : locale === "zh" ? "zh-CN" : "en-US", { style: "currency", currency, maximumFractionDigits: currency === "VND" ? 0 : 2 }).format(Number(minor || 0) / (currency === "VND" ? 1 : 100));
      const escapeHtml = (value) => String(value ?? "").replace(/[&<>"']/g, (char) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[char]));
      const versionImageUrl = (value) => { const url = String(value || ""); return url.startsWith("/images/shop/") && !/[?&]v=/.test(url) ? `${url}${url.includes("?") ? "&" : "?"}v=${shopImageRevision}` : url; };
      const readCart = () => { try { const value = JSON.parse(localStorage.getItem(cartStorageKey) || "[]"); return Array.isArray(value) ? value.filter((item) => item && typeof item.variantId === "string" && item.variantId.length > 0) : []; } catch { return []; } };
      const writeCart = (items) => { localStorage.setItem(cartStorageKey, JSON.stringify(items.slice(0, 30))); window.dispatchEvent(new CustomEvent("tung:shop-cart")); };
      const renderCart = () => {
        const items = readCart();
        const count = items.reduce((sum, item) => sum + Math.max(0, Number(item.quantity) || 0), 0);
        countElements.forEach((element) => { element.textContent = String(count); });
        if (cartTotalElement) cartTotalElement.textContent = money(items.reduce((sum, item) => sum + (Number(item.priceMinor) || 0) * (Number(item.quantity) || 0), 0), items[0]?.currency || "VND");
        if (!cartItemsElement) return;
        if (!items.length) { cartItemsElement.innerHTML = `<p class="shop-cart-drawer__empty">${labels.cartEmpty}</p>`; return; }
        cartItemsElement.innerHTML = items.map((item) => { const id = escapeHtml(item.variantId); const title = escapeHtml(item.title); const variantTitle = escapeHtml(item.variantTitle || ""); const imageUrl = escapeHtml(versionImageUrl(item.imageUrl)); const quantity = Math.max(1, Number(item.quantity) || 1); return `<article class="shop-cart-item"><div class="shop-cart-item__thumb">${imageUrl ? `<img src="${imageUrl}" alt="" loading="lazy">` : ""}</div><div class="shop-cart-item__copy"><strong>${title}</strong><small>${variantTitle}</small><span>${money(Number(item.priceMinor) * quantity, item.currency || "VND")}</span><div class="shop-cart-item__controls"><button type="button" data-cart-dec="${id}" aria-label="${labels.decrease}">−</button><b aria-label="${labels.units}">${quantity}</b><button type="button" data-cart-inc="${id}" aria-label="${labels.increase}">+</button><button type="button" data-cart-remove="${id}" aria-label="${labels.remove}">${labels.remove}</button></div></div></article>`; }).join("");
      };
      let lastFocusedElement = null;
      let closeTimer = 0;
      const getFocusable = () => cartDrawer ? Array.from(cartDrawer.querySelectorAll("a[href], button:not([disabled]), input, select, textarea, [tabindex]:not([tabindex=\"-1\"])")).filter((element) => !element.hidden) : [];
      const setCartOpen = (open) => {
        if (!cartDrawer || !cartOverlay) return;
        window.clearTimeout(closeTimer);
        if (open) {
          if (cartDrawer.hidden) lastFocusedElement = document.activeElement instanceof HTMLElement ? document.activeElement : null;
          cartDrawer.hidden = false;
          cartOverlay.hidden = false;
          requestAnimationFrame(() => {
            cartDrawer.classList.add("is-open");
            cartOverlay.classList.add("is-open");
          });
          cartDrawer.setAttribute("aria-hidden", "false");
          document.querySelectorAll("[data-shop-cart-toggle]").forEach((button) => button.setAttribute("aria-expanded", "true"));
          document.body.classList.add("shop-cart-open");
          renderCart();
          (getFocusable()[0] || cartDrawer).focus();
          return;
        }
        cartDrawer.classList.remove("is-open");
        cartOverlay.classList.remove("is-open");
        cartDrawer.setAttribute("aria-hidden", "true");
        document.querySelectorAll("[data-shop-cart-toggle]").forEach((button) => button.setAttribute("aria-expanded", "false"));
        document.body.classList.remove("shop-cart-open");
        closeTimer = window.setTimeout(() => {
          cartDrawer.hidden = true;
          cartOverlay.hidden = true;
          if (lastFocusedElement?.isConnected) { lastFocusedElement.focus(); lastFocusedElement = null; }
        }, 280);
      };
      document.addEventListener("click", (event) => {
        const target = event.target instanceof Element ? event.target : null;
        const toggle = target?.closest("[data-shop-cart-toggle]");
        if (toggle && cartDrawer) { event.preventDefault(); setCartOpen(true); return; }
        const closeTarget = target?.closest("[data-shop-cart-close]");
        if (closeTarget) { if (!(closeTarget instanceof HTMLAnchorElement)) event.preventDefault(); setCartOpen(false); return; }
        const add = target?.closest("[data-cart-add]");
        if (add) {
          const product = JSON.parse(add.getAttribute("data-cart-product") || "{}");
          if (!product.variantId) return;
          const items = readCart();
          const currency = product.currency || "VND";
          if (items.length && items.some((item) => (item.currency || "VND") !== currency)) {
            window.alert(locale === "vi" ? "Giỏ hàng chỉ hỗ trợ một loại tiền tệ. Hãy thanh toán giỏ hiện tại hoặc xóa bớt sản phẩm." : locale === "ja" ? "カートは1つの通貨のみ対応しています。" : locale === "zh" ? "购物车仅支持一种货币。" : "Cart supports one currency only. Checkout or clear existing items first.");
            return;
          }
          const found = items.find((item) => item.variantId === product.variantId);
          if (found) found.quantity = Math.min(Number(found.maxQuantity) || 10, Number(found.quantity) + 1);
          else items.push({ ...product, quantity: 1 });
          writeCart(items);
          renderCart();
          setCartOpen(true);
          return;
        }
        const inc = target?.closest("[data-cart-inc]");
        const dec = target?.closest("[data-cart-dec]");
        const remove = target?.closest("[data-cart-remove]");
        if (inc || dec || remove) { const id = (inc || dec || remove).getAttribute(inc ? "data-cart-inc" : dec ? "data-cart-dec" : "data-cart-remove"); const items = readCart(); const item = items.find((entry) => entry.variantId === id); if (remove) writeCart(items.filter((entry) => entry.variantId !== id)); else if (item) item.quantity = inc ? Math.min(Number(item.maxQuantity) || 10, Number(item.quantity) + 1) : Number(item.quantity) - 1, writeCart(item.quantity > 0 ? items : items.filter((entry) => entry.variantId !== id)); renderCart(); }
      });
      const searchInput = document.querySelector("[data-shop-search]");
      const resultCountNodes = document.querySelectorAll("[data-shop-result-count], [data-shop-result-count-label]");
      let currentCategory = "all";
      const formatVisibleCount = (count) => locale === "vi" ? `${count} sản phẩm` : locale === "ja" ? `${count}件の商品` : locale === "zh" ? `${count}件商品` : `${count} ${count === 1 ? "product" : "products"}`;
      const skeleton = document.querySelector("[data-shop-skeleton]");
      const grid = document.querySelector("[data-shop-grid]");
      let filterTimer = 0;
      const applyCatalogFilters = (opts = {}) => {
        const showSkeleton = Boolean(opts.skeleton);
        if (showSkeleton && skeleton && grid) {
          skeleton.hidden = false;
          grid.hidden = true;
          window.clearTimeout(filterTimer);
          filterTimer = window.setTimeout(() => {
            applyCatalogFilters({ skeleton: false });
          }, 140);
          return;
        }
        const query = String(searchInput?.value || "").trim().toLocaleLowerCase(locale);
        let visible = 0;
        document.querySelectorAll("[data-shop-grid] .shop-product-card").forEach((card) => {
          const matchesCategory = currentCategory === "all" || card.getAttribute("data-category") === currentCategory;
          const matchesQuery = !query || String(card.textContent || "").toLocaleLowerCase(locale).includes(query);
          const matches = matchesCategory && matchesQuery;
          card.hidden = !matches;
          if (matches) visible += 1;
        });
        const empty = document.querySelector("[data-shop-no-results]");
        if (empty) empty.hidden = visible > 0;
        const label = formatVisibleCount(visible);
        resultCountNodes.forEach((node) => { node.textContent = label; });
        if (skeleton && grid) {
          skeleton.hidden = true;
          grid.hidden = false;
        }
      };
      let searchTimer = 0;
      searchInput?.addEventListener("input", () => {
        window.clearTimeout(searchTimer);
        searchTimer = window.setTimeout(() => applyCatalogFilters({ skeleton: true }), 140);
      });
      document.querySelectorAll("[data-shop-category]").forEach((button) => button.addEventListener("click", () => {
        currentCategory = button.getAttribute("data-shop-category") || "all";
        document.querySelectorAll("[data-shop-category]").forEach((item) => item.classList.toggle("is-active", item === button));
        applyCatalogFilters({ skeleton: true });
      }));
      document.addEventListener("keydown", (event) => { if (!cartDrawer || cartDrawer.hidden) return; if (event.key === "Escape") { event.preventDefault(); setCartOpen(false); return; } if (event.key === "Tab") { const focusable = getFocusable(); if (!focusable.length) { event.preventDefault(); cartDrawer.focus(); return; } const first = focusable[0]; const last = focusable[focusable.length - 1]; if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last.focus(); } else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first.focus(); } } });
      window.addEventListener("storage", renderCart); window.addEventListener("tung:shop-cart", renderCart); renderCart();
    </script>
    <script is:inline>
      (() => {
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        const cards = document.querySelectorAll(".storefront-grid .shop-product-card");
        if (!cards.length || !("IntersectionObserver" in window)) return;
        cards.forEach((card) => {
          card.style.opacity = "0";
          card.style.transform = "translateY(16px)";
          card.style.transition = "opacity 0.55s var(--shop-ease, ease), transform 0.55s var(--shop-ease, ease)";
          card.style.transitionDelay = `calc(var(--shop-card-delay, 0ms) * 0.55)`;
        });
        const observer = new IntersectionObserver((entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            const card = entry.target;
            card.style.opacity = "1";
            card.style.transform = "none";
            observer.unobserve(card);
          }
        }, { rootMargin: "0px 0px -8% 0px", threshold: 0.05 });
        cards.forEach((card) => observer.observe(card));
      })();
    </script>
  </Fragment>
</BaseLayout>

<style>
  .storefront-page {
    min-height: 100vh;
    background: transparent;
    font-family: var(--font-sans);
  }
  .visually-hidden, .sr-only {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0;
  }

  /* ── 0. Hero — Porcelain White with ambient canvas ─────────── */
  .storefront-hero {
    position: relative;
    overflow: hidden;
    padding-top: clamp(0.9rem, 2.5vw, 2rem);
    padding-bottom: clamp(1.5rem, 3.5vw, 2.75rem);
  }
  .storefront-hero__inner {
