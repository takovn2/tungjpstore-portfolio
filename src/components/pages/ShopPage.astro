            <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="14" x="2" y="5" rx="2"/><path d="M2 10h20"/></svg>
          </div>
          <div>
            <strong>{locale === "vi" ? "VietQR 0đ phí" : "Seamless Pay"}</strong>
            <p>{locale === "vi" ? "Quét mã QR chuyển khoản ngân hàng không mất phí, xác thực tức thì." : "Zero fee bank QR, card, and crypto payment support."}</p>
