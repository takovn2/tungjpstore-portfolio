---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProductCard from "../shop/ProductCard.astro";
import ConciergePanel from "../shop/ConciergePanel.astro";
import AuroraCanvas from "../shop/AuroraCanvas.astro";
import MerchRail from "../shop/MerchRail.astro";
import FlywheelBand from "../shop/FlywheelBand.astro";
import { localizePath, type Locale } from "../../i18n/dictionaries";
import { formatProductCount, getShopCopy, type ProductViewModel } from "../../i18n/shop";
import { formatApproximateProductPrice, getExchangeRateNote } from "../../lib/shop/currency";
import { SHOP_IMAGE_REVISION } from "../../lib/shop/media";
import { getShopProductDisplayTitle } from "../../lib/shop/seo";
import { buildMerchandisingRails } from "../../lib/shop/platform/merchandising";
import { recommendRails } from "../../lib/shop/platform/checkout-mesh";

interface Props { locale: Locale; products?: readonly ProductViewModel[]; }
const { locale, products = [] } = Astro.props;
const copy = getShopCopy(locale);
const categoryFallback: Record<string, string> = {
  digital_key: locale === "vi" ? "Mã kích hoạt" : locale === "ja" ? "キー" : locale === "zh" ? "激活码" : "Activation keys",
  digital_download: locale === "vi" ? "Tải xuống" : locale === "ja" ? "ダウンロード" : locale === "zh" ? "下载" : "Downloads",
  service: locale === "vi" ? "Dịch vụ số" : locale === "ja" ? "サービス" : locale === "zh" ? "数字服务" : "Digital services",
};
const categoryIconMap: Record<string, string> = {
  "ai-tools": "/images/shop/chrome/icon-ai.webp",
  "creative-tools": "/images/shop/chrome/icon-creative.webp",
  entertainment: "/images/shop/chrome/icon-entertainment.webp",
  productivity: "/images/shop/chrome/icon-trust.webp",
  digital_key: "/images/shop/chrome/icon-delivery.webp",
  digital_download: "/images/shop/chrome/icon-creative.webp",
  service: "/images/shop/chrome/icon-delivery.webp",
  accounts: "/images/shop/chrome/icon-trust.webp",
  vpn: "/images/shop/chrome/icon-trust.webp",
  streaming: "/images/shop/chrome/icon-entertainment.webp",
};
const categoryIconFor = (slug: string) => {
  const key = String(slug || "").toLowerCase().trim();
  if (categoryIconMap[key]) return categoryIconMap[key];
  if (key.includes("ai") || key.includes("gpt") || key.includes("llm") || key.includes("claude") || key.includes("gemini")) return categoryIconMap["ai-tools"];
  if (key.includes("creative") || key.includes("design") || key.includes("video") || key.includes("audio") || key.includes("canva")) return categoryIconMap["creative-tools"];
  if (key.includes("entertain") || key.includes("stream") || key.includes("game") || key.includes("music") || key.includes("netflix") || key.includes("spotify")) return categoryIconMap.entertainment;
  if (key.includes("product") || key.includes("work") || key.includes("office") || key.includes("code") || key.includes("cursor")) return categoryIconMap.productivity;
  if (key.includes("service") || key.includes("support") || key.includes("login") || key.includes("account")) return categoryIconMap.service;
  if (key.includes("vpn") || key.includes("proxy") || key.includes("security")) return categoryIconMap.vpn;
  return categoryIconMap.digital_key;
};
const categoryEntries = Array.from(new Map(products.map((product) => {
  const slug = product.categorySlug || product.productType;
  return [slug, { slug, label: product.category || categoryFallback[product.productType] || product.productType, icon: categoryIconFor(slug) }];
})).values());
const cartPath = localizePath("/shop/cart", locale);
const checkoutPath = localizePath("/shop/cart?step=checkout", locale);
const shopPath = localizePath("/shop", locale);
const hasApproximatePrices = products.some((product) => Boolean(formatApproximateProductPrice(product, locale)));
const exchangeRateNote = getExchangeRateNote(locale);
const siteUrl = Astro.site ?? new URL("https://tung.codes");
const seoLanding = {
  vi: {
    metaTitle: "Shop tài khoản AI giá rẻ, phần mềm giá tốt | TUNG",
    metaDescription: "Mua tài khoản AI và phần mềm giá rẻ tại TUNG Shop. Xem giá, thời hạn, phiên bản, tồn kho, cách giao sản phẩm số và thanh toán VietQR trước khi mua.",
    heading: "Mua tài khoản AI & phần mềm giá rẻ",
    intro: "Tìm gói AI, thiết kế, lập trình và giải trí theo đúng giá, thời hạn, phiên bản và tình trạng kho đang có. Thanh toán VietQR, theo dõi đơn và nhận sản phẩm số sau khi giao dịch được xác minh.",
    popularLabel: "Tìm nhanh theo nhu cầu",
    guideHeading: "Shop tài khoản AI giá rẻ với giá và thời hạn công khai",
    guideIntro: "Mỗi sản phẩm có trang riêng cho tên gói, giá hiện tại, phiên bản, thời hạn, tồn kho và cách bàn giao. Bạn có thể so sánh đúng biến thể trước khi thanh toán thay vì chọn từ một danh sách quảng cáo chung.",
    benefits: [
      { title: "Tài khoản AI giá tốt", body: "So sánh ChatGPT, Claude, Gemini, Grok, Cursor và các gói AI theo đúng phiên bản, quota hoặc thời hạn đang bán." },
      { title: "Công cụ sáng tạo tiết kiệm", body: "Tìm Canva Pro, CapCut Pro, Adobe, Suno và công cụ làm nội dung với giá và lựa chọn hiển thị rõ ràng." },
      { title: "Giao sản phẩm số có trạng thái", body: "Đơn chỉ chuyển bước sau khi backend xác minh thanh toán; hình thức giao key, tài khoản hoặc xử lý thủ công được ghi trên sản phẩm." },
    ],
    faqHeading: "Câu hỏi thường gặp khi mua tài khoản và sản phẩm số",
    faqs: [
      { question: "Làm sao chọn gói giá rẻ nhưng đúng nhu cầu?", answer: "Hãy kiểm tra thời hạn, phiên bản, quota, số thiết bị, hình thức bàn giao và tình trạng kho. Giá thấp chỉ có ý nghĩa khi quyền lợi của biến thể phù hợp với cách bạn sử dụng." },
      { question: "Sau khi thanh toán bao lâu thì nhận được sản phẩm?", answer: "Thời gian phụ thuộc hình thức bàn giao của từng biến thể. Sản phẩm tự động được xử lý sau khi thanh toán được backend xác minh; sản phẩm thủ công cần thêm thời gian kiểm tra trước khi gửi." },
      { question: "Có thể tìm ChatGPT Plus, Canva Pro hoặc CapCut Pro giá tốt ở đâu?", answer: "Dùng ô tìm kiếm hoặc các liên kết sản phẩm phổ biến trên trang này. Mỗi trang sản phẩm hiển thị giá hiện tại, phiên bản, tồn kho và thông tin nhận hàng trước khi đặt." },
    ],
  },
  en: {
    metaTitle: "Affordable AI tools & digital products — TUNG Shop",
    metaDescription: "Compare pricing, plans, availability, and delivery for AI accounts, creative tools, and digital products before you buy.",
    heading: "Affordable AI tools & digital products",
    intro: "Compare pricing, duration, plan details, and stock before choosing. Pay by QR and follow verified order and delivery states.",
    popularLabel: "Popular searches",
    guideHeading: "Choose by value, not by marketing claims",
    guideIntro: "Review the exact plan, duration, delivery method, and current availability before payment.",
    benefits: [
      { title: "AI tools at clear prices", body: "Compare assistants, coding tools, and token packages by the plan currently offered." },
      { title: "Creative tools for less", body: "Find design, video, audio, and content tools with visible pricing and options." },
      { title: "Traceable digital delivery", body: "Payment and delivery states are shown from backend-verified order data." },
    ],
    faqHeading: "Digital product buying FAQ",
    faqs: [
      { question: "How do I choose an affordable plan?", answer: "Compare duration, limits, devices, delivery method, and availability rather than price alone." },
      { question: "When will my digital product arrive?", answer: "Automatic items are processed after verified payment. Manual items require an additional review before delivery." },
      { question: "Where can I find popular AI and creative tools?", answer: "Use the catalog search or the popular product links on this page to open current pricing and plan details." },
    ],
  },
  ja: {
    metaTitle: "手頃なAIツール・デジタル商品 — TUNG Shop",
    metaDescription: "AIアカウント、制作ツール、デジタル商品の価格、期間、在庫、受取方法を購入前に比較できます。",
    heading: "手頃なAIツール・デジタル商品",
    intro: "価格、期間、プラン、在庫、受取方法を確認してから選べます。",
    popularLabel: "人気の商品",
    guideHeading: "宣伝文句ではなく、条件で選ぶ",
    guideIntro: "支払い前にプラン、期間、受取方法、在庫を確認できます。",
    benefits: [
      { title: "明確な価格のAIツール", body: "AIアシスタントや開発ツールを現在のプラン条件で比較できます。" },
      { title: "手頃な制作ツール", body: "デザイン、動画、音声、コンテンツ制作ツールの価格と選択肢を確認できます。" },
      { title: "追跡できるデジタル受取", body: "支払い確認から受取までの注文状態を確認できます。" },
    ],
    faqHeading: "デジタル商品購入のよくある質問",
    faqs: [
      { question: "手頃なプランはどう選びますか？", answer: "価格だけでなく、期間、上限、端末数、受取方法、在庫を比較してください。" },
      { question: "商品はいつ届きますか？", answer: "自動商品は支払い確認後に処理され、手動商品は送付前に追加確認があります。" },
      { question: "人気のAI・制作ツールはどこで探せますか？", answer: "検索欄またはこのページの商品リンクから価格とプランを確認できます。" },
    ],
  },
  zh: {
    metaTitle: "高性价比 AI 工具与数字商品 — TUNG Shop",
    metaDescription: "购买前比较 AI 账号、创作工具与数字商品的价格、期限、库存和交付方式。",
    heading: "高性价比 AI 工具与数字商品",
    intro: "选择前可比较价格、期限、套餐、库存和交付方式。",
    popularLabel: "热门商品",
    guideHeading: "按实际条件选择，而不是按广告选择",
    guideIntro: "付款前查看套餐、期限、交付方式和当前库存。",
    benefits: [
      { title: "价格清晰的 AI 工具", body: "按当前套餐比较 AI 助手、编程工具和 Token 产品。" },
      { title: "实惠的创作工具", body: "查看设计、视频、音频和内容工具的价格与选项。" },
      { title: "可追踪的数字交付", body: "从付款确认到交付均显示后端验证的订单状态。" },
    ],
    faqHeading: "购买数字商品常见问题",
    faqs: [
      { question: "如何选择高性价比套餐？", answer: "除价格外，还应比较期限、额度、设备数、交付方式和库存。" },
      { question: "付款后多久收到商品？", answer: "自动商品在付款验证后处理，手动商品在交付前需要额外检查。" },
      { question: "在哪里查找热门 AI 和创作工具？", answer: "可使用目录搜索或本页热门商品链接查看当前价格和套餐。" },
    ],
  },
} as const;
const baseLanding = seoLanding[locale];
const catalogExamples = products.slice(0, 4).map((product) => getShopProductDisplayTitle(product, locale));
const landing = locale === "vi" && catalogExamples.length > 0 ? {
  ...baseLanding,
  metaDescription: `Mua tài khoản AI và phần mềm giá rẻ tại TUNG Shop: ${catalogExamples.join(", ")}. Xem giá, thời hạn, tồn kho và cách giao trước khi mua.`,
  intro: `${baseLanding.intro} Sản phẩm nổi bật hiện có: ${catalogExamples.join(", ")}.`,
} : baseLanding;
const popularProductLabels: Record<string, Record<Locale, string>> = {
  "chatgpt-plus": { vi: "Mua ChatGPT Plus 1 tháng giá rẻ", en: "ChatGPT Plus plans", ja: "ChatGPT Plus", zh: "ChatGPT Plus 套餐" },
  canva: { vi: "Mua Canva Pro 1 tháng giá rẻ", en: "Affordable Canva Pro", ja: "Canva Pro", zh: "Canva Pro" },
  "capcut-pro": { vi: "Mua CapCut Pro giá rẻ", en: "Affordable CapCut Pro", ja: "CapCut Pro", zh: "CapCut Pro" },
  "gemini-pro": { vi: "Mua Gemini Pro 1 tháng giá rẻ", en: "Gemini Pro plans", ja: "Gemini Pro", zh: "Gemini Pro" },
  "cursor-pro": { vi: "Mua Cursor Pro giá tốt", en: "Cursor Pro for coding", ja: "Cursor Pro", zh: "Cursor Pro" },
  "claude-api": { vi: "Mua Claude API token giá tốt", en: "Claude API token packs", ja: "Claude API", zh: "Claude API Token" },
};
const preferredPopularProducts = Object.entries(popularProductLabels).flatMap(([slug, labels]) => {
  const product = products.find((item) => item.slug === slug);
  return product ? [{ ...product, seoLabel: labels[locale] }] : [];
});
const popularProducts = [
  ...preferredPopularProducts,
  ...products
    .filter((product) => !preferredPopularProducts.some((item) => item.slug === product.slug))
    .map((product) => ({
      ...product,
      seoLabel: locale === "vi"
        ? `Mua ${getShopProductDisplayTitle(product, locale)} giá tốt`
        : locale === "ja"
          ? `${product.title}を購入`
          : locale === "zh"
            ? `购买 ${product.title}`
            : `Buy ${product.title}`,
    })),
].slice(0, 6);
const schemaPrice = (amountMinor: number, currency: string) => {
  const fractionDigits = new Intl.NumberFormat("en", { style: "currency", currency }).resolvedOptions().maximumFractionDigits ?? 2;
  return amountMinor / (10 ** fractionDigits);
};
const collectionSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: landing.metaTitle,
  description: landing.metaDescription,
  url: new URL(shopPath, siteUrl).href,
  mainEntity: {
    "@type": "ItemList",
    numberOfItems: products.length,
    itemListElement: products.map((product, index) => ({
      "@type": "ListItem",
      position: index + 1,
      url: new URL(localizePath(`/shop/${product.slug}`, locale), siteUrl).href,
      item: {
        "@type": "Product",
        name: getShopProductDisplayTitle(product, locale),
        description: product.shortDescription,
        category: product.category || product.productType,
        image: product.media.find((item) => item.type === "image")?.url
          ? new URL(product.media.find((item) => item.type === "image")!.url, siteUrl).href
          : undefined,
        offers: product.variants.length > 0 ? {
          "@type": "AggregateOffer",
          priceCurrency: product.currency,
          lowPrice: schemaPrice(product.minPriceMinor, product.currency),
          highPrice: schemaPrice(product.maxPriceMinor, product.currency),
          offerCount: product.variants.length,
        } : undefined,
      },
    })),
  },
};
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "TUNG", item: new URL(localizePath("/", locale), siteUrl).href },
    { "@type": "ListItem", position: 2, name: landing.heading, item: new URL(shopPath, siteUrl).href },
  ],
};
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: landing.faqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: { "@type": "Answer", text: faq.answer },
  })),
};
const structuredData = [collectionSchema, breadcrumbSchema, faqSchema];
const localeLabels = {
  vi: {
    title: "Cửa hàng",
    search: "Tìm sản phẩm",
    all: "Tất cả",
    cartEmpty: "Giỏ hàng trống",
    cartTitle: "Giỏ hàng",
    continue: "Tiếp tục mua",
    checkout: "Thanh toán",
    units: "sản phẩm",
  },
  en: {
    title: "Shop",
    search: "Search",
    all: "All",
    cartEmpty: "Cart is empty",
    cartTitle: "Cart",
    continue: "Continue",
    checkout: "Checkout",
    units: "items",
  },
  ja: {
    title: "ショップ",
    search: "検索",
    all: "すべて",
    cartEmpty: "カートは空です",
    cartTitle: "カート",
    continue: "続ける",
    checkout: "会計",
    units: "点",
  },
  zh: {
    title: "商店",
    search: "搜索",
    all: "全部",
    cartEmpty: "购物车为空",
    cartTitle: "购物车",
    continue: "继续",
    checkout: "结算",
    units: "件",
  },
} as const;
const labels = localeLabels[locale];
const productBySlug = new Map(products.map((product) => [product.slug, product]));
const merchRails = buildMerchandisingRails(
  products.map((product) => ({
    id: product.id,
    slug: product.slug,
    title: product.title,
    categorySlug: product.categorySlug,
    category: product.category,
    featured: product.featured,
    availability: product.availability,
    minPriceMinor: product.minPriceMinor,
    maxPriceMinor: product.maxPriceMinor,
    currency: product.currency,
    badges: product.badges,
    compareAtHint: product.variants.find((v) => v.compareAtMinor && v.compareAtMinor > v.priceMinor)?.compareAtMinor ?? null,
  })),
  locale,
).map((rail) => ({
  ...rail,
  products: rail.productSlugs.map((slug) => productBySlug.get(slug)).filter(Boolean) as ProductViewModel[],
})).filter((rail) => rail.products.length > 0);
const paymentRails = recommendRails({ locale, currency: locale === "vi" ? "VND" : "USD", channel: "web" });
---

<BaseLayout title={landing.metaTitle} description={landing.metaDescription} locale={locale} structuredData={structuredData} chrome="store" storeCartDrawer={true}>
  <div class="storefront-page">

    {/* ── 0. Hero — Porcelain White + ambient canvas ───────────── */}
    <section class="storefront-hero" aria-labelledby="storefront-hero-title">
      <AuroraCanvas dotgrid />
      <div class="storefront-hero__inner shell">
        <nav class="storefront-breadcrumb" aria-label="Breadcrumb">
          <a href={localizePath("/", locale)}>Trang chủ</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">Cửa hàng</span>
        </nav>
        <span class="storefront-hero__kicker">
          <i aria-hidden="true"></i>
          {locale === "vi" ? "Cửa hàng sản phẩm số chính hãng" : locale === "ja" ? "正規デジタルショップ" : locale === "zh" ? "正版数字商品商店" : "Licensed digital products store"}
        </span>
        <h1 class="storefront-hero__title" id="storefront-hero-title">
          {locale === "vi" ? "Tài khoản AI & Bản quyền phần mềm" : landing.heading}
        </h1>
        <p class="storefront-hero__desc">
          {locale === "vi"
            ? "Cung cấp tài khoản ChatGPT Plus, Claude Pro, Cursor, Canva Pro chính hãng. Tự động kích hoạt, bảo hành 1 đổi 1 trong suốt thời gian sử dụng."
            : landing.intro}
        </p>
        <div class="storefront-hero__stats">
          <div class="storefront-hero__stat">
            <strong>{formatProductCount(locale, products.length)}</strong>
            <span>{locale === "vi" ? "sản phẩm đang bán" : locale === "ja" ? "販売中の商品" : locale === "zh" ? "在售商品" : "products live"}</span>
          </div>
          <div class="storefront-hero__stat">
            <strong>~10s</strong>
            <span>{locale === "vi" ? "tự động giao key" : locale === "ja" ? "自動配信" : locale === "zh" ? "自动交付" : "auto delivery"}</span>
          </div>
          <div class="storefront-hero__stat">
            <strong>1:1</strong>
            <span>{locale === "vi" ? "bảo hành đổi mới" : locale === "ja" ? "保証交換" : locale === "zh" ? "保修换新" : "warranty swap"}</span>
          </div>
        </div>
        <a class="storefront-hero__cta" href="#catalog">
          <span>{locale === "vi" ? "Khám phá catalog" : locale === "ja" ? "カタログを見る" : locale === "zh" ? "浏览商品" : "Browse catalog"}</span>
          <svg aria-hidden="true" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12l7 7 7-7"/></svg>
        </a>
      </div>
      <div class="storefront-hero__fade" aria-hidden="true"></div>
    </section>


    {/* ── 1. Control toolbar: Search + Category Pills ──────────── */}
    <header class="storefront-controls-bar shell">
      <div class="storefront-controls">
        <label class="storefront-search">
          <svg class="storefront-search__icon" aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          <span class="sr-only">{labels.search}</span>
          <input type="search" placeholder={locale === "vi" ? "Tìm nhanh ChatGPT, Cursor, Canva, Claude..." : labels.search} data-shop-search />
        </label>

        <nav class="storefront-pills" aria-label={labels.title} data-shop-categories>
          <button type="button" class="storefront-pill is-active" data-shop-category="all">
            <span>{labels.all}</span>
            <small data-shop-result-count>{products.length}</small>
          </button>
          {categoryEntries.map((category) => (
            <button type="button" class="storefront-pill" data-shop-category={category.slug}>
              <span>{category.label}</span>
            </button>
          ))}
        </nav>
      </div>
    </header>

    {/* ── 2. Product Catalog Grid ──────────────────────────────── */}
    <main class="storefront-main shell" id="catalog">
      {products.length === 0 ? (
        <div class="storefront-empty">
          <img src={`/images/shop/chrome/empty-cart.webp?v=${SHOP_IMAGE_REVISION}`} alt="" width="120" height="120" loading="lazy" decoding="async" />
          <h2>{copy.emptyTitle}</h2>
          <a class="storefront-btn" href={localizePath("/contact", locale)}>{copy.emptyCta}</a>
        </div>
      ) : (
