---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PlanPicker from "../shop/PlanPicker.astro";
import ProductCard from "../shop/ProductCard.astro";
import TrustStrip from "../shop/TrustStrip.astro";
import AuroraCanvas from "../shop/AuroraCanvas.astro";
import { localizePath, type Locale } from "../../i18n/dictionaries";
import {
  formatMoney,
  formatProductPrice,
  getShopCopy,
  type ProductAvailability,
  type ProductVariantViewModel,
  type ProductViewModel,
} from "../../i18n/shop";
import { formatApproximateMoney, getExchangeRateNote } from "../../lib/shop/currency";
import { versionShopImageUrl } from "../../lib/shop/media";
import { getShopProductSeo } from "../../lib/shop/seo";

interface Props {
  locale: Locale;
  product: ProductViewModel;
  selectedVariantId?: string | null;
  purchaseHref?: string | null;
  relatedProducts?: readonly ProductViewModel[];
}

const {
  locale,
  product,
  selectedVariantId,
  purchaseHref = null,
  relatedProducts = [],
} = Astro.props;
const copy = getShopCopy(locale);
const media = [...product.media].sort((left, right) => left.sortOrder - right.sortOrder);
const images = media.filter((item) => item.type === "image");
const cover = images[0] ?? null;
const coverUrl = versionShopImageUrl(cover?.url ?? "");
const socialCoverUrl = coverUrl || "/og/default.png";
const selectedVariant = product.variants.find((variant) => variant.id === selectedVariantId)
  ?? product.variants.find((variant) => variant.availability !== "out_of_stock")
  ?? product.variants[0]
  ?? null;
const descriptionParagraphs = String(product.description || product.shortDescription || "").split(/\n{2,}/).map((paragraph) => paragraph.trim()).filter(Boolean);
const isCampusMail = false;
const campusGuide = locale === "vi" ? [
  { n: "01", title: "Nhận đúng 1 dòng", body: "Mở đơn sau khi backend xác minh thanh toán. Copy nguyên dòng, không thêm khoảng trắng." },
  { n: "02", title: "Tách 3 phần", body: "email|password|2fa. Ví dụ mail001@quillmere.edu rồi mật khẩu rồi secret Base32." },
  { n: "03", title: "Gắn 2FA khi test OTP", body: "Thêm secret vào authenticator bằng Enter a setup key. Mã 6 số đổi mỗi 30 giây." },
] : locale === "ja" ? [
  { n: "01", title: "1行だけ受け取る", body: "支払い確認後に注文を開き、キーを1行だけコピーします。" },
  { n: "02", title: "3つに分割", body: "email|password|2fa。例: mail001@quillmere.edu とパスワードと Base32 シークレット。" },
  { n: "03", title: "OTP をテスト", body: "Authenticator に setup key として追加します。6桁コードは30秒ごとです。" },
] : locale === "zh" ? [
  { n: "01", title: "只领一行", body: "付款验证后打开订单，完整复制一行，不要加空格。" },
  { n: "02", title: "拆成三段", body: "email|password|2fa。例如 mail001@quillmere.edu、密码、Base32 密钥。" },
  { n: "03", title: "测试 OTP", body: "在验证器中用 setup key 添加密钥。6 位码每 30 秒更新。" },
] : [
  { n: "01", title: "Receive one line", body: "Open the order after payment is verified. Copy the whole line with no extra spaces." },
  { n: "02", title: "Split three parts", body: "email|password|2fa. Example: mail001@quillmere.edu, then the password, then a Base32 secret." },
  { n: "03", title: "Attach 2FA for OTP tests", body: "Add the secret in an authenticator with Enter a setup key. The 6-digit code rotates every 30 seconds." },
];
const productType = copy.productType[product.productType];
const overallPrice = formatProductPrice(product, locale);
const selectedPrice = selectedVariant ? formatMoney(selectedVariant.priceMinor, selectedVariant.currency, locale) : overallPrice;
const selectedApproximatePrice = selectedVariant ? formatApproximateMoney(selectedVariant.priceMinor, selectedVariant.currency, locale) : null;
const exchangeRateNote = getExchangeRateNote(locale);
const selectedCompareAt = selectedVariant?.compareAtMinor && selectedVariant.compareAtMinor > selectedVariant.priceMinor
  ? formatMoney(selectedVariant.compareAtMinor, selectedVariant.currency, locale)
  : null;
const availability = selectedVariant?.availability ?? product.availability;
const availableToBuy = availability !== "out_of_stock" && Boolean(selectedVariant);
const fulfilmentLabel = selectedVariant ? copy.fulfillment[selectedVariant.fulfillmentType] : productType;
const deliveryModeLabel = selectedVariant ? copy.deliveryMode[selectedVariant.deliveryMode] : null;
const shopHref = localizePath("/shop", locale);
const cartHref = localizePath("/shop/cart", locale);
const contactHref = localizePath(`/contact?subject=${encodeURIComponent(product.title)}`, locale);
const primaryHref = availableToBuy ? (purchaseHref || contactHref) : shopHref;
const primaryLabel = !availableToBuy ? copy.product.unavailableCta : purchaseHref ? copy.product.buyNow : copy.product.contactToBuy;
const isExternalPurchase = Boolean(purchaseHref && /^https:\/\//i.test(purchaseHref));
const maximumQuantity = Math.max(1, Math.min(
  selectedVariant?.maxPerOrder ?? 10,
  selectedVariant?.availableQuantity == null ? (selectedVariant?.maxPerOrder ?? 10) : selectedVariant.availableQuantity,
));
const cartProduct = selectedVariant ? {
  productId: product.id,
  variantId: selectedVariant.id,
  slug: product.slug,
  title: product.title,
  variantTitle: selectedVariant.title,
  priceMinor: selectedVariant.priceMinor,
  currency: selectedVariant.currency,
  maxQuantity: maximumQuantity,
  availability: selectedVariant.availability,
  imageUrl: coverUrl,
} : null;
const checkoutHref = localizePath("/shop/cart?step=checkout", locale);
const siteUrl = Astro.site ?? new URL("https://tung.codes");
const productSeo = getShopProductSeo(product, locale);
const productMetaTitle = productSeo.title;
const productMetaDescription = productSeo.description;
const displayTitle = productSeo.displayTitle;
const currencyFractionDigits = (currency: string) => new Intl.NumberFormat("en", { style: "currency", currency }).resolvedOptions().maximumFractionDigits ?? 2;
const schemaPrice = (amountMinor: number, currency: string) => amountMinor / (10 ** currencyFractionDigits(currency));
const schemaAvailability: Record<ProductAvailability, string> = {
  in_stock: "https://schema.org/InStock",
  low_stock: "https://schema.org/LimitedAvailability",
  out_of_stock: "https://schema.org/OutOfStock",
  unlimited: "https://schema.org/InStock",
};
const productUrl = new URL(localizePath(`/shop/${product.slug}`, locale), siteUrl);
const productSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  "@id": `${productUrl.href}#product`,
  name: displayTitle,
  description: productMetaDescription,
  url: productUrl.href,
  image: images.length > 0
    ? images.map((item) => new URL(versionShopImageUrl(item.url), siteUrl).href)
    : [new URL("/og/default.png", siteUrl).href],
  category: product.category || productType,
  sku: selectedVariant?.sku,
  offers: product.variants.length > 0 ? product.variants.map((variant) => ({
    "@type": "Offer",
    url: `${productUrl.href}?variant=${encodeURIComponent(variant.id)}`,
    sku: variant.sku,
    priceCurrency: variant.currency,
    price: schemaPrice(variant.priceMinor, variant.currency),
    availability: schemaAvailability[variant.availability],
    itemCondition: "https://schema.org/NewCondition",
    seller: { "@id": "https://tung.codes/#person" },
  })) : undefined,
};
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "TUNG", item: new URL(localizePath("/", locale), siteUrl).href },
    { "@type": "ListItem", position: 2, name: copy.label, item: new URL(localizePath("/shop", locale), siteUrl).href },
    { "@type": "ListItem", position: 3, name: displayTitle, item: productUrl.href },
  ],
};
const productFaqs = locale === "vi" ? [
  { question: `${displayTitle} giá bao nhiêu?`, answer: `Giá hiện tại là ${overallPrice}. Nếu sản phẩm có nhiều phiên bản, giá cụ thể được hiển thị ngay bên cạnh từng lựa chọn và được kiểm tra lại trước khi tạo thanh toán.` },
  { question: `Mua ${displayTitle} nhận hàng như thế nào?`, answer: `${displayTitle} được bàn giao theo hình thức ${fulfilmentLabel.toLocaleLowerCase(locale)}${deliveryModeLabel ? `, ${deliveryModeLabel.toLocaleLowerCase(locale)}` : ""}. Đơn chỉ chuyển sang bước giao sau khi thanh toán được backend xác minh.` },
  { question: `Cần kiểm tra gì trước khi mua ${displayTitle}?`, answer: `Hãy kiểm tra đúng phiên bản, giá, thời hạn hoặc quota, tình trạng kho và mô tả quyền lợi. Các điều kiện cụ thể của nhà cung cấp có thể thay đổi theo thời điểm.` },
] : locale === "ja" ? [
  { question: `${displayTitle}の価格はいくらですか？`, answer: `現在の価格は${overallPrice}です。複数プランがある場合は、各選択肢の横に価格が表示されます。` },
  { question: `${displayTitle}はどのように受け取りますか？`, answer: `支払い確認後、商品ページに記載された方法でデジタル商品を受け取ります。` },
  { question: `購入前に何を確認すべきですか？`, answer: `プラン、価格、期間または上限、在庫、提供条件をご確認ください。` },
] : locale === "zh" ? [
  { question: `${displayTitle}多少钱？`, answer: `当前价格为${overallPrice}。如有多个套餐，每个选项旁都会显示对应价格。` },
  { question: `购买 ${displayTitle} 后如何交付？`, answer: `付款验证后，系统会按照商品页面标明的方式交付数字商品。` },
  { question: `购买前需要检查什么？`, answer: `请检查套餐、价格、期限或额度、库存和具体权益说明。` },
] : [
  { question: `How much does ${displayTitle} cost?`, answer: `The current price is ${overallPrice}. If several plans are available, each option shows its own price.` },
  { question: `How is ${displayTitle} delivered?`, answer: `The digital item is delivered using the method shown on this page after payment is verified.` },
  { question: `What should I check before buying?`, answer: `Review the plan, price, duration or limits, availability, and the exact package description.` },
];
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: productFaqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: { "@type": "Answer", text: faq.answer },
  })),
};
const structuredData = [productSchema, breadcrumbSchema, faqSchema];
const variantHref = (variant: ProductVariantViewModel) => {
  const url = new URL(Astro.url);
  url.searchParams.set("variant", variant.id);
  url.hash = "purchase";
  return `${url.pathname}${url.search}${url.hash}`;
};
const optionChips = selectedVariant
  ? Object.entries(selectedVariant.optionValues || {}).map(([key, value]) => ({
      label: `${key}: ${value}`,
      tone: "accent" as const,
    }))
  : [];
const specChips = [
  product.category || productType
    ? { label: product.category || productType, tone: "accent" as const }
    : null,
  { label: fulfilmentLabel, tone: "ok" as const },
  deliveryModeLabel ? { label: deliveryModeLabel, tone: "ok" as const } : null,
  {
    label: copy.availability[availability],
    tone: availability === "out_of_stock" ? ("warn" as const) : ("ok" as const),
  },
  ...optionChips,
].filter(Boolean) as Array<{ label: string; tone: "ok" | "warn" | "accent" }>;
const trustItems = locale === "vi" ? [
  { icon: "1", title: "Giá & gói rõ", body: "Chọn đúng phiên bản trước khi thanh toán." },
  { icon: "2", title: "Thanh toán xác minh", body: "Đơn chỉ giao sau khi backend xác nhận." },
  { icon: "3", title: "Nhận key trong đơn", body: "Theo dõi trạng thái và lấy sản phẩm số." },
] : locale === "ja" ? [
  { icon: "1", title: "条件が明確", body: "支払い前にプランを確認できます。" },
  { icon: "2", title: "支払い確認", body: "確認後にのみ配信されます。" },
  { icon: "3", title: "注文で受取", body: "状態を追跡してキーを受け取れます。" },
] : locale === "zh" ? [
  { icon: "1", title: "套餐透明", body: "付款前确认版本与权益。" },
  { icon: "2", title: "付款验证", body: "后端确认后才交付。" },
  { icon: "3", title: "订单内领取", body: "跟踪状态并获取数字商品。" },
] : [
  { icon: "1", title: "Clear plans", body: "Pick the exact package before you pay." },
  { icon: "2", title: "Verified payment", body: "Delivery starts only after backend confirmation." },
  { icon: "3", title: "Keys in order", body: "Track status and receive digital goods securely." },
];
const journeySteps = locale === "vi" ? [
  { n: "01", title: "Chọn gói & số lượng" },
  { n: "02", title: "Thanh toán VietQR / crypto" },
  { n: "03", title: "Backend xác minh giao dịch" },
  { n: "04", title: "Nhận key / tài khoản trong đơn" },
] : locale === "ja" ? [
  { n: "01", title: "プランを選択" },
  { n: "02", title: "支払い" },
  { n: "03", title: "確認" },
  { n: "04", title: "キー受取" },
] : locale === "zh" ? [
  { n: "01", title: "选择套餐" },
  { n: "02", title: "付款" },
  { n: "03", title: "验证" },
  { n: "04", title: "领取密钥" },
] : [
  { n: "01", title: "Choose plan & quantity" },
  { n: "02", title: "Pay by QR or crypto" },
  { n: "03", title: "Backend verifies payment" },
  { n: "04", title: "Receive keys in your order" },
];
---

<BaseLayout
  title={productMetaTitle}
  description={productMetaDescription}
  image={socialCoverUrl}
  imageAlt={cover?.alt || displayTitle}
  locale={locale}
  ogType="product"
  structuredData={structuredData}
  chrome="store"
>
  <article class="product-page">
    <header class="product-hero shell" id="purchase">
      <AuroraCanvas class="product-hero__aurora" />
      <a class="product-back reveal" href={shopHref}><span aria-hidden="true">↙</span>{copy.product.backToShop}</a>

      <div class="product-gallery">
        <div class="product-gallery__primary">
          {cover ? (
            <img src={coverUrl} alt={cover.alt || displayTitle} width="600" height="400" loading="eager" decoding="async" />
          ) : (
            <div class="product-gallery__placeholder">
              <span>{displayTitle.charAt(0)}</span>
            </div>
          )}
          <span class="product-gallery__type">{product.category || productType}</span>
        </div>
      </div>

      <div class="product-purchase reveal" style="--reveal-delay: 140ms">
        <div class="product-purchase__meta"><span>{product.eyebrow || productType}</span><span data-availability={availability}><i aria-hidden="true"></i>{copy.availability[availability]}</span></div>
        <h1>{displayTitle}</h1>
        <p class="product-purchase__summary">{product.shortDescription}</p>
        {product.fallbackLocale && product.fallbackLocale !== locale && <p class="product-purchase__fallback">{copy.product.fallbackLocale}</p>}

        {specChips.length > 0 && (
          <ul class="shop-spec-chips product-spec-chips" role="list">
            {specChips.map((chip) => (
              <li data-tone={chip.tone}>{chip.label}</li>
            ))}
          </ul>
        )}

        <div class="product-purchase__price">
          <span>{copy.product.price}</span>
          <strong>{selectedPrice}</strong>
          {selectedCompareAt && <del aria-label={copy.product.compareAt}>{selectedCompareAt}</del>}
          {selectedApproximatePrice && <small title={exchangeRateNote}>{selectedApproximatePrice}</small>}
        </div>

        <div class="product-purchase__urgency-stack">
          {selectedVariant && selectedVariant.availableQuantity !== null && selectedVariant.availableQuantity > 0 && selectedVariant.availableQuantity <= 5 ? (
            <div class="product-scarcity-pill" data-scarcity-pill>
              <span class="scarcity-pulse" aria-hidden="true"></span>
              <span>{locale === "vi" ? `🔥 Chỉ còn ${selectedVariant.availableQuantity} key trong kho!` : locale === "ja" ? `🔥 残りわずか ${selectedVariant.availableQuantity} 点！` : locale === "zh" ? `🔥 仅剩 ${selectedVariant.availableQuantity} 件现货！` : `🔥 Only ${selectedVariant.availableQuantity} keys left in stock!`}</span>
            </div>
          ) : null}
          <div class="product-social-proof-pill">
            <span class="proof-icon" aria-hidden="true">⚡</span>
            <span>{locale === "vi" ? "Đã giao tự động 150+ đơn trong tuần" : locale === "ja" ? "今週150件以上の自動納品実績" : locale === "zh" ? "本周已自动交付 150+ 单" : "150+ keys delivered automatically this week"}</span>
          </div>
        </div>

        {product.variants.length > 0 ? (
          <PlanPicker
            locale={locale}
            variants={product.variants as any}
            selectedId={selectedVariant?.id || product.variants[0]?.id || ""}
            stockLabels={copy.availability}
            label={copy.product.selectVersion}
          />
        ) : <p class="product-variants__empty">{copy.product.noVariant}</p>}
        {selectedApproximatePrice && <p class="product-purchase__rate-note">{exchangeRateNote}</p>}

        <div class="product-delivery-card">
          <p class="product-delivery-card__label">{copy.product.delivery}</p>
          <strong>{fulfilmentLabel}{deliveryModeLabel ? ` · ${deliveryModeLabel}` : ""}</strong>
          <p>{locale === "vi" ? "Thanh toán xong, theo dõi trạng thái đơn và nhận sản phẩm số trong tài khoản hoặc email." : locale === "ja" ? "支払い後、注文状態を確認してデジタル商品を受け取れます。" : locale === "zh" ? "付款后可在订单中查看状态并领取数字商品。" : "After payment, track the order status and receive your digital product in account or email."}</p>
        </div>

        <div class="product-trust">
          <TrustStrip items={trustItems} compact />
        </div>

        {availableToBuy && selectedVariant ? <div class="product-buy-panel" data-product-buy data-sticky-buy>
          <label class="product-buy-panel__qty">
            <span>{copy.checkout.form.quantity}</span>
            <input name="quantity" type="number" inputmode="numeric" min="1" max={maximumQuantity} value="1" required data-product-qty />
          </label>
          <div class="product-buy-panel__actions">
            <button class="product-buy-panel__add" type="button" data-product-add-to-cart>
              <span>{copy.product.addToCart}</span>
            </button>
            <button class="product-buy-panel__now" type="button" data-product-buy-now>
              <span>{copy.product.buyNow}</span>
            </button>
          </div>
          <a class="product-buy-panel__cart" href={cartHref}>{copy.product.viewCart}<span aria-hidden="true">→</span></a>
          <p class="product-buy-panel__status" data-product-cart-status role="status" aria-live="polite"></p>
        </div> : <a class="product-purchase__cta product-purchase__cta--disabled" href={primaryHref} target={isExternalPurchase ? "_blank" : undefined} rel={isExternalPurchase ? "noreferrer" : undefined}>
          <span>{primaryLabel}</span><i aria-hidden="true">↗</i>
        </a>}
      </div>
    </header>

    <section class="product-journey section-rule" aria-labelledby="product-journey-title">
      <div class="shell">
        <header class="product-journey__head reveal">
          <p class="product-delivery-card__label">{locale === "vi" ? "Luồng mua" : locale === "ja" ? "購入フロー" : locale === "zh" ? "购买流程" : "Purchase flow"}</p>
          <h2 id="product-journey-title">{locale === "vi" ? "Từ chọn gói đến nhận key" : locale === "ja" ? "選択から受取まで" : locale === "zh" ? "从选购到交付" : "From plan to keys"}</h2>
        </header>
        <ol class="product-delivery__steps reveal" style="--reveal-delay: 60ms">
          {journeySteps.map((step) => (
            <li>
              <span>{step.n}</span>
              <strong>{step.title}</strong>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="product-details section-rule" aria-labelledby="product-details-title">
      <div class="shell product-details__grid">
        <div class="product-details__heading reveal"><h2 id="product-details-title">{copy.product.detailsHeading}</h2></div>
        <div class="product-details__body reveal" style="--reveal-delay: 80ms">
          {descriptionParagraphs.map((paragraph) => <p>{paragraph}</p>)}
          {product.badges.length > 0 && <ul role="list">{product.badges.map((badge) => <li>{badge}</li>)}</ul>}
        </div>
      </div>
    </section>

    {relatedProducts.length > 0 && (
      <section class="product-related section-rule" aria-labelledby="product-related-title">
        <div class="shell">
          <header class="product-related__head">
            <p class="product-delivery-card__label">{locale === "vi" ? "Gợi ý thêm" : locale === "ja" ? "関連商品" : locale === "zh" ? "相关商品" : "You may also like"}</p>
            <h2 id="product-related-title">{locale === "vi" ? "Sản phẩm liên quan" : locale === "ja" ? "一緒に見られている商品" : locale === "zh" ? "猜你喜欢" : "Related products"}</h2>
          </header>
          <div class="product-related__grid">
            {relatedProducts.map((item, index) => (
              <ProductCard product={item} locale={locale} index={index} />
            ))}
          </div>
        </div>
      </section>
    )}

    <section class="product-seo-faq section-rule" aria-labelledby="product-faq-title">
      <div class="shell product-seo-faq__grid">
        <div class="product-seo-faq__heading reveal">
          <p>{locale === "vi" ? "Hướng dẫn mua" : locale === "ja" ? "購入ガイド" : locale === "zh" ? "购买指南" : "Buying guide"}</p>
          <h2 id="product-faq-title">{locale === "vi" ? `Mua ${displayTitle}: giá và cách nhận` : locale === "ja" ? `${displayTitle}の価格と受取方法` : locale === "zh" ? `${displayTitle} 的价格与交付` : `${displayTitle}: pricing and delivery`}</h2>
        </div>
        <div class="product-seo-faq__list reveal" style="--reveal-delay: 80ms">
          {productFaqs.map((faq) => <details>
            <summary>{faq.question}</summary>
            <p>{faq.answer}</p>
          </details>)}
        </div>
      </div>
    </section>
  </article>

  {availableToBuy && selectedVariant ? (
    <div class="product-mobile-cta" data-product-mobile-cta hidden>
      <div class="product-mobile-cta__price">
        <small>{selectedVariant.title || copy.product.selectVersion}</small>
        <strong data-mobile-cta-price>{selectedPrice}</strong>
      </div>
      <div class="product-mobile-cta__actions">
        <button type="button" class="product-mobile-cta__add" data-product-add-to-cart-mobile>
          <span>{copy.product.addToCart}</span>
        </button>
        <button type="button" class="product-mobile-cta__now" data-product-buy-now-mobile>
          <span>{copy.product.buyNow}</span>
        </button>
      </div>
    </div>
  ) : null}

  <Fragment slot="page-scripts">
    <script is:inline define:vars={{ productCopy: copy.product, cartProduct, cartHref, checkoutHref }}>
      const panel = document.querySelector("[data-product-buy]");
      const mobileCta = document.querySelector("[data-product-mobile-cta]");
      const cartAddButton = panel?.querySelector("[data-product-add-to-cart]");
      const buyNowButton = panel?.querySelector("[data-product-buy-now]");
      const mobileAddButton = document.querySelector("[data-product-add-to-cart-mobile]");
      const mobileBuyNowButton = document.querySelector("[data-product-buy-now-mobile]");
      const cartStatus = panel?.querySelector("[data-product-cart-status]");
      const cartQuantity = panel?.querySelector("[data-product-qty]");
      const cartStorageKey = "tung:shop:cart:v1";

      const readCart = () => {
        try {
          const stored = JSON.parse(localStorage.getItem(cartStorageKey) || "[]");
          return Array.isArray(stored) ? stored.filter((item) => item && typeof item.variantId === "string") : [];
        } catch {
          return [];
        }
      };
      const showCartStatus = (message, state) => {
        if (!cartStatus) return;
        cartStatus.textContent = message;
        cartStatus.dataset.state = state;
      };
      const flashAdded = (button) => {
        const label = button?.querySelector("span");
        if (!label) return;
        label.textContent = productCopy.addedToCart;
        window.setTimeout(() => {
          if (label) label.textContent = productCopy.addToCart;
        }, 1800);
      };
      const addToCart = () => {
        if (!cartProduct?.variantId || cartProduct.availability === "out_of_stock") return false;
        const requestedQuantity = Number(cartQuantity?.value || 1);
        const quantity = Number.isInteger(requestedQuantity)
          ? Math.max(1, Math.min(Number(cartProduct.maxQuantity) || 10, requestedQuantity))
          : 1;
        const items = readCart();
        const existing = items.find((item) => item.variantId === cartProduct.variantId);
        if (existing) {
          existing.quantity = Math.min(Number(existing.maxQuantity) || 10, (Number(existing.quantity) || 0) + quantity);
        } else {
          items.push({ ...cartProduct, quantity });
        }
        try {
          localStorage.setItem(cartStorageKey, JSON.stringify(items.slice(0, 30)));
        } catch {
          showCartStatus(productCopy.contactToBuy, "error");
          return false;
        }
        window.dispatchEvent(new CustomEvent("tung:shop-cart"));
        return true;
      };

      cartAddButton?.addEventListener("click", () => {
        if (!addToCart()) return;
        showCartStatus(`${productCopy.addedToCart} · ${productCopy.viewCart}`, "success");
        flashAdded(cartAddButton);
      });

      buyNowButton?.addEventListener("click", () => {
        if (!addToCart()) return;
        window.location.assign(checkoutHref);
      });

      mobileAddButton?.addEventListener("click", () => {
        if (!addToCart()) return;
        showCartStatus(`${productCopy.addedToCart} · ${productCopy.viewCart}`, "success");
        flashAdded(mobileAddButton);
      });

      mobileBuyNowButton?.addEventListener("click", () => {
        if (!addToCart()) return;
        window.location.assign(checkoutHref);
      });

      // Mobile sticky CTA: show only when the main buy panel leaves the viewport.
      if (panel && mobileCta && "IntersectionObserver" in window) {
        const syncMobileCta = (visible) => {
          const isNarrow = window.matchMedia("(max-width: 860px)").matches;
          mobileCta.hidden = !(isNarrow && !visible);
          document.body.classList.toggle("has-product-mobile-cta", !mobileCta.hidden);
        };
        let panelVisible = true;
        const observer = new IntersectionObserver((entries) => {
          panelVisible = entries.some((entry) => entry.isIntersecting && entry.intersectionRatio > 0.15);
          syncMobileCta(panelVisible);
        }, { threshold: [0, 0.15, 0.5, 1], rootMargin: "-8px 0px 0px 0px" });
        observer.observe(panel);
        window.addEventListener("resize", () => syncMobileCta(panelVisible), { passive: true });
        syncMobileCta(true);
      }
    </script>
  </Fragment>
