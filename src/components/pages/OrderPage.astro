---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CheckoutStepRail from "../shop/CheckoutStepRail.astro";
import OrderTrustTimeline from "../shop/OrderTrustTimeline.astro";
import TrustStrip from "../shop/TrustStrip.astro";
import AuroraCanvas from "../shop/AuroraCanvas.astro";
import { localizePath, type Locale } from "../../i18n/dictionaries";
import { getShopCopy, shopLanguageTag } from "../../i18n/shop";
import { trustCopyForDelivery } from "../../lib/shop/platform/trust";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = getShopCopy(locale);
const flow = copy.flow;
const account = copy.account;
const shopHref = localizePath("/shop", locale);
const accountLoginHref = localizePath("/shop/account/login", locale);
const accountHref = localizePath("/shop/account", locale);
const orderStatusPath = localizePath("/shop/order", locale);
const crypto = copy.checkout.crypto;
---

<BaseLayout
  title={copy.checkout.orderPage.metaTitle}
  description={copy.checkout.orderPage.metaDescription}
  locale={locale}
  chrome="store"
  noindex={true}
  alternateLocales={[locale]}
  rss={false}
>
  <article class="order-flow" data-order-root data-view="loading">
    <AuroraCanvas class="order-flow__aurora" />
    <div class="order-flow__inner shell">
      <header class="order-flow__header">
        <div class="order-flow__title">
          <h1 data-order-heading>{flow.loading}</h1>
          <p class="order-flow__pill" data-order-pill hidden>
            <i aria-hidden="true"></i>
            <span data-order-state-label>—</span>
          </p>
        </div>
        <CheckoutStepRail steps={flow.steps} current={3} label={flow.pay.title} />
      </header>

      <section class="order-view" data-view-panel="loading" aria-busy="true">
        <div class="order-center">
          <span class="status-dot status-dot--pulse" aria-hidden="true"></span>
          <p>{flow.loading}</p>
        </div>
      </section>

      <!-- Pay: QR-first, centered -->
      <section class="order-view" data-view-panel="pay" hidden>
        <div class="pay-card">
          <div class="pay-card__qr">
            <div class="pay-card__qr-frame">
              <img
                data-order-qr-image
                hidden
                alt=""
                width="360"
                height="360"
                decoding="async"
                referrerpolicy="no-referrer"
              />
              <div class="pay-card__qr-empty" data-order-qr-empty>
                <span data-order-qr-note>{flow.pay.noQr}</span>
              </div>
            </div>
          </div>

          <div class="pay-card__body">
            <p class="pay-card__amount"><span>{flow.pay.amount}</span><strong data-order-amount>—</strong></p>

            <dl class="pay-card__meta">
              <div>
                <dt>{copy.checkout.order}</dt>
                <dd data-order-number>—</dd>
              </div>
              <div>
                <dt>{flow.pay.content}</dt>
                <dd>
                  <code data-payment-description>—</code>
                  <button type="button" data-copy-payment-description>{flow.pay.copy}</button>
                </dd>
              </div>
              <div data-order-expiry-row hidden>
                <dt>{flow.pay.expires}</dt>
                <dd><time data-order-expiry>—</time></dd>
              </div>
            </dl>

            <section class="crypto-payment-details" data-crypto-payment-details hidden aria-labelledby="crypto-payment-title">
              <h2 id="crypto-payment-title">{crypto.title}</h2>
              <div class="crypto-network-banner" data-crypto-network-banner>
                <span class="crypto-network-mark" data-crypto-network-mark aria-hidden="true">◎</span>
                <div><strong data-crypto-network-label>—</strong><small>{crypto.manualReviewNote}</small></div>
              </div>
              <div class="crypto-qr-card" data-crypto-qr hidden>
                <img data-crypto-qr-image alt="Crypto payment QR code" loading="lazy" decoding="async" />
                <small>Scan to send the exact amount on the selected network.</small>
              </div>
              <p class="crypto-payment-amount"><span>{crypto.sendExactly}</span><strong data-crypto-amount>—</strong></p>
              <dl class="pay-card__meta crypto-payment-meta">
                <div><dt>{crypto.provider}</dt><dd><span data-crypto-provider>—</span></dd></div>
                <div data-crypto-network-row><dt>{crypto.network}</dt><dd><span data-crypto-network>—</span></dd></div>
                <div><dt data-crypto-destination-label>{crypto.destination}</dt><dd><code data-crypto-destination>—</code><button type="button" data-copy-crypto-destination>{crypto.copy}</button></dd></div>
                <div data-crypto-memo-row><dt>{crypto.memoOrTag}</dt><dd><code data-crypto-memo>—</code><button type="button" data-copy-crypto-memo>{crypto.copy}</button></dd></div>
              </dl>
              <form data-crypto-reference-form class="crypto-reference-form">
                <label><span>{crypto.transactionReference}</span><input name="transactionReference" maxlength="180" autocomplete="off" spellcheck="false" placeholder={crypto.transactionPlaceholder} /></label>
                <label><span>{crypto.proofFile}</span><input name="proof" type="file" accept="image/jpeg,image/png,image/webp,image/gif,application/pdf" data-crypto-proof-file /></label>
                <small class="crypto-proof-hint">{crypto.proofHint}</small>
                <button type="submit" class="flow-btn flow-btn--primary" data-crypto-reference-submit>{crypto.confirmPayment}</button>
                <p class="crypto-reference-status" data-crypto-reference-status role="status" aria-live="polite"></p>
              </form>
            </section>

            <div class="pay-card__actions">
              <a class="flow-btn flow-btn--primary" data-order-checkout href="#" target="_blank" rel="noopener noreferrer" hidden>{flow.pay.openPayOs}</a>
              <button type="button" class="flow-btn flow-btn--ghost" data-order-refresh>{flow.pay.refresh}</button>
              <a class="flow-btn flow-btn--ghost" href={shopHref}>{flow.pay.backShop}</a>
            </div>
          </div>
        </div>
      </section>

      <section class="order-view" data-view-panel="verify" hidden>
        <div class="order-center">
          <span class="status-dot status-dot--pulse" aria-hidden="true"></span>
          <h2>{flow.verify.title}</h2>
          <div class="verify-meta">
            <div><span>{copy.checkout.order}</span><strong data-order-number-v>—</strong></div>
            <div><span>{flow.pay.amount}</span><strong data-order-amount-v>—</strong></div>
          </div>
        </div>
      </section>

      <section class="order-view" data-view-panel="deliver" hidden>
        <div class="deliver-card">
          <h2>{flow.deliver.title}</h2>
          <p class="deliver-card__order"><span data-order-number-d>—</span></p>
          <div class="deliver-list" data-order-delivery-list>
            <p>{flow.deliver.loading}</p>
          </div>
          <div class="order-save" data-order-save hidden>
            <p data-order-save-copy>{account.login.guestNote}</p>
            <a class="flow-btn flow-btn--ghost" data-order-save-link href={accountLoginHref}>{account.nav.login}</a>
          </div>
          <a class="flow-btn flow-btn--primary" href={shopHref}>{flow.deliver.backShop}</a>
        </div>
      </section>

      <section class="order-view" data-view-panel="terminal" hidden>
        <div class="order-center">
          <h2 data-order-terminal-title>{flow.terminal.missing}</h2>
          <a class="flow-btn flow-btn--primary" href={shopHref}>{flow.terminal.backShop}</a>
        </div>
      </section>
    </div>
  </article>

  <Fragment slot="page-scripts">
    <script is:inline define:vars={{ flow, checkoutCopy: copy.checkout, cryptoCopy: crypto, localeTag: shopLanguageTag[locale], accountLoginHref, accountHref, orderStatusPath, accountCopy: account }}>
      const root = document.querySelector("[data-order-root]");
      const heading = document.querySelector("[data-order-heading]");
      const pill = document.querySelector("[data-order-pill]");
      const stateLabel = document.querySelector("[data-order-state-label]");
      const panels = {
        loading: document.querySelector('[data-view-panel="loading"]'),
        pay: document.querySelector('[data-view-panel="pay"]'),
        verify: document.querySelector('[data-view-panel="verify"]'),
        deliver: document.querySelector('[data-view-panel="deliver"]'),
        terminal: document.querySelector('[data-view-panel="terminal"]'),
      };
      const qrImage = document.querySelector("[data-order-qr-image]");
      const qrEmpty = document.querySelector("[data-order-qr-empty]");
      const qrNote = document.querySelector("[data-order-qr-note]");
      const amountEls = [document.querySelector("[data-order-amount]"), document.querySelector("[data-order-amount-v]")];
      const numberEls = [
        document.querySelector("[data-order-number]"),
        document.querySelector("[data-order-number-v]"),
        document.querySelector("[data-order-number-d]"),
      ];
      const paymentDescriptionEl = document.querySelector("[data-payment-description]");
      const expiryEl = document.querySelector("[data-order-expiry]");
      const expiryRow = document.querySelector("[data-order-expiry-row]");
      const refreshButton = document.querySelector("[data-order-refresh]");
      const checkoutLink = document.querySelector("[data-order-checkout]");
      const copyButton = document.querySelector("[data-copy-payment-description]");
      const cryptoDetails = document.querySelector("[data-crypto-payment-details]");
      const cryptoAmount = document.querySelector("[data-crypto-amount]");
      const cryptoProvider = document.querySelector("[data-crypto-provider]");
      const cryptoNetwork = document.querySelector("[data-crypto-network]");
      const cryptoNetworkLabel = document.querySelector("[data-crypto-network-label]");
      const cryptoNetworkMark = document.querySelector("[data-crypto-network-mark]");
      const cryptoNetworkBanner = document.querySelector("[data-crypto-network-banner]");
      const cryptoNetworkRow = document.querySelector("[data-crypto-network-row]");
      const cryptoDestinationLabel = document.querySelector("[data-crypto-destination-label]");
      const cryptoQr = document.querySelector("[data-crypto-qr]");
      const cryptoQrImage = document.querySelector("[data-crypto-qr-image]");
      const cryptoDestination = document.querySelector("[data-crypto-destination]");
      const cryptoMemo = document.querySelector("[data-crypto-memo]");
      const cryptoMemoRow = document.querySelector("[data-crypto-memo-row]");
      const cryptoReferenceForm = document.querySelector("[data-crypto-reference-form]");
      const cryptoReferenceStatus = document.querySelector("[data-crypto-reference-status]");
      const cryptoReferenceSubmit = document.querySelector("[data-crypto-reference-submit]");
      const cryptoProofFile = document.querySelector("[data-crypto-proof-file]");
      const deliveryList = document.querySelector("[data-order-delivery-list]");
      const terminalTitle = document.querySelector("[data-order-terminal-title]");
      const stepItems = root?.querySelectorAll(".flow-steps li");

      const orderNumber = new URL(window.location.href).searchParams.get("order") || "";
      const fragment = new URLSearchParams(window.location.hash.replace(/^#/, ""));
      const fragmentToken = fragment.get("access") || "";
      const tokenPattern = /^[A-Za-z0-9_-]{24,200}$/;
      if (fragmentToken && tokenPattern.test(fragmentToken)) {
        sessionStorage.setItem("tung:shop:last-order", fragmentToken);
        if (orderNumber) sessionStorage.setItem(`tung:shop:order:${orderNumber}`, fragmentToken);
        history.replaceState(null, "", window.location.pathname + window.location.search);
      }
      const accessToken = tokenPattern.test(fragmentToken)
        ? fragmentToken
        : (orderNumber ? sessionStorage.getItem(`tung:shop:order:${orderNumber}`) : "") || sessionStorage.getItem("tung:shop:last-order") || "";

      let pollTimer = 0;
      let expiryTimer = 0;
      let deliveryRetryTimer = 0;
      let currentPaymentDescription = "";
      let deliveryLoaded = false;
      let deliveryRetryCount = 0;
      let qrLoadGeneration = 0;
      let qrObjectUrl = "";

      const releaseQrObjectUrl = () => {
        if (!qrObjectUrl) return;
        URL.revokeObjectURL(qrObjectUrl);
        qrObjectUrl = "";
      };

      const formatMoney = (minor, currency) => {
        const formatter = new Intl.NumberFormat(localeTag, { style: "currency", currency });
        const digits = formatter.resolvedOptions().maximumFractionDigits || 0;
        return formatter.format(minor / (10 ** digits));
      };

      const setRail = (step) => {
        stepItems?.forEach((li, index) => {
          const id = index + 1;
          li.classList.remove("is-active", "is-done", "is-todo");
          if (id < step) li.classList.add("is-done");
          else if (id === step) li.classList.add("is-active");
          else li.classList.add("is-todo");
        });
      };

      const liveRail = root?.querySelector("[data-order-live-rail]");
      const trustTimeline = root?.querySelector("[data-order-trust-timeline]");
      const setLiveRail = (view) => {
        if (!liveRail) return;
        const map = { loading: 0, pay: 1, verify: 2, deliver: 3, terminal: 4 };
        const active = map[view] ?? 0;
        liveRail.querySelectorAll("li").forEach((li, index) => {
          const id = index + 1;
          li.classList.remove("is-active", "is-done", "is-error");
          if (active <= 0) return;
          if (id < active) li.classList.add("is-done");
          else if (id === active || (view === "terminal" && id === 4)) li.classList.add(view === "terminal" && id === 4 ? "is-done" : "is-active");
        });
        if (view === "terminal") {
          liveRail.querySelectorAll("li").forEach((li) => {
            li.classList.remove("is-active");
            li.classList.add("is-done");
          });
        }
        if (trustTimeline) {
          const trustMap = { loading: 1, pay: 2, verify: 3, deliver: 4, terminal: 4 };
          const tActive = trustMap[view] ?? 1;
          trustTimeline.querySelectorAll("li").forEach((li, index) => {
            const id = index + 1;
            li.classList.remove("is-active", "is-done", "is-todo", "is-error");
            if (view === "terminal") li.classList.add("is-done");
            else if (id < tActive) li.classList.add("is-done");
            else if (id === tActive) li.classList.add("is-active");
            else li.classList.add("is-todo");
          });
        }
      };

      const showView = (view) => {
        root?.setAttribute("data-view", view);
        Object.entries(panels).forEach(([key, el]) => {
          if (el) el.hidden = key !== view;
        });
        setLiveRail(view);
      };

      const setTerminal = (title) => {
        clearTimeout(pollTimer);
        clearTimeout(deliveryRetryTimer);
        clearInterval(expiryTimer);
        showView("terminal");
        setRail(3);
        if (heading) heading.textContent = title;
        if (terminalTitle) terminalTitle.textContent = title;
        if (pill) pill.hidden = true;
        if (checkoutLink) checkoutLink.hidden = true;
      };

      const startExpiry = (iso) => {
        clearInterval(expiryTimer);
        if (!expiryEl || !expiryRow || !iso) {
          expiryRow?.setAttribute("hidden", "");
          return;
        }
        expiryRow.removeAttribute("hidden");
        expiryEl.setAttribute("datetime", iso);
        const expiry = Date.parse(iso);
        const update = () => {
          const remaining = Math.max(0, expiry - Date.now());
          if (!remaining) {
            expiryEl.textContent = flow.pay.expired;
            clearInterval(expiryTimer);
            return;
          }
          const seconds = Math.floor(remaining / 1000);
          const values = [Math.floor(seconds / 3600), Math.floor((seconds % 3600) / 60), seconds % 60];
          expiryEl.textContent = values.map((value) => String(value).padStart(2, "0")).join(":");
        };
        update();
        expiryTimer = window.setInterval(update, 1000);
      };

      const fillMeta = (order) => {
        const amount = formatMoney(order.amountMinor, order.currency);
        amountEls.forEach((el) => { if (el) el.textContent = amount; });
        numberEls.forEach((el) => { if (el) el.textContent = order.orderNumber; });
        const transferNote = String(order.paymentDescription || "").trim();
        if (paymentDescriptionEl) paymentDescriptionEl.textContent = transferNote || "—";
        currentPaymentDescription = transferNote;
        const isCrypto = order.method === "crypto_transfer";
        if (cryptoDetails) cryptoDetails.hidden = !isCrypto;
        if (isCrypto) {
          if (cryptoAmount) cryptoAmount.textContent = `${order.amountDisplay || order.amountAtomic || amount} ${order.asset || ""}`.trim();
          if (cryptoProvider) cryptoProvider.textContent = String(order.provider || "—").toUpperCase();
          const internalUid = order.destinationType === "uid" || order.rail === "internal_uid";
          if (cryptoNetworkBanner) cryptoNetworkBanner.hidden = internalUid;
          if (cryptoNetworkRow) cryptoNetworkRow.hidden = internalUid;
          if (cryptoDestinationLabel) cryptoDestinationLabel.textContent = internalUid ? "Bybit UID" : cryptoCopy.destination;
          if (cryptoNetwork) cryptoNetwork.textContent = internalUid ? "Internal transfer" : order.network || "—";
          const network = String(order.network || "").toUpperCase();
          const networkMap = {
            ETHEREUM: { label: "Ethereum · ERC20", tone: "eth", icon: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 2.5 6.1 9.2-6.1 3.5-6.1-3.5L12 2.5Z"/><path d="m5.9 13.1 6.1 3.5 6.1-3.5L12 21.5l-6.1-8.4Z"/></svg>' },
            BSC: { label: "BNB Chain · BEP20", tone: "bsc", icon: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 2.5 2.5 2.8-2.5 2.3-2.5-2.3L12 2.5Zm-4.2 5.1L10.4 10l-2.6 2.4L5.3 10l2.5-2.4Zm8.4 0 2.5 2.4-2.5 2.4-2.6-2.4 2.6-2.4ZM12 10.2l2.5 2.3-2.5 2.4-2.5-2.4 2.5-2.3Zm0 5.6 2.5 2.4-2.5 2.3-2.5-2.3 2.5-2.4Z"/></svg>' },
            SOLANA: { label: "Solana · SOL", tone: "sol", icon: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 6.2h12.7l1.8 2.1H6.8L5 6.2Zm1.3 4.8H19l-1.8 2.1H4.5l1.8-2.1Zm-.1 4.8h12.9L17.3 18H4.4l1.8-2.2Z"/></svg>' },
            POLYGON: { label: "Polygon", tone: "polygon", icon: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m7.2 5.2 4.8-2.7 4.8 2.7v5.5l-4.8 2.8-4.8-2.8V5.2Zm2 1.2v3.1l2.8 1.6 2.8-1.6V6.4L12 4.8 9.2 6.4Zm-4 7.3 2 1.2v3.1l2.8 1.6-2.2 1.2-2.6-1.5v-5.6Zm13.6 0v5.6l-2.6-1.2-2.2-1.2 2.8-1.6v-3.1l2-1.2Z"/></svg>' },
            TRON: { label: "TRON · TRC20", tone: "tron", icon: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m4 4 16 3-5 13-3-8-8-8Zm3.6 3.4 4.2 4.2 1.6 4.8 3-7.4-8.8-1.6Z"/></svg>' },
          };
          const networkInfo = networkMap[network] || { label: order.network || "Network", tone: "generic", icon: '<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8"/></svg>' };
          if (cryptoNetworkLabel) cryptoNetworkLabel.textContent = networkInfo.label;
          if (cryptoNetworkMark) {
            cryptoNetworkMark.className = `crypto-network-mark crypto-network-mark--${networkInfo.tone}`;
            cryptoNetworkMark.innerHTML = networkInfo.icon;
          }
          const qrUrl = !internalUid && typeof order.qrUrl === "string" && /^\/payment-qr\/[A-Za-z0-9._/-]+\.png$/.test(order.qrUrl) ? order.qrUrl : "";
          if (cryptoQrImage) cryptoQrImage.src = qrUrl;
          if (cryptoQr) cryptoQr.hidden = !qrUrl;
          if (cryptoDestination) cryptoDestination.textContent = order.destination || "—";
          if (cryptoMemo) cryptoMemo.textContent = order.memoOrTag || "—";
          if (cryptoMemoRow) cryptoMemoRow.hidden = !order.memoOrTag;
          if (cryptoReferenceStatus) {
            const hasSubmittedProof = Array.isArray(order.paymentProofs) && order.paymentProofs.some((proof) => proof.status === "submitted");
            cryptoReferenceStatus.textContent = hasSubmittedProof || order.verificationStatus === "needs_review"
              ? cryptoCopy.proofSubmitted
              : order.verificationStatus === "detected" ? cryptoCopy.evidenceDetected : "";
          }
        }
        if (stateLabel) stateLabel.textContent = checkoutCopy.status[order.state] || checkoutCopy.status.unknown;
        if (pill) pill.hidden = false;
        // Delivery copy: crypto/manual rails use manual messaging
        const deliveryCopy = document.querySelector("[data-order-delivery-copy]");
        if (deliveryCopy) {
          const mode = order.method === "crypto_transfer" || order.verificationStatus === "needs_review" ? "manual" : "automatic";
          deliveryCopy.textContent = mode === "manual"
            ? (locale === "vi"
              ? "Gói/thanh toán thủ công: admin kiểm tra trước khi giao. Trạng thái cập nhật trên đơn."
              : "Manual payment/fulfillment: reviewed before delivery. Status updates on this order.")
            : (locale === "vi"
              ? "Gói tự động: key được cấp sau khi thanh toán được backend xác minh."
              : "Automatic package: keys release after verified payment.");
        }
        // F4: drive trust timeline from real order state
        if (trustTimeline && order.state) {
          const stateToStep = {
            created: 1,
            awaiting_payment: 2,
            confirming: 3,
            paid: 3,
            fulfilled: 4,
            expired: -1,
            failed: -1,
            cancelled: -1,
          };
          const active = stateToStep[order.state] ?? 1;
          trustTimeline.querySelectorAll("li").forEach((li, index) => {
            const id = index + 1;
            li.classList.remove("is-active", "is-done", "is-todo", "is-error");
            if (active < 0) {
              li.classList.add(id === 1 ? "is-done" : id === 2 ? "is-error" : "is-todo");
            } else if (id < active) li.classList.add("is-done");
            else if (id === active) li.classList.add(active >= 4 ? "is-done" : "is-active");
            else li.classList.add("is-todo");
            if (active >= 4) li.classList.add("is-done");
          });
        }
      };

      const loadDelivery = async () => {
        if (!tokenPattern.test(accessToken) || deliveryLoaded) return;
        deliveryLoaded = true;
        if (deliveryList) deliveryList.textContent = flow.deliver.loading;
        try {
          const response = await fetch("/api/shop/delivery", {
            method: "POST",
            headers: { authorization: `Bearer ${accessToken}` },
            credentials: "same-origin",
            cache: "no-store",
          });
          const result = await response.json();
          if (!response.ok || !result.ok || !Array.isArray(result.deliveries)) throw new Error(result.code || "delivery_unavailable");
          if (deliveryList) {
            deliveryList.textContent = "";
            result.deliveries.forEach((delivery) => {
              const item = document.createElement("article");
              item.className = "deliver-item";
              const headingEl = document.createElement("strong");
              headingEl.textContent = `${delivery.title || delivery.sku || flow.deliver.itemFallback}${delivery.quantity > 1 ? ` × ${delivery.quantity}` : ""}`;
              item.append(headingEl);
              (Array.isArray(delivery.keys) ? delivery.keys : []).forEach((key) => {
                const row = document.createElement("div");
                row.className = "deliver-key";
                const value = document.createElement("code");
                value.textContent = String(key);
                const button = document.createElement("button");
                button.type = "button";
                button.textContent = flow.deliver.copyKey;
                button.addEventListener("click", async () => {
                  try {
                    await navigator.clipboard.writeText(String(key));
                    button.textContent = flow.deliver.copiedKey;
                  } catch {
                    button.textContent = cryptoCopy.copyFailed;
                  }
                  window.setTimeout(() => { button.textContent = flow.deliver.copyKey; }, 1800);
                });
                row.append(value, button);
                item.append(row);
              });
              deliveryList.append(item);
            });
          }
          deliveryRetryCount = 0;
          const saveBox = document.querySelector("[data-order-save]");
          const saveLink = document.querySelector("[data-order-save-link]");
          const saveCopy = document.querySelector("[data-order-save-copy]");
          if (saveBox) {
            try {
              const me = await fetch("/api/shop/me", { credentials: "same-origin" });
              if (me.ok) {
                await fetch("/api/shop/me/orders/claim", {
                  method: "POST",
                  credentials: "same-origin",
                  headers: { "content-type": "application/json" },
                  body: JSON.stringify({ accessToken }),
                }).catch(() => null);
                if (saveCopy) saveCopy.textContent = accountCopy.dashboard.viewOrders;
                if (saveLink) {
                  saveLink.href = accountHref;
                  saveLink.textContent = accountCopy.dashboard.viewOrders;
                }
                saveBox.hidden = false;
              } else {
                if (saveCopy) saveCopy.textContent = accountCopy.login.guestNote;
                if (saveLink) {
                  saveLink.href = `${accountLoginHref}?return=${encodeURIComponent(orderStatusPath)}`;
                  saveLink.textContent = accountCopy.nav.login;
                }
                saveBox.hidden = false;
              }
            } catch {
              saveBox.hidden = false;
            }
          }
        } catch (error) {
          deliveryLoaded = false;
          if (deliveryList) deliveryList.textContent = flow.deliver.unavailable;
          const errorCode = error instanceof Error ? error.message : "";
          if (errorCode === "order_delivery_in_progress" && deliveryRetryCount < 5) {
            deliveryRetryCount += 1;
            deliveryRetryTimer = window.setTimeout(loadOrder, Math.min(8_000, deliveryRetryCount * 1_000));
          }
        }
      };

      const renderOrder = (order) => {
        fillMeta(order);
        clearTimeout(pollTimer);

        if (order.state === "created" || order.state === "awaiting_payment") {
          showView("pay");
          setRail(3);
          if (heading) heading.textContent = flow.pay.title;
          if (qrImage && qrEmpty) {
            const generation = ++qrLoadGeneration;
            const showEmpty = () => {
              if (generation !== qrLoadGeneration) return;
              qrImage.onload = null;
              qrImage.onerror = null;
              qrImage.removeAttribute("src");
              releaseQrObjectUrl();
              qrImage.hidden = true;
              qrEmpty.hidden = false;
              if (qrNote) qrNote.textContent = flow.pay.noQr;
            };
            const showLoaded = () => {
              if (generation !== qrLoadGeneration) return;
              qrImage.hidden = false;
              qrEmpty.hidden = true;
            };
            const loadThroughProxy = async () => {
              if (generation !== qrLoadGeneration) return;
              qrImage.onerror = null;
              qrImage.hidden = true;
              qrEmpty.hidden = false;
              if (qrNote) qrNote.textContent = flow.pay.qrPreparing || flow.pay.refreshing || flow.pay.noQr;
              try {
                const response = await fetch("/api/shop/order-qr", {
                  headers: { authorization: `Bearer ${accessToken}` },
                  credentials: "same-origin",
                  cache: "no-store",
                });
                if (!response.ok) throw new Error("qr_proxy_unavailable");
                const blob = await response.blob();
                if (!blob.type.startsWith("image/") || blob.size < 64 || blob.size > 512_000) {
                  throw new Error("qr_proxy_invalid");
                }
                if (generation !== qrLoadGeneration) return;
                releaseQrObjectUrl();
                qrObjectUrl = URL.createObjectURL(blob);
                qrImage.onload = showLoaded;
                qrImage.onerror = showEmpty;
                qrImage.src = qrObjectUrl;
              } catch {
                showEmpty();
              }
            };
            const qrUrl = order.destinationType === "uid" || order.rail === "internal_uid" ? "" : typeof order.qrUrl === "string" ? order.qrUrl.trim() : "";
            if (/^https:\/\//i.test(qrUrl)) {
              releaseQrObjectUrl();
              qrImage.alt = checkoutCopy.qrAlt.replace("{order}", order.orderNumber);
              qrImage.onload = showLoaded;
              qrImage.onerror = loadThroughProxy;
              if (qrImage.getAttribute("src") === qrUrl && !qrImage.hidden) {
                qrEmpty.hidden = true;
              } else {
                // Keep empty state visible until the image actually loads.
                qrImage.hidden = true;
                qrEmpty.hidden = false;
                if (qrNote) qrNote.textContent = flow.pay.qrPreparing || flow.pay.refreshing || flow.pay.noQr;
                qrImage.src = qrUrl;
              }
            } else {
              showEmpty();
            }
          }
          if (checkoutLink) {
            if (order.checkoutUrl) {
              checkoutLink.href = order.checkoutUrl;
              checkoutLink.hidden = false;
            } else {
              checkoutLink.hidden = true;
              checkoutLink.removeAttribute("href");
            }
          }
          startExpiry(order.expiresAt);
        } else if (order.state === "confirming") {
          qrLoadGeneration += 1;
          releaseQrObjectUrl();
          showView(order.method === "crypto_transfer" ? "pay" : "verify");
          setRail(3);
          if (heading) heading.textContent = order.method === "crypto_transfer" ? crypto.manualReviewTitle : flow.verify.title;
          if (qrImage) {
            qrImage.removeAttribute("src");
            qrImage.hidden = true;
          }
          if (checkoutLink) checkoutLink.hidden = true;
          startExpiry(order.expiresAt);
        } else if (order.state === "paid" || order.state === "fulfilled") {
          qrLoadGeneration += 1;
          releaseQrObjectUrl();
          showView("deliver");
          setRail(4);
          if (heading) heading.textContent = flow.deliver.title;
          if (checkoutLink) checkoutLink.hidden = true;
          clearInterval(expiryTimer);
          if (!deliveryLoaded) loadDelivery();
        } else if (order.state === "expired") {
          setTerminal(flow.terminal.expired);
        } else if (order.state === "failed") {
          setTerminal(flow.terminal.failed);
        } else if (order.state === "cancelled") {
          setTerminal(flow.terminal.cancelled);
        } else {
          setTerminal(flow.terminal.unavailable);
        }

        if (order.pollingAfterSeconds) {
          pollTimer = window.setTimeout(loadOrder, Math.max(3, order.pollingAfterSeconds || 3) * 1000);
        }
      };

      const loadOrder = async () => {
        if (refreshButton) {
          refreshButton.disabled = true;
          refreshButton.textContent = flow.pay.refreshing;
        }
        try {
          const headers = {};
          if (accessToken && tokenPattern.test(accessToken)) {
            headers["authorization"] = `Bearer ${accessToken}`;
          }
          const query = orderNumber ? `?order=${encodeURIComponent(orderNumber)}` : "";
          const response = await fetch(`/api/shop/order${query}`, {
            headers,
            credentials: "same-origin",
            cache: "no-store",
          });
          const result = await response.json();
          if (!response.ok || !result.ok || !result.order) throw new Error(result.code || "unavailable");
          renderOrder(result.order);
        } catch (error) {
          if (error instanceof Error && (error.message === "order_not_found" || error.message === "order_access_required")) {
            setTerminal(flow.terminal.missing);
          } else if (root?.getAttribute("data-view") === "loading") {
            setTerminal(flow.terminal.unavailable);
          }
        } finally {
          if (refreshButton) {
            refreshButton.disabled = false;
            refreshButton.textContent = flow.pay.refresh;
          }
        }
      };

      refreshButton?.addEventListener("click", loadOrder);
      copyButton?.addEventListener("click", async () => {
        if (!currentPaymentDescription) return;
        try {
          await navigator.clipboard.writeText(currentPaymentDescription);
          copyButton.textContent = flow.pay.copied;
        } catch {
          copyButton.textContent = flow.pay.copyFailed;
        }
        window.setTimeout(() => { copyButton.textContent = flow.pay.copy; }, 1800);
      });
      const copyValue = (element, button) => {
        button?.addEventListener("click", async () => {
          const value = String(element?.textContent || "").trim();
          if (!value || value === "—") return;
          try { await navigator.clipboard.writeText(value); button.textContent = cryptoCopy.copied; } catch { button.textContent = cryptoCopy.copyFailed; }
          window.setTimeout(() => { button.textContent = cryptoCopy.copy; }, 1800);
        });
      };
      copyValue(cryptoDestination, document.querySelector("[data-copy-crypto-destination]"));
      copyValue(cryptoMemo, document.querySelector("[data-copy-crypto-memo]"));
      cryptoReferenceForm?.addEventListener("submit", async (event) => {
        event.preventDefault();
        const input = cryptoReferenceForm.querySelector("input[name=transactionReference]");
        const reference = String(input?.value || "").trim();
        const file = cryptoProofFile?.files?.[0] || null;
        if (!reference && !file) { if (cryptoReferenceStatus) cryptoReferenceStatus.textContent = cryptoCopy.proofRequired; return; }
        if (cryptoReferenceSubmit) { cryptoReferenceSubmit.disabled = true; cryptoReferenceSubmit.textContent = cryptoCopy.submittingReference; }
        try {
          const form = new FormData(cryptoReferenceForm);
          const response = await fetch("/api/shop/payment-proof", { method: "POST", headers: { authorization: `Bearer ${accessToken}` }, credentials: "same-origin", body: form });
          const result = await response.json();
          if (!response.ok || !result.ok) throw new Error(result.code || "reference_submit_failed");
          if (cryptoReferenceStatus) cryptoReferenceStatus.textContent = cryptoCopy.proofSubmitted;
          loadOrder();
        } catch { if (cryptoReferenceStatus) cryptoReferenceStatus.textContent = cryptoCopy.referenceError; }
        finally { if (cryptoReferenceSubmit) { cryptoReferenceSubmit.disabled = false; cryptoReferenceSubmit.textContent = cryptoCopy.confirmPayment; } }
      });
      document.addEventListener("visibilitychange", () => {
        if (document.visibilityState === "visible") loadOrder();
      });
      loadOrder();
    </script>
  </Fragment>
</BaseLayout>

