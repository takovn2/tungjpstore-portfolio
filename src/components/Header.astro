---
import { defaultLocale, getTranslation, localeNames, locales, localizePath, type Locale } from "../i18n/dictionaries";

interface Props { locale?: Locale; availableLocales?: readonly Locale[]; }
const { locale = defaultLocale, availableLocales = locales } = Astro.props;
const t = getTranslation(locale);
const nav = [
  { href: "/work", label: t.common.navigation.work },
  { href: "/pricing", label: t.common.navigation.pricing },
  { href: "/lab", label: t.common.navigation.lab },
  { href: "/blog", label: t.common.navigation.blog },
  { href: "/about", label: t.common.navigation.about },
  { href: "/contact", label: t.common.navigation.contact },
];

const currentPath = Astro.url.pathname;
const currentLocation = `${Astro.url.pathname}${Astro.url.search}`;
const pathWithoutLocale = currentPath.replace(/^\/(?:en|ja|zh)(?=\/|$)/, "") || "/";
---

<header class="site-header" data-header>
  <div class="header-inner shell">
    <a class="wordmark" href={localizePath("/", locale)} aria-label={`TUNG — ${t.common.navigation.home}`}>
      <picture class="wordmark-picture">
        <source media="(max-width: 430px)" srcset="/brand/tung-icon-on-dark.png" />
        <img class="wordmark-logo" src="/brand/tung-wordmark-on-dark.png" alt="" width="453" height="198" decoding="async" />
      </picture>
    </a>

    <nav class="desktop-nav" aria-label={t.common.navigation.primary}>
      {nav.map((item) => (
        <a href={localizePath(item.href, locale)} aria-current={pathWithoutLocale.startsWith(item.href) ? "page" : undefined}>{item.label}</a>
      ))}
    </nav>

    <div class="header-tools">
      <div class="language-switcher" aria-label={t.common.language.label}>
        {availableLocales.map((item) => (
          <a href={localizePath(currentLocation, item)} data-language-link data-locale-choice={item} aria-label={t.common.language.switchTo.replace("{language}", localeNames[item])} aria-current={locale === item ? "true" : undefined}>{item.toUpperCase()}</a>
        ))}
      </div>
      <a class="availability" href={localizePath("/contact", locale)}>
      <span class="status-dot" aria-hidden="true"></span>
      <span>{t.common.footer.availability}</span>
      </a>
    </div>

    <button
      class="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-menu"
      data-menu-toggle
      data-open-label={t.common.navigation.menu}
      data-close-label={t.common.navigation.closeMenu}
      data-open-visible={t.common.navigation.menuLabel}
      data-close-visible={t.common.navigation.closeLabel}
    >
      <span class="sr-only">{t.common.navigation.menu}</span>
      <span aria-hidden="true">{t.common.navigation.menuLabel}</span>
    </button>
  </div>

  <div class="mobile-menu" id="mobile-menu" data-mobile-menu hidden>
    <nav aria-label={t.common.navigation.mobile}>
      {nav.map((item, index) => (
        <a href={localizePath(item.href, locale)} data-menu-link>
          <span>0{index + 1}</span>
          {item.label}
        </a>
      ))}
    </nav>
    <div class="mobile-menu__footer">
      <span class="status-dot" aria-hidden="true"></span>
      {t.common.footer.availability}
    </div>
  </div>
</header>

<style>
  .site-header { position: fixed; inset: 0 0 auto; z-index: 50; border-bottom: 1px solid transparent; }
  .site-header.is-scrolled { border-color: var(--line); }
  .site-header.is-scrolled::before { content: ""; position: absolute; inset: 0; pointer-events: none; background: rgba(10, 11, 11, 0.88); backdrop-filter: blur(16px); }
  .header-inner { position: relative; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; min-height: 4.5rem; gap: 2rem; }
  .wordmark { display: grid; width: fit-content; min-height: 3rem; place-items: center; }
  .wordmark-picture { display: block; width: clamp(7rem, 9vw, 7.75rem); }
  .wordmark-logo { width: 100%; height: auto; }
  .desktop-nav { display: flex; gap: 2rem; font-size: 0.86rem; }
  .desktop-nav a { position: relative; color: var(--paper-soft); }
  .desktop-nav a:hover, .desktop-nav a[aria-current="page"] { color: var(--paper); }
  .desktop-nav a[aria-current="page"]::after { content: ""; position: absolute; left: 0; right: 0; bottom: -0.65rem; height: 1px; background: var(--accent); }
  .header-tools { justify-self: end; display: flex; align-items: center; gap: 1.25rem; }
  .availability { display: flex; align-items: center; gap: 0.6rem; color: var(--paper-soft); font: 600 0.66rem/1 var(--font-mono); letter-spacing: 0.1em; text-transform: uppercase; }
  .language-switcher { display: flex; align-items: center; gap: .15rem; font: 600 .62rem/1 var(--font-mono); letter-spacing: .06em; }
  .language-switcher a { display: inline-grid; min-width: 2.25rem; min-height: 2.25rem; place-items: center; padding: .3rem; color: var(--paper-soft); }
  .language-switcher a:hover, .language-switcher a[aria-current="true"] { color: var(--accent); }
  .status-dot { width: 0.5rem; height: 0.5rem; border-radius: 50%; background: var(--accent); box-shadow: 0 0 0 0.2rem rgba(201, 244, 61, 0.12); }
  .menu-toggle { display: none; min-width: 3rem; min-height: 2.75rem; justify-self: end; cursor: pointer; padding-inline: .5rem; background: transparent; font: 700 0.72rem/1 var(--font-mono); letter-spacing: 0.1em; text-transform: uppercase; }
  .mobile-menu { position: fixed; inset: 4rem 0 0; z-index: 49; min-height: 0; max-height: calc(100vh - 4rem); max-height: calc(100dvh - 4rem); overflow-x: hidden; overflow-y: auto; overscroll-behavior: contain; touch-action: pan-y pinch-zoom; scrollbar-gutter: stable; padding: clamp(.875rem, 3dvh, 1.75rem) var(--gutter) max(1rem, calc(env(safe-area-inset-bottom) + .25rem)); background: var(--ink); -webkit-overflow-scrolling: touch; }
  .mobile-menu nav { display: grid; }
  .mobile-menu nav a { display: flex; align-items: baseline; gap: clamp(.7rem, 2.5vw, 1rem); padding: clamp(.5rem, 1.55dvh, .72rem) 0; border-bottom: 1px solid var(--line); font-family: var(--font-serif); font-size: clamp(1.8rem, 9vw, 3.35rem); font-size: clamp(1.8rem, min(9vw, 6.2dvh), 3.35rem); font-weight: 400; line-height: 1.02; }
  .mobile-menu nav span { color: var(--paper-soft); font: 500 0.65rem/1 var(--font-mono); }
  .mobile-menu__footer { display: flex; align-items: center; gap: 0.7rem; margin-top: clamp(1rem, 3dvh, 2.25rem); color: var(--paper-soft); font-size: 0.76rem; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; }
  @media (max-width: 800px) {
    .header-inner { grid-template-columns: minmax(0, 1fr) auto auto; min-height: 4rem; gap: .35rem; }
    .wordmark { grid-column: 1; grid-row: 1; min-width: 0; }
    .availability { display: none; }
    .desktop-nav { grid-column: 1 / -1; display: flex; justify-content: space-between; padding-bottom: .8rem; }
    /* Keep the full nav visible when scripts fail; hide it only after JS is ready. */
    :global(html.js) .desktop-nav { display: none; }
    .header-tools { grid-column: 2; grid-row: 1; gap: 0; }
    .menu-toggle { grid-column: 3; grid-row: 1; }
    :global(html.js) .menu-toggle { display: block; }
  }
  @media (max-width: 800px) and (max-height: 680px) {
    .mobile-menu { padding-top: clamp(.45rem, 1.8dvh, .75rem); }
    .mobile-menu nav a { gap: .7rem; padding-block: clamp(.3rem, 1.1dvh, .48rem); font-size: clamp(1.42rem, min(7vw, 5.6dvh), 2rem); line-height: .98; }
    .mobile-menu nav span { font-size: .58rem; }
    .mobile-menu__footer { margin-top: clamp(.6rem, 1.8dvh, 1rem); font-size: .68rem; }
  }
  @media (max-width: 430px) { .wordmark-picture { width: 2.8rem; } }
</style>

<script>
  const header = document.querySelector<HTMLElement>("[data-header]");
  const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const menu = document.querySelector<HTMLElement>("[data-mobile-menu]");
  const languageLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>("[data-language-link]"));
  const localeCookieName = "tung_locale";
  const persistLocaleChoice = (link: HTMLAnchorElement) => {
    const locale = link.dataset.localeChoice;
    if (!locale) return;
    document.cookie = `${localeCookieName}=${encodeURIComponent(locale)}; Path=/; Max-Age=31536000; SameSite=Lax`;
  };
  languageLinks.forEach((link) => link.addEventListener("click", () => persistLocaleChoice(link)));
  let previousFocus: HTMLElement | null = null;
  let lockedScrollY = 0;
  let bodyLockSnapshot: { position: string; top: string; left: string; right: string; width: string } | null = null;
  const inertTargets = Array.from(document.querySelectorAll<HTMLElement>("main, footer, .skip-link, .wordmark, .desktop-nav, .header-tools"));
  const initiallyInert = new Map<HTMLElement, boolean>();

  const setHeaderState = () => header?.classList.toggle("is-scrolled", window.scrollY > 18);
  const syncLanguageLinkSuffixes = () => {
    languageLinks.forEach((link) => {
      const target = new URL(link.href, window.location.href);
      target.search = window.location.search;
      target.hash = window.location.hash;
      link.href = `${target.pathname}${target.search}${target.hash}`;
    });
  };
  const setBackgroundInert = (inert: boolean) => {
    inertTargets.forEach((element) => {
      if (inert) {
        if (!initiallyInert.has(element)) initiallyInert.set(element, element.hasAttribute("inert"));
        element.setAttribute("inert", "");
      } else if (initiallyInert.has(element) && !initiallyInert.get(element)) {
        element.removeAttribute("inert");
      }
    });
    if (!inert) initiallyInert.clear();
  };
  const setToggleLabel = (label: string, visible: string) => {
    const srOnly = toggle?.querySelector<HTMLElement>(".sr-only");
    const visibleLabel = toggle?.querySelector<HTMLElement>("span[aria-hidden]");
    if (srOnly) srOnly.textContent = label;
    if (visibleLabel) visibleLabel.textContent = visible;
  };
  const lockPageScroll = () => {
    if (bodyLockSnapshot) return;
    const body = document.body;
    lockedScrollY = window.scrollY;
    bodyLockSnapshot = {
      position: body.style.position,
      top: body.style.top,
      left: body.style.left,
      right: body.style.right,
      width: body.style.width,
    };
    body.classList.add("menu-open");
    body.style.position = "fixed";
    body.style.top = `-${lockedScrollY}px`;
    body.style.left = "0";
    body.style.right = "0";
    body.style.width = "100%";
  };
  const unlockPageScroll = (restoreScroll = true) => {
    const body = document.body;
    body.classList.remove("menu-open");
    if (!bodyLockSnapshot) return;
    const snapshot = bodyLockSnapshot;
    bodyLockSnapshot = null;
    body.style.position = snapshot.position;
    body.style.top = snapshot.top;
    body.style.left = snapshot.left;
    body.style.right = snapshot.right;
    body.style.width = snapshot.width;
    if (restoreScroll) window.scrollTo(0, lockedScrollY);
  };
  const closeMenu = ({ restoreFocus = true, restoreScroll = true } = {}) => {
    if (!toggle || !menu) {
      unlockPageScroll(restoreScroll);
      return;
    }
    const wasOpen = toggle.getAttribute("aria-expanded") === "true" || !menu.hidden;
    toggle.setAttribute("aria-expanded", "false");
    setToggleLabel(toggle.dataset.openLabel ?? "", toggle.dataset.openVisible ?? "");
    menu.hidden = true;
    menu.scrollTop = 0;
    setBackgroundInert(false);
    unlockPageScroll(restoreScroll);
    const focusTarget = previousFocus?.isConnected ? previousFocus : toggle;
    if (restoreFocus && wasOpen) focusTarget?.focus({ preventScroll: true });
    previousFocus = null;
  };
  const openMenu = () => {
    if (!toggle || !menu) return;
    previousFocus = document.activeElement as HTMLElement;
    toggle.setAttribute("aria-expanded", "true");
    setToggleLabel(toggle.dataset.closeLabel ?? "", toggle.dataset.closeVisible ?? "");
    menu.hidden = false;
    menu.scrollTop = 0;
    setBackgroundInert(true);
    lockPageScroll();
    menu.querySelector<HTMLElement>("a")?.focus({ preventScroll: true });
  };

  closeMenu({ restoreFocus: false });
  setHeaderState();
  syncLanguageLinkSuffixes();
  window.addEventListener("scroll", setHeaderState, { passive: true });
  window.addEventListener("hashchange", syncLanguageLinkSuffixes);
  window.addEventListener("pageshow", () => closeMenu({ restoreFocus: false }));
  toggle?.addEventListener("click", () => toggle.getAttribute("aria-expanded") === "true" ? closeMenu() : openMenu());
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && toggle?.getAttribute("aria-expanded") === "true") closeMenu();
    if (!menu || event.key !== "Tab" || menu.hidden) return;
    const menuItems = Array.from(menu.querySelectorAll<HTMLElement>(
      "a[href], button:not([disabled]), [tabindex]:not([tabindex=\"-1\"])",
    ));
    const focusable = [toggle, ...menuItems].filter(Boolean) as HTMLElement[];
    const first = focusable[0];
    const last = focusable.at(-1);
    if (!first || !last) return;
    if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last.focus(); }
    else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first.focus(); }
  });
  menu?.querySelectorAll("[data-menu-link]").forEach((link) => link.addEventListener("click", () => closeMenu({ restoreFocus: false })));
  window.matchMedia("(min-width: 801px)").addEventListener("change", (event) => {
    if (event.matches && toggle?.getAttribute("aria-expanded") === "true") closeMenu();
  });
</script>
