---
import { getProjectEvidence, type EvidenceMetric } from "../content/portfolio-evidence";
import { localizePath, type Locale } from "../i18n/dictionaries";
import type { PublicProject } from "../lib/public-content";

type ShowcaseSlug = "logivn" | "fball";
type VisualRole =
  | "logivn-cover"
  | "logivn-orders"
  | "logivn-ai"
  | "fball-home"
  | "fball-story"
  | "fball-attendance";

type ShowcaseMetric = Pick<EvidenceMetric, "value" | "label">;
type ShowcaseCopy = {
  impactLabel: string;
  viewCaseStudy: string;
  openProject: string;
  imageLabel: string;
  highlightLabels: Record<ShowcaseSlug, string[]>;
};

interface Props {
  projects: PublicProject[];
  locale: Locale;
  copy?: Partial<ShowcaseCopy>;
  metricsByProject?: Record<string, ShowcaseMetric[]>;
}

type VisualSpec = {
  src: string;
  width: number;
  height: number;
  role: VisualRole;
};

const visualSets = {
  logivn: [
    { src: "/images/projects/logivn-showcase-cover.webp", width: 1586, height: 992, role: "logivn-cover" },
    { src: "/images/projects/logivn-showcase-orders.webp", width: 1586, height: 992, role: "logivn-orders" },
    { src: "/images/projects/logivn-showcase-ai.webp", width: 1586, height: 992, role: "logivn-ai" },
  ],
  fball: [
    { src: "/images/projects/fball-showcase-home.webp", width: 1536, height: 1024, role: "fball-home" },
    { src: "/images/projects/fball-showcase-story.webp", width: 1536, height: 1024, role: "fball-story" },
    { src: "/images/projects/fball-showcase-attendance.webp", width: 1536, height: 1024, role: "fball-attendance" },
  ],
} satisfies Record<ShowcaseSlug, VisualSpec[]>;

const copyByLocale: Record<Locale, ShowcaseCopy> = {
  vi: { impactLabel: "Điểm nổi bật", viewCaseStudy: "Xem case study", openProject: "Mở sản phẩm", imageLabel: "Sản phẩm", highlightLabels: { logivn: ["Bề mặt kết nối", "Khu vực chính", "Luồng order"], fball: ["Route công khai", "Không gian đội", "Bước trong ngày thi đấu"] } },
  en: { impactLabel: "Highlights", viewCaseStudy: "View case study", openProject: "Open product", imageLabel: "Product", highlightLabels: { logivn: ["Connected surfaces", "Core areas", "Order flow"], fball: ["Public routes", "Team workspace", "Match-day steps"] } },
  ja: { impactLabel: "ハイライト", viewCaseStudy: "ケーススタディを見る", openProject: "プロダクトを開く", imageLabel: "プロダクト", highlightLabels: { logivn: ["つながる画面", "主な領域", "注文フロー"], fball: ["公開ルート", "チームの作業場", "試合日の手順"] } },
  zh: { impactLabel: "产品亮点", viewCaseStudy: "查看案例", openProject: "打开产品", imageLabel: "产品", highlightLabels: { logivn: ["连接界面", "核心区域", "点单流程"], fball: ["公开路线", "球队工作区", "比赛日步骤"] } },
};

const altDescriptions: Record<VisualRole, Record<Locale, string>> = {
  "logivn-cover": {
    vi: "tổng quan dashboard, đơn hàng, nhân sự và trợ lý vận hành AI",
    en: "overview of the dashboard, orders, staff and AI operations assistant",
    ja: "ダッシュボード、注文、スタッフ、AI運用アシスタントの概要",
    zh: "仪表盘、订单、员工与AI运营助手总览",
  },
  "logivn-orders": {
    vi: "không gian quản lý đơn tại quán, pickup, giao hàng và đặt online",
    en: "order workspace for dine-in, pickup, delivery and online ordering",
    ja: "店内、持ち帰り、配達、オンライン注文を扱う注文ワークスペース",
    zh: "覆盖堂食、自取、配送与在线下单的订单工作区",
  },
  "logivn-ai": {
    vi: "LogiBot AI hỗ trợ truy vấn nhanh trạng thái vận hành nhà hàng",
    en: "LogiBot AI for quickly querying restaurant operating state",
    ja: "レストランの運用状態を素早く確認するLogiBot AI",
    zh: "用于快速查询餐厅运营状态的LogiBot AI",
  },
  "fball-home": {
    vi: "trang chủ quản lý đội bóng, tìm kèo và các mô-đun ngày thi đấu",
    en: "home page for team management, match discovery and match-day modules",
    ja: "チーム管理、対戦相手探し、試合日モジュールのホーム画面",
    zh: "球队管理、约赛发现与比赛日模块首页",
  },
  "fball-story": {
    vi: "câu chuyện đội bóng từ chốt trận, điểm danh đến tìm người trên sân",
    en: "team story spanning match confirmation, attendance and finding players",
    ja: "試合確定、出欠確認、選手募集までをつなぐチームストーリー",
    zh: "从确认比赛、出勤到寻找球员的球队故事",
  },
  "fball-attendance": {
    vi: "giao diện điểm danh realtime với bốn trạng thái thành viên rõ ràng",
    en: "realtime attendance interface with four clear member states",
    ja: "メンバーの四つの状態を明確に示すリアルタイム出欠画面",
    zh: "以四种清晰成员状态呈现的实时出勤界面",
  },
};

const { projects, locale, copy, metricsByProject } = Astro.props;
const labels = { ...copyByLocale[locale], ...copy };
const supportedProjects = projects
  .filter((project): project is PublicProject & { slug: ShowcaseSlug } => project.slug === "logivn" || project.slug === "fball")
  .slice(0, 2)
  .map((project) => ({
    project,
    visuals: visualSets[project.slug],
    metrics: (metricsByProject?.[project.slug] ?? getProjectEvidence(project.slug, locale)?.metrics ?? []).slice(0, 3).map((metric, metricIndex) => ({
      ...metric,
      label: labels.highlightLabels[project.slug][metricIndex] ?? labels.impactLabel,
    })),
  }));
---

<div class="home-project-showcase">
  {supportedProjects.map(({ project, visuals, metrics }, index) => {
    const caseStudyHref = localizePath(`/work/${project.slug}`, locale);
    const titleId = `home-project-${project.slug}`;
    const mirrored = index % 2 === 1;

    return (
      <article class="home-project-showcase__project" data-project={project.slug} data-mirrored={mirrored ? "true" : undefined} aria-labelledby={titleId}>
        <header class="home-project-showcase__copy">
          <div class="home-project-showcase__meta">
            <span>{String(index + 1).padStart(2, "0")}</span>
            <span>{project.category}</span>
          </div>
          <h3 id={titleId}><a href={caseStudyHref}>{project.name}</a></h3>
          <p class="home-project-showcase__thesis">{project.thesis}</p>
          <p class="home-project-showcase__summary">{project.summary}</p>
          <div class="home-project-showcase__actions">
            <a class="home-project-showcase__link home-project-showcase__link--primary" href={caseStudyHref}>{labels.viewCaseStudy} <span aria-hidden="true">↗</span></a>
            {project.liveUrl && <a class="home-project-showcase__link" href={project.liveUrl} target="_blank" rel="noreferrer">{labels.openProject} <span aria-hidden="true">↗</span></a>}
          </div>
        </header>

        {visuals.map((visual, visualIndex) => (
          <figure class:list={["home-project-showcase__visual", `home-project-showcase__visual--${visualIndex === 0 ? "lead" : visualIndex === 1 ? "secondary" : "tertiary"}`]}>
            <a href={caseStudyHref} aria-label={`${labels.viewCaseStudy}: ${project.name}`}>
              <img
                src={visual.src}
                alt={`${project.name} — ${altDescriptions[visual.role][locale]}`}
                width={visual.width}
                height={visual.height}
                loading="lazy"
                decoding="async"
                fetchpriority="low"
              />
            </a>
            <figcaption><span>{labels.imageLabel}</span><span>{String(visualIndex + 1).padStart(2, "0")} / 03</span></figcaption>
          </figure>
        ))}

        <aside class="home-project-showcase__proof" aria-label={`${labels.impactLabel}: ${project.name}`}>
          <p>{labels.impactLabel}</p>
          <dl>
            {metrics.map((metric) => <div><dt>{metric.value}</dt><dd>{metric.label}</dd></div>)}
          </dl>
        </aside>
      </article>
    );
  })}
</div>

<style>
  .home-project-showcase {
    min-width: 0;
  }

  .home-project-showcase__project {
    --project-rgb: 201, 244, 61;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: clamp(1.1rem, 1.8vw, 2rem);
    align-items: start;
    min-width: 0;
  }

  .home-project-showcase__project[data-project="fball"] {
    --project-rgb: 255, 157, 99;
  }

  .home-project-showcase__project + .home-project-showcase__project {
    margin-top: clamp(8rem, 14vw, 14rem);
    padding-top: clamp(5rem, 9vw, 8rem);
    border-top: 1px solid var(--line);
  }

  .home-project-showcase__copy {
    grid-column: 1 / 5;
    grid-row: 1;
    min-width: 0;
    padding-top: clamp(.5rem, 1.5vw, 1.5rem);
  }

  .home-project-showcase__meta {
    display: flex;
    flex-wrap: wrap;
    gap: .6rem 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--line);
    color: var(--paper-soft);
    font: 600 .62rem/1.4 var(--font-mono);
    letter-spacing: .12em;
    text-transform: uppercase;
  }

  .home-project-showcase__meta span:first-child {
    color: var(--accent);
  }

  .home-project-showcase__copy h3 {
    margin: clamp(1.5rem, 3vw, 2.5rem) 0 1.3rem;
    font: 400 clamp(3rem, 5.2vw, 5.9rem)/.82 var(--font-serif);
    letter-spacing: -.06em;
  }

  .home-project-showcase__copy h3 a {
    transition: color 180ms ease;
  }

  .home-project-showcase__copy h3 a:hover,
  .home-project-showcase__copy h3 a:focus-visible {
    color: var(--accent);
  }

  .home-project-showcase__thesis {
    max-width: 27rem;
    margin-bottom: 1rem;
    font: 400 clamp(1.25rem, 1.9vw, 1.7rem)/1.24 var(--font-serif);
  }

  .home-project-showcase__summary {
    max-width: 31rem;
    margin-bottom: 0;
    color: var(--paper-soft);
    font-size: .94rem;
    line-height: 1.65;
  }

  .home-project-showcase__actions {
    display: flex;
    flex-wrap: wrap;
    gap: .65rem;
    margin-top: 2rem;
  }

  .home-project-showcase__link {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    min-height: 2.8rem;
    padding: .75rem .9rem;
    border: 1px solid var(--line-strong);
    color: var(--paper);
    font: 600 .64rem/1.2 var(--font-mono);
    letter-spacing: .08em;
    text-transform: uppercase;
    transition: border-color 180ms ease, color 180ms ease, background-color 180ms ease;
  }

  .home-project-showcase__link:hover,
  .home-project-showcase__link:focus-visible {
    border-color: var(--accent);
    color: var(--accent);
  }

  .home-project-showcase__link--primary {
    border-color: var(--accent);
    background: var(--accent);
    color: var(--accent-ink);
  }

  .home-project-showcase__link--primary:hover,
  .home-project-showcase__link--primary:focus-visible {
    background: transparent;
    color: var(--accent);
  }

  .home-project-showcase__visual {
    --visual-radius: clamp(.75rem, 1.15vw, 1.1rem);
    position: relative;
    z-index: 0;
    min-width: 0;
    margin: 0;
    background: transparent;
    isolation: isolate;
  }

  .home-project-showcase__visual::before {
    position: absolute;
    z-index: -1;
    inset: 14% 9% 8%;
    border-radius: 40%;
    background: rgba(var(--project-rgb), .16);
    content: "";
    filter: blur(clamp(2rem, 4vw, 4.5rem));
    opacity: .52;
    pointer-events: none;
  }

  .home-project-showcase__visual--lead {
    grid-column: 6 / 12;
    grid-row: 1;
    width: 100%;
    max-width: 46rem;
    justify-self: end;
  }

  .home-project-showcase__visual--secondary {
    grid-column: 2 / 5;
    grid-row: 2;
    width: 100%;
    max-width: 22rem;
    margin-top: clamp(2.5rem, 4vw, 3.5rem);
  }

  .home-project-showcase__visual--tertiary {
    grid-column: 8 / 12;
    grid-row: 2;
    width: 100%;
    max-width: 31rem;
    justify-self: end;
  }

  .home-project-showcase__visual a {
    position: relative;
    display: block;
    overflow: hidden;
    padding: clamp(.28rem, .5vw, .45rem);
    border: 1px solid rgba(255, 255, 255, .14);
    border-radius: var(--visual-radius);
    background: rgba(238, 242, 237, .94);
    box-shadow: 0 1.2rem 3.5rem rgba(0, 0, 0, .24), inset 0 1px rgba(255, 255, 255, .38);
    backdrop-filter: blur(12px);
    transition: transform 420ms var(--ease), border-color 260ms ease, box-shadow 420ms var(--ease);
  }

  .home-project-showcase__visual a::after {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(145deg, rgba(255, 255, 255, .1), transparent 38%, rgba(7, 9, 8, .08));
    content: "";
    opacity: .62;
    pointer-events: none;
    transition: opacity 260ms ease;
  }

  .home-project-showcase__visual img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: calc(var(--visual-radius) - .35rem);
    filter: saturate(.88) contrast(.98);
    object-fit: contain;
    object-position: center;
    transition: filter 420ms ease;
  }

  .home-project-showcase__visual:hover a,
  .home-project-showcase__visual:focus-within a {
    border-color: rgba(var(--project-rgb), .44);
    box-shadow: 0 1.8rem 4.5rem rgba(0, 0, 0, .3), 0 0 0 1px rgba(var(--project-rgb), .08);
    transform: translateY(-.35rem);
  }

  .home-project-showcase__visual:hover a::after,
  .home-project-showcase__visual:focus-within a::after {
    opacity: .28;
  }

  .home-project-showcase__visual:hover img,
  .home-project-showcase__visual:focus-within img {
    filter: saturate(1) contrast(1.01);
  }

  .home-project-showcase__visual figcaption {
    display: flex;
    width: fit-content;
    max-width: calc(100% - .8rem);
    justify-content: space-between;
    gap: 1rem;
    margin: .65rem .4rem 0;
    padding: .45rem .65rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: rgba(18, 23, 22, .72);
    color: var(--paper-soft);
    font: 600 .58rem/1.3 var(--font-mono);
    letter-spacing: .1em;
    text-transform: uppercase;
    backdrop-filter: blur(10px);
  }

  .home-project-showcase__proof {
    grid-column: 5 / 7;
    grid-row: 2;
    min-width: 0;
    border-top: 1px solid var(--accent);
    border-bottom: 1px solid var(--line);
  }

  .home-project-showcase__proof > p {
    margin: 0;
    padding: .8rem 0;
    color: var(--paper-soft);
    font: 600 .6rem/1.4 var(--font-mono);
    letter-spacing: .12em;
    text-transform: uppercase;
  }

  .home-project-showcase__proof dl {
    margin: 0;
  }

  .home-project-showcase__proof dl > div {
    padding: 1rem 0 1.1rem;
    border-top: 1px solid var(--line);
  }

  .home-project-showcase__proof dt {
    color: var(--accent);
    font: 400 clamp(2rem, 3vw, 3.5rem)/.9 var(--font-serif);
    letter-spacing: -.04em;
  }

  .home-project-showcase__proof dd {
    margin: .5rem 0 0;
    color: var(--paper-soft);
    font-size: .72rem;
    line-height: 1.45;
  }

  .home-project-showcase__project[data-mirrored] .home-project-showcase__copy {
    grid-column: 9 / 13;
  }

  .home-project-showcase__project[data-mirrored] .home-project-showcase__visual--lead {
    grid-column: 2 / 8;
    justify-self: start;
  }

  .home-project-showcase__project[data-mirrored] .home-project-showcase__visual--secondary {
    grid-column: 9 / 12;
    justify-self: end;
  }

  .home-project-showcase__project[data-mirrored] .home-project-showcase__visual--tertiary {
    grid-column: 2 / 6;
    justify-self: start;
  }

  .home-project-showcase__project[data-mirrored] .home-project-showcase__proof {
    grid-column: 7 / 9;
  }

  @media (max-width: 900px) {
    .home-project-showcase__project {
      display: flex;
      flex-direction: column;
      gap: 1.35rem;
    }

    .home-project-showcase__project + .home-project-showcase__project {
      margin-top: 6rem;
      padding-top: 4.5rem;
    }

    .home-project-showcase__copy,
    .home-project-showcase__project[data-mirrored] .home-project-showcase__copy {
      order: 1;
      width: 100%;
      padding-top: 0;
    }

    .home-project-showcase__visual--lead {
      order: 2;
    }

    .home-project-showcase__proof,
    .home-project-showcase__project[data-mirrored] .home-project-showcase__proof {
      order: 3;
      width: 100%;
    }

    .home-project-showcase__visual--secondary {
      order: 4;
    }

    .home-project-showcase__visual--tertiary {
      order: 5;
    }

    .home-project-showcase__visual,
    .home-project-showcase__project[data-mirrored] .home-project-showcase__visual {
      margin-top: 0;
    }

    .home-project-showcase__visual--lead,
    .home-project-showcase__project[data-mirrored] .home-project-showcase__visual--lead {
      width: 92%;
      max-width: 42rem;
      align-self: flex-end;
    }

    .home-project-showcase__visual--secondary,
    .home-project-showcase__project[data-mirrored] .home-project-showcase__visual--secondary {
      width: 64%;
      max-width: 24rem;
      align-self: flex-start;
    }

    .home-project-showcase__visual--tertiary,
    .home-project-showcase__project[data-mirrored] .home-project-showcase__visual--tertiary {
      width: 78%;
      max-width: 32rem;
      align-self: flex-end;
    }

    .home-project-showcase__project[data-mirrored] .home-project-showcase__visual--secondary {
      align-self: flex-end;
    }

    .home-project-showcase__project[data-mirrored] .home-project-showcase__visual--tertiary {
      align-self: flex-start;
    }

    .home-project-showcase__proof dl {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .home-project-showcase__proof dl > div {
      padding-right: 1rem;
      border-right: 1px solid var(--line);
    }

    .home-project-showcase__proof dl > div + div {
      padding-left: 1rem;
    }

    .home-project-showcase__proof dl > div:last-child {
      padding-right: 0;
      border-right: 0;
    }
  }

  @media (max-width: 560px) {
    .home-project-showcase__copy h3 {
      font-size: clamp(3rem, 16vw, 4.6rem);
    }

    .home-project-showcase__actions,
    .home-project-showcase__link {
      width: 100%;
    }

    .home-project-showcase__proof dl {
      display: block;
    }

    .home-project-showcase__visual--lead,
    .home-project-showcase__project[data-mirrored] .home-project-showcase__visual--lead {
      width: 100%;
    }

    .home-project-showcase__visual--secondary,
    .home-project-showcase__project[data-mirrored] .home-project-showcase__visual--secondary {
      width: 78%;
    }

    .home-project-showcase__visual--tertiary,
    .home-project-showcase__project[data-mirrored] .home-project-showcase__visual--tertiary {
      width: 90%;
    }

    .home-project-showcase__proof dl > div,
    .home-project-showcase__proof dl > div + div {
      padding-inline: 0;
      border-right: 0;
    }

    .home-project-showcase__visual figcaption {
      font-size: .54rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-project-showcase__copy h3 a,
    .home-project-showcase__link,
    .home-project-showcase__visual a,
    .home-project-showcase__visual a::after,
    .home-project-showcase__visual img {
      transition: none;
    }

    .home-project-showcase__visual:hover a,
    .home-project-showcase__visual:focus-within a {
      transform: none;
    }
  }
</style>
