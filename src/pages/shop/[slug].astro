---
import { env } from "cloudflare:workers";
import NotFoundPage from "../../components/pages/NotFoundPage.astro";
import ProductPage from "../../components/pages/ProductPage.astro";
import UnavailablePage from "../../components/pages/UnavailablePage.astro";
import { type Locale } from "../../i18n/dictionaries";
import { resolveRequestLocale } from "../../i18n/locale-preference";
import { getPublicProductBySlug, listPublicProducts } from "../../lib/shop/repository";
import type { PublicProduct } from "../../lib/shop/types";
import { setPublicCache } from "../../lib/public-content";
import { createCatalogFilter, listCatalogRules, resolveMarket } from "../../lib/shop/market";
import { createPriceResolver, loadPriceBookContext } from "../../lib/shop/price-book";

export const prerender = false;
const shopLocale: Locale = resolveRequestLocale(Astro.request, Astro.locals.markets);
const slug = String(Astro.params.slug ?? "").trim();
if (shopLocale !== "vi") {
  return Astro.redirect(`/${shopLocale}/shop/${slug}${Astro.url.search}`, 302);
}
const selectedVariantId = Astro.url.searchParams.get("variant")?.trim() || null;
setPublicCache(Astro.response.headers);
// Prices now depend on the visitor's market, which is carried in a cookie. The
// page is cached at the edge, so without this the CDN can serve one market's
// prices to another market's visitor.
Astro.response.headers.set("Vary", "Cookie");
const db = env.CONTENT_DB;
let product: PublicProduct | null = null;
let relatedProducts: PublicProduct[] = [];
let unavailable = !db;
if (db && slug) {
  try {
    const market = Astro.locals.market?.market ?? resolveMarket({}).market;
    const priceResolver = createPriceResolver(
      await loadPriceBookContext(db, market.priceBookId, market.currency),
    );
    const catalogFilter = createCatalogFilter(
      market.catalogScope,
      await listCatalogRules(db, market.id),
    );
    product = await getPublicProductBySlug(db, slug, shopLocale, priceResolver, catalogFilter);
    if (product) {
      const catalog = await listPublicProducts(db, { locale: shopLocale, limit: 48, priceResolver, catalogFilter });
      relatedProducts = catalog
        .filter((item) => item.id !== product!.id)
        .filter((item) =>
          (product!.categorySlug && item.categorySlug === product!.categorySlug)
          || item.productType === product!.productType
          || item.featured,
        )
        .slice(0, 4);
      if (relatedProducts.length < 4) {
        const fill = catalog.filter((item) => item.id !== product!.id && !relatedProducts.some((r) => r.id === item.id)).slice(0, 4 - relatedProducts.length);
        relatedProducts = [...relatedProducts, ...fill];
      }
    }
  } catch {
    unavailable = true;
  }
}
if (unavailable) {
  Astro.response.status = 503;
  setPublicCache(Astro.response.headers, "unavailable");
} else if (!product) {
  Astro.response.status = 404;
  setPublicCache(Astro.response.headers, "not-found");
}
---
{unavailable ? <UnavailablePage locale={shopLocale} /> : product ? <ProductPage locale={shopLocale} product={product} selectedVariantId={selectedVariantId} relatedProducts={relatedProducts} /> : <NotFoundPage locale={shopLocale} />}
