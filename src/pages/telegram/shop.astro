          if (kicker && shop.welcomeKicker) kicker.textContent = String(shop.welcomeKicker).slice(0, 120);
          if (heading && shop.welcomeHeading) heading.textContent = String(shop.welcomeHeading).slice(0, 80);
          if (emphasis && shop.welcomeEmphasis) emphasis.textContent = String(shop.welcomeEmphasis).slice(0, 80);
          return;
        }
        // Auto welcome follows the live Telegram bot name and greets the user.
        if (kicker) {
          kicker.textContent = guest
            ? `${shopName} · Xin chào ${guest}`
            : `${shopName} · Hàng số chính hãng · Mua trong Telegram`;
        }
        if (heading) heading.textContent = guest ? `Xin chào ${guest}.` : "Chọn nhanh.";
        if (emphasis) emphasis.textContent = "Nhận ngay.";
      };
      const prefersReducedMotion = window.matchMedia?.("(prefers-reduced-motion: reduce)")?.matches || false;
      const motion = {
        play(element, keyframes, options = {}) {
          if (!element || prefersReducedMotion || typeof element.animate !== "function") return null;
          return element.animate(keyframes, { duration:220, easing:"cubic-bezier(.16,1,.3,1)", fill:"both", ...options });
        },
        reveal(selector, options = {}) {
          if (prefersReducedMotion) return;
          document.querySelectorAll(selector).forEach((element, index) => this.play(element, [
            { opacity:0, transform:"translateY(10px)" },
            { opacity:1, transform:"translateY(0)" },
          ], { delay:Math.min(index, 8) * 35, ...options }));
        },
        bump(selector) {
          const element = typeof selector === "string" ? $(selector) : selector;
          if (!element || prefersReducedMotion) return;
          element.classList.remove("is-bumping");
          requestAnimationFrame(() => element.classList.add("is-bumping"));
          setTimeout(() => element.classList.remove("is-bumping"), 420);
        },
      };
      const money = (minor, currency = displayCurrency) => new Intl.NumberFormat(currency === "USD" ? "en-US" : "vi-VN", { style:"currency", currency, maximumFractionDigits: currency === "VND" ? 0 : 2 }).format(Number(minor || 0) / (currency === "VND" ? 1 : 100));
      const escapeHtml = (value) => String(value ?? "").replace(/[&<>"']/g, (char) => ({"&":"&amp;","<":"&lt;",">":"&gt;","\"":"&quot;","'":"&#39;"}[char]));
      const image = (product) => product.media?.[0]?.url || "";
      const thumbnailUrl = (url) => {
        const value = String(url || "");
        const match = value.match(/^\/images\/(shop|blog)\/([^/?]+)\.webp(\?.*)?$/);
        if (!match) return value;
        const folder = match[1] === "shop" ? "shop/thumbs" : "telegram/thumbs";
        return `/images/${folder}/${match[2]}.avif${match[3] || ""}`;
      };
      const thumbnail = (product) => thumbnailUrl(image(product));
      const mediaSrcset = (product) => {
        const original = image(product);
        const thumb = thumbnail(product);
        return thumb && thumb !== original ? ` srcset="${escapeHtml(thumb)} 320w, ${escapeHtml(original)} 1600w" sizes="(max-width: 519px) 102px, 320px"` : "";
      };
      const explicitFeatured = products.filter((product) => product.featured);
      const featuredProducts = (explicitFeatured.length ? explicitFeatured : products.filter((product) => product.variants?.some((variant) => variant.availability !== "out_of_stock")).slice(0, 4)).slice(0, 6);
      const featuredIds = new Set(featuredProducts.map((product) => product.id));
      const productForVariant = (id) => products.find((product) => product.variants?.some((variant) => variant.id === id));
      const variantForId = (id) => productForVariant(id)?.variants.find((variant) => variant.id === id);
      const variantForSku = (sku) => products.flatMap((product) => product.variants || []).find((variant) => variant.sku === sku);
      const availableVariants = (product) => product.variants?.filter((variant) => variant.availability !== "out_of_stock") || [];
      const availabilityText = (variant) => variant?.availability === "unlimited" ? copy.available : variant?.availability === "out_of_stock" ? copy.outOfStock : `${copy.remaining} ${variant?.availableQuantity ?? ""} ${copy.items}`;
      const paymentStatusText = (status) => ({ paid:copy.paid, pending:copy.paymentPending, unpaid:copy.unpaid, failed:copy.failed, refunded:copy.refunded }[String(status || "").toLowerCase()] || String(status || copy.unknown));
      const fulfillmentStatusText = (status) => ({ awaiting_payment:copy.awaitingPayment, ready:copy.ready || copy.keyReady, partial:locale === "en" ? "Partially delivered" : "Đã giao một phần", delivered:copy.delivered, fulfilled:copy.delivered, manual:locale === "en" ? "Store is processing" : "Cửa hàng đang xử lý", pending:copy.processing, processing:copy.processing, unfulfilled:locale === "en" ? "Not delivered" : "Chưa giao", failed:locale === "en" ? "Delivery failed" : "Giao hàng lỗi", closed:locale === "en" ? "Order closed" : "Đơn đã đóng" }[String(status || "").toLowerCase()] || String(status || (locale === "en" ? "Not delivered" : "Chưa giao")));
      const statusClass = (status) => `status-${String(status || "unknown").toLowerCase().replace(/[^a-z0-9_-]/g, "-")}`;
      const orderDate = (value) => { const date = new Date(value); return Number.isNaN(date.getTime()) ? (locale === "en" ? "Just created" : "Vừa tạo") : date.toLocaleString(locale === "en" ? "en-US" : "vi-VN", { dateStyle:"medium", timeStyle:"short" }); };
      const orderPaymentStatus = (order) => String(order?.paymentStatus || order?.payment_status || order?.status || "unknown").toLowerCase();
      const orderFilterMatch = (order, filter) => {
        const status = orderPaymentStatus(order);
        if (filter === "paid") return status === "paid";
        if (filter === "pending") return ["pending", "unpaid", "processing"].includes(status);
        if (filter === "failed") return ["failed", "cancelled", "expired", "refunded"].includes(status);
        return true;
      };
      const orderProgressMarkup = (paymentStatus, fulfillmentStatus) => {
        const paid = paymentStatus === "paid";
        const delivered = ["delivered", "fulfilled", "partial", "ready", "manual"].includes(fulfillmentStatus);
        return `<div class="order-progress" aria-label="Tiến trình đơn hàng"><span class="order-progress-step ${paid ? "is-done" : ""}">Thanh toán</span><span class="order-progress-step ${delivered ? "is-done" : ""}">${delivered ? "Key sẵn sàng" : "Đang phát hành"}</span></div>`;
      };
      const paymentSteps = () => `<div class="payment-steps" aria-label="Tiến trình thanh toán"><div class="payment-step is-active"><b>1</b>Quét QR</div><div class="payment-step"><b>2</b>Xác nhận</div><div class="payment-step"><b>3</b>Nhận hàng</div></div>`;
      const paymentQr = (url) => url ? `<div class="payment-qr-frame"><img class="payment-qr" src="${escapeHtml(url)}" alt="Mã QR thanh toán" width="240" height="240"></div>` : "";
      const paymentPanel = (payment) => `<div class="payment-summary"><div><span class="payment-status">Đang chờ thanh toán</span><div class="payment-total">${money(payment.totalMinor, payment.currency)}</div></div><span class="order-number">#${escapeHtml(payment.number)}</span></div>${paymentSteps()}${paymentQr(payment.qrUrl)}<p class="notice">Quét đúng số tiền <strong>${money(payment.totalMinor, payment.currency)}</strong>. Trạng thái tự cập nhật; có thể đóng cửa sổ và mở lại từ thanh nhắc đơn.</p>${payment.checkoutUrl ? `<button class="primary" id="open-payment">Mở trang thanh toán</button>` : ""}<button class="secondary" id="check-payment">Tôi đã thanh toán</button>`;
      const CART_STORAGE_MAX_BYTES = 64_000;
      const PAYMENT_STORAGE_MAX_BYTES = 8_000;
      const PENDING_PAYMENT_MAX_AGE_MS = 48 * 60 * 60 * 1_000;
      const safeStorageRead = (storage, key, maxBytes) => {
        try {
          const raw = storage.getItem(key);
          return typeof raw === "string" && raw.length <= maxBytes ? raw : null;
        } catch { return null; }
      };
      const safeStorageWrite = (storage, key, value) => {
        try { storage.setItem(key, value); return true; } catch { return false; }
      };
      const safeStorageRemove = (storage, key) => { try { storage.removeItem(key); } catch { /* private mode/quota */ } };
      const safeHttpsUrl = (value) => {
        if (typeof value !== "string" || value.length < 1 || value.length > 2_048) return "";
        try {
          const parsed = new URL(value);
          return parsed.protocol === "https:" && !parsed.username && !parsed.password && !parsed.hash ? parsed.toString() : "";
        } catch { return ""; }
      };
      const readCart = () => {
        const raw = safeStorageRead(localStorage, cartKey, CART_STORAGE_MAX_BYTES);
        if (!raw) return [];
        try {
          const parsed = JSON.parse(raw);
          if (!Array.isArray(parsed)) return [];
          return parsed.slice(0, 20).flatMap((item) => {
            if (!item || typeof item !== "object" || !/^[A-Za-z0-9-]{8,80}$/.test(String(item.variantId || ""))) return [];
            const quantity = Number(item.quantity);
            return Number.isSafeInteger(quantity) && quantity >= 1 && quantity <= 1_000
              ? [{ variantId: String(item.variantId), quantity }]
              : [];
          });
        } catch { return []; }
      };
      const writeCart = () => { safeStorageWrite(localStorage, cartKey, JSON.stringify(state.cart.slice(0, 20).map(({ variantId, quantity }) => ({ variantId, quantity })))); };
      const readDiscountCode = () => {
        const value = safeStorageRead(localStorage, discountKey, 128) || "";
        return /^[A-Z0-9][A-Z0-9_-]{1,99}$/.test(value) ? value : "";
      };
      const writeDiscountCode = () => { if (state.discountCode) safeStorageWrite(localStorage, discountKey, state.discountCode); else safeStorageRemove(localStorage, discountKey); };
      const readPendingPayment = () => {
        const raw = safeStorageRead(localStorage, pendingPaymentKey, PAYMENT_STORAGE_MAX_BYTES);
        if (!raw) return null;
        try {
          const value = JSON.parse(raw);
          const savedAt = Number(value?.savedAt || 0);
          if (!value || typeof value !== "object" || !/^[A-Za-z0-9-]{8,80}$/.test(String(value.orderId || "")) || (savedAt > 0 && Date.now() - savedAt > PENDING_PAYMENT_MAX_AGE_MS)) {
            safeStorageRemove(localStorage, pendingPaymentKey);
            return null;
          }
          const totalMinor = Number(value.totalMinor);
          const currency = typeof value.currency === "string" && /^[A-Z]{3,5}$/.test(value.currency) ? value.currency : "VND";
          return {
            orderId: String(value.orderId),
            number: typeof value.number === "string" ? value.number.slice(0, 80) : "",
            totalMinor: Number.isSafeInteger(totalMinor) && totalMinor >= 0 ? totalMinor : 0,
            currency,
            qrUrl: safeHttpsUrl(value.qrUrl),
            checkoutUrl: safeHttpsUrl(value.checkoutUrl),
            savedAt: savedAt || Date.now(),
          };
        } catch { return null; }
      };
      const writePendingPayment = () => {
        if (!state.pendingPayment) { safeStorageRemove(localStorage, pendingPaymentKey); return; }
        const value = { ...state.pendingPayment, savedAt: Date.now() };
        safeStorageWrite(localStorage, pendingPaymentKey, JSON.stringify(value));
      };
      function bindLocalIdentity(userId) {
        const nextIdentity = String(userId || "guest");
        if (nextIdentity === telegramIdentity) return false;
        telegramIdentity = nextIdentity;
        cartKey = `tung:telegram-mini-cart:v2:${telegramIdentity}`;
        pendingPaymentKey = `tung:telegram-mini-pending:v1:${telegramIdentity}`;
        discountKey = `tung:telegram-mini-discount:v1:${telegramIdentity}`;
        state.cart = readCart();
        state.pendingPayment = readPendingPayment();
        state.discountCode = readDiscountCode();
        state.discountDraft = state.discountCode;
        state.discountQuote = null;
        state.discountQuoteFingerprint = "";
        state.discountError = "";
        ordersLoadedAt = 0;
        orderDetailCache.clear();
        reconcileCart();
        renderCart();
        syncPendingPaymentBanner();
        return true;
      }
      let toastTimer = 0;
      const toast = (message) => { const node = $("#toast"); node.textContent = message; node.classList.remove("is-visible"); requestAnimationFrame(() => node.classList.add("is-visible")); clearTimeout(toastTimer); toastTimer = window.setTimeout(() => node.classList.remove("is-visible"), 2600); };
      const haptic = () => { if (telegramSupports("6.1")) tg.HapticFeedback?.impactOccurred("light"); };
      function syncPendingPaymentBanner() {
        const banner = $("#pending-payment-banner");
        if (!banner) return;
        banner.hidden = !state.pendingPayment?.orderId;
        if (state.pendingPayment?.orderId) $("#pending-payment-label").textContent = `${copy.order} #${state.pendingPayment.number} · ${money(state.pendingPayment.totalMinor, state.pendingPayment.currency)}`;
      }
      function productAction(product, className = "product-action") {
        const variants = availableVariants(product);
        if (!variants.length) return `<button class="${className}" disabled>${copy.outOfStock}</button>`;
        const label = product.variants.length > 1
          ? (locale === "en" ? "Choose plan" : "Chọn gói")
          : (locale === "en" ? "Buy" : "Mua");
        return `<button class="${className}" data-open-product="${escapeHtml(product.slug)}" type="button">${label}</button>`;
      }
