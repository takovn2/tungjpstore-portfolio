---
import { env } from "cloudflare:workers";
import { serializeMiniCatalog } from "../../lib/shop/product-view";
import { listPublicProducts } from "../../lib/shop/repository";
import {
  resolveVietnamMiniShopBranding,
  vietnamMiniShopBrandingFallback,
} from "../../lib/shop/telegram-mini-branding";
import { getTelegramMiniAppEnabledSetting } from "../../lib/shop/telegram";

export const prerender = false;
// Check if Mini App is enabled. If disabled, block rendering immediately.
const miniAppEnabled = env.TELEGRAM_MINI_APP_ENABLED === "1" || env.TELEGRAM_MINI_APP_ENABLED === "true" || (env.CONTENT_DB ? await getTelegramMiniAppEnabledSetting(env.CONTENT_DB) : false);
if (!miniAppEnabled) {
  return new Response(
    `<!doctype html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Mini App đã tắt</title>
  <style>
    body { font-family: system-ui, -apple-system, sans-serif; display: grid; place-items: center; min-height: 100vh; margin: 0; background: #f8fafc; color: #0f172a; text-align: center; padding: 1.5rem; }
    .card { background: #ffffff; padding: 2rem; border-radius: 1rem; max-width: 400px; border: 1px solid #e2e8f0; box-shadow: 0 10px 25px -5px rgba(0,0,0,0.05); }
    h1 { font-size: 1.2rem; margin-bottom: 0.75rem; color: #e11d48; }
    p { font-size: 0.95rem; color: #64748b; line-height: 1.5; margin-bottom: 1.5rem; }
    .btn { display: inline-block; background: #0f172a; color: #fff; text-decoration: none; padding: 0.75rem 1.5rem; border-radius: 0.5rem; font-weight: 600; font-size: 0.9rem; border: none; cursor: pointer; }
  </style>
</head>
<body>
  <div class="card">
    <h1>⚠️ Mini App Hiện Đang Tắt</h1>
    <p>Giao diện Mini App đã được tạm tắt để dùng luồng Chat Bot truyền thống. Vui lòng quay lại chat để đặt hàng.</p>
    <button onclick="if(window.Telegram?.WebApp){window.Telegram.WebApp.close();}" class="btn">Đóng cửa sổ</button>
  </div>
</body>
</html>`,
    { headers: { "Content-Type": "text/html; charset=utf-8" } }
  );
}

// This page bootstraps an identity-bound Telegram session; never let an edge
// cache serve stale Mini App JavaScript after a rollout.
Astro.response.headers.set("Cache-Control", "private, no-store, max-age=0");
Astro.response.headers.set("Cloudflare-CDN-Cache-Control", "no-store, max-age=0");
Astro.response.headers.set("CDN-Cache-Control", "no-store, max-age=0");
Astro.response.headers.set("Pragma", "no-cache");
Astro.response.headers.set("Expires", "0");
// This is the Vietnam bot surface. Keep it deliberately stable while a
// separate global bot/app is developed, so Telegram users always see VND and
// the PayOS checkout contract.
const miniLocale = "vi" as "vi" | "en" | "ja" | "zh";
const miniCurrency = "VND" as "VND" | "USD";
// Prefer live Telegram bot identity (getMe, cached). Fall back to username /
// env overrides when Telegram is unreachable so SSR never hardcodes a brand.
const shopBranding = await resolveVietnamMiniShopBranding(env, "environment").catch(() => vietnamMiniShopBrandingFallback(env));
const miniCopy = miniLocale === "en" ? {
  identityPending: "Verifying Telegram…", pendingOrder: "Payment pending", resumePayment: "Continue payment", reopen: "Open again",
  telegramConnection: "Telegram connection", sessionNotVerified: "Session not verified", sessionRetry: "Keep the Mini App open and try again in a few seconds.", retry: "Try again",
  heroKicker: shopBranding.welcomeKicker, heroFirst: shopBranding.welcomeHeading, heroSecond: shopBranding.welcomeEmphasis, featuredCta: "See picks", verifying: "Verifying Telegram",
  storePromise: "Store promise", safePayment: "Secure payment", instantDelivery: "Instant key delivery", orderTracking: "24/7 order tracking",
  featuredHeading: "Today's picks", featuredCaption: "Curated for quick checkout", allProducts: "All products",
  searchPlaceholder: "Search ChatGPT, Canva, Netflix…", searchLabel: "Search products", cart: "Cart", orders: "Orders", orderSync: "Synced to Telegram ID",
  refreshOrders: "Refresh orders", checkoutCount: "0 items · Crypto / card", checkout: "Checkout", shop: "Shop", close: "Close",
} : {
  identityPending: "Đang xác minh…", pendingOrder: "Đơn đang chờ", resumePayment: "Tiếp tục thanh toán", reopen: "Mở lại",
  telegramConnection: "Kết nối Telegram", sessionNotVerified: "Chưa xác minh được phiên", sessionRetry: "Giữ Mini App mở và thử lại sau ít giây.", retry: "Thử lại",
  heroKicker: shopBranding.welcomeKicker, heroFirst: shopBranding.welcomeHeading, heroSecond: shopBranding.welcomeEmphasis, featuredCta: "Xem gợi ý", verifying: "Đang xác minh Telegram",
  storePromise: "Cam kết cửa hàng", safePayment: "Thanh toán an toàn", instantDelivery: "Giao key tức thì", orderTracking: "Theo dõi đơn 24/7",
  featuredHeading: "Gợi ý hôm nay", featuredCaption: "Chọn lọc để mua nhanh", allProducts: "Tất cả sản phẩm",
  searchPlaceholder: "Tìm ChatGPT, Canva, Netflix…", searchLabel: "Tìm sản phẩm", cart: "Giỏ hàng", orders: "Đơn hàng", orderSync: "Đồng bộ theo Telegram ID",
  refreshOrders: "Làm mới đơn hàng", checkoutCount: "0 sản phẩm · VietQR", checkout: "Thanh toán", shop: "Shop", close: "Đóng",
};
const products = env.CONTENT_DB ? await listPublicProducts(env.CONTENT_DB, { locale: miniLocale, limit: 48 }) : [];
const serializedProducts = serializeMiniCatalog(products);
const pageTitle = `${shopBranding.shopName} · Telegram`;
---

<!doctype html>
<html lang={miniLocale} data-currency={miniCurrency}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="color-scheme" content="dark light" />
    <meta name="robots" content="noindex,nofollow" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300..800&display=swap" rel="stylesheet" />
    <link rel="preconnect" href="https://telegram.org" />
    <link rel="preconnect" href="https://media.tung.codes" crossorigin />
    <title>{pageTitle}</title>
    <!-- Load the Telegram bridge synchronously. Astro turns normal external scripts into deferred modules, which would run after the inline app boot and leave initData empty. -->
    <script is:inline src="https://telegram.org/js/telegram-web-app.js"></script>
<style is:global>

      /* ══════════════════════════════════════════════════════════════
         TUNG Shop · Telegram Mini App
         Design System v7 — Porcelain White (unified with web shop)
         ══════════════════════════════════════════════════════════════ */

      /* ── Design Tokens ─────────────────────────────────────────── */
      :root {
        --shop-bg: #ffffff;
        --shop-bg-soft: #f6f7f9;
        --shop-surface: #ffffff;
        --shop-surface-alt: #fafbfc;
        --shop-ink: #0b0f1a;
        --shop-ink-soft: #4b5565;
        --shop-ink-muted: #9aa3b2;
        --shop-accent: #0b0f1a;
        --shop-accent-hover: #252e42;
        --shop-accent-ink: #ffffff;
        --shop-mint: #0da678;
        --shop-mint-soft: #e8f8f1;
        --shop-sun: #e8930c;
        --shop-sun-soft: #fdf4e3;
        --shop-danger: #e0483f;
        --shop-danger-soft: #fdeeed;
        --ink: var(--shop-bg);
        --ink-soft: var(--shop-bg-soft);
        --surface: var(--shop-surface);
        --paper: var(--shop-ink);
        --paper-soft: var(--shop-ink-soft);
        --line: #e9ecf1;
        --line-strong: #d4dae3;
        --accent: var(--shop-accent);
        --accent-ink: #ffffff;
        --danger: var(--shop-danger);
        --danger-text: #b03830;
        --card: var(--shop-surface);
        --card-shadow: 0 1px 2px rgba(16, 24, 40, 0.04), 0 8px 24px -8px rgba(16, 24, 40, 0.08);
        --nav: rgba(255, 255, 255, 0.94);
        --notice: var(--shop-bg-soft);
        --cta-primary: var(--shop-ink);
        --cta-primary-press: var(--shop-accent-hover);
        --cta-primary-ink: #ffffff;
        --cta-secondary-bg: #ffffff;
        --cta-secondary-ink: var(--shop-ink);
        --cta-secondary-line: var(--line-strong);
        --cta-shadow: 0 1px 2px rgba(11, 15, 26, 0.2), 0 10px 24px -10px rgba(11, 15, 26, 0.32);
        --font-sans: "Plus Jakarta Sans", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", sans-serif;
        --font-serif: "Plus Jakarta Sans", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", sans-serif;
        --font-mono: "SFMono-Regular", Menlo, Consolas, monospace;
        --ease: cubic-bezier(0.16, 1, 0.3, 1);
        --ease-spring: cubic-bezier(0.3, 1.4, 0.4, 1);
        color-scheme: light;
      }

      /* ── Reset & Base ──────────────────────────────────────────── */
      * { box-sizing:border-box; }
      html,body {
        margin:0; min-height:100%;
        background-color:var(--shop-bg);
        color:var(--paper);
        font-family:var(--font-sans);
        -webkit-font-smoothing:antialiased;
      }
      body {
        padding:env(safe-area-inset-top) 12px calc(88px + env(safe-area-inset-bottom));
        background-image:radial-gradient(72% 30% at 50% -40px, rgba(59, 130, 246, 0.045), transparent 72%);
        background-repeat:no-repeat;
      }
      body.cart-dock-visible { padding-bottom:calc(168px + env(safe-area-inset-bottom)); }
      body.modal-open { overflow:hidden; }
      button,input,select { font:inherit; }
      button { color:inherit; cursor:pointer; touch-action:manipulation; -webkit-tap-highlight-color:transparent; }
      button:focus-visible,input:focus-visible,select:focus-visible { outline:2px solid var(--accent); outline-offset:2px; }
      img { display:block; }
      .app { width:100%; max-width:760px; margin:0 auto; }
      .shell { width:100%; max-width:860px; margin:0 auto; }

      /* ── Topbar ─────────────────────────────────────────────────── */
      .topbar {
        display:flex; align-items:center; justify-content:space-between;
        margin-bottom:12px; padding:10px 12px;
        border:1px solid var(--line); border-radius:0.95rem;
        background:var(--surface);
        box-shadow:0 1px 2px rgba(16,24,40,0.03);
      }
      .brand { display:flex; align-items:center; gap:10px; min-width:0; font:700 14px/1 var(--font-sans); letter-spacing:-0.01em; color:var(--paper); }
      #shop-brand-name {
        min-width:0; max-width:11rem; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;
        text-transform:none; letter-spacing:0.01em;
      }
      .brand-mark {
        display:grid; place-items:center; width:28px; height:28px;
        background:linear-gradient(160deg, #1c2536, var(--shop-ink)); color:#fff; border-radius:8px;
        font:800 14px/1 var(--font-sans);
        box-shadow:0 2px 6px -1px rgba(11,15,26,0.3), inset 0 1px 0 rgba(255,255,255,0.14);
      }
      .identity { display:flex; align-items:center; gap:10px; text-align:right; }
      .identity span { display:grid; }
      .identity strong, .identity-copy b { font:700 13px/1 var(--font-sans); color:var(--paper); }
      .identity small, .identity-copy small { font:600 10px/1 var(--font-mono); color:var(--shop-ink-muted); text-transform:uppercase; margin-top:3px; letter-spacing:.06em; }
      .identity .avatar {
        display:grid; place-items:center; width:34px; height:34px;
        border-radius:50%; background:var(--notice); border:1px solid var(--line);
        color:var(--paper); font:700 13px/1 var(--font-sans);
      }

      /* ── Hero ───────────────────────────────────────────────────── */
      .hero {
        position:relative; overflow:hidden;
        padding:16px 14px 14px; border:1px solid var(--line); border-radius:1.1rem;
        background:
          radial-gradient(80% 120% at 85% -20%, rgba(59,130,246,0.05), transparent 70%),
          radial-gradient(60% 100% at 10% 120%, rgba(13,166,120,0.05), transparent 70%),
          var(--surface);
        text-align:left; margin-bottom:4px;
        box-shadow:0 1px 2px rgba(16,24,40,0.03);
      }
      .hero-kicker, .kicker {
        display:inline-flex; align-items:center; gap:6px;
        font:700 10px/1 var(--font-sans); letter-spacing:.05em;
        text-transform:uppercase; color:var(--paper-soft); margin-bottom:8px;
        padding:5px 10px; border:1px solid var(--line); border-radius:999px;
        background:var(--shop-surface-alt);
      }
      .hero h1 { margin:0 0 10px; font:800 clamp(1.3rem, 5.5vw, 1.65rem)/1.15 var(--font-sans); letter-spacing:-0.03em; color:var(--paper); }
      .hero h1 em { font-style:normal; color:var(--paper); background:linear-gradient(120deg, var(--shop-mint), #3b82f6); -webkit-background-clip:text; background-clip:text; -webkit-text-fill-color:transparent; }
      .hero p { margin:0 auto 16px; max-width:480px; color:var(--paper-soft); font:13px/1.6 var(--font-sans); }
      .hero-foot { display:flex; flex-direction:row; align-items:center; justify-content:space-between; gap:10px; width:100%; }
      .hero-signal, .signal { display:flex; align-items:center; gap:8px; color:var(--paper-soft); font:700 10px/1 var(--font-mono); letter-spacing:.06em; text-transform:uppercase; }
      .hero-signal:before, .signal:before { width:8px; height:8px; border-radius:50%; background:var(--shop-mint); box-shadow:0 0 0 4px rgba(13,166,120,0.14); content:""; flex:0 0 auto; }
      body[data-session-state="pending"] .hero-signal:before, body[data-session="pending"] .signal:before { background:var(--shop-sun); box-shadow:0 0 0 4px rgba(232,147,12,0.14); }
      body[data-session-state="error"] .hero-signal:before, body[data-session="error"] .signal:before { background:var(--danger); box-shadow:0 0 0 4px rgba(224,72,63,0.15); }

      /* ── Trust Strip ────────────────────────────────────────────── */
      .trust-strip { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:6px; margin:10px 0 0; }
      .trust-strip div {
        display:flex; min-width:0; min-height:40px; align-items:center; gap:6px;
        border:1px solid var(--line); border-radius:0.6rem;
        background:var(--surface); padding:6px 8px;
        font:650 10px/1.2 var(--font-sans); color:var(--paper-soft);
        box-shadow:0 1px 2px rgba(16,24,40,0.02);
      }
      .trust-strip b {
        display:grid; width:20px; height:20px; place-items:center; border-radius:50%;
        background:var(--shop-mint-soft); color:var(--shop-mint); font-size:10px; font-weight:800; flex:0 0 auto;
      }
      .trust-strip span { line-height:1.15; }

      /* ── Banners & Errors ───────────────────────────────────────── */
      .pending-banner, .session-error, .session-error-banner {
        display:grid; grid-template-columns:minmax(0,1fr) auto; gap:12px; align-items:center;
        margin-top:12px; border-radius:0.9rem; padding:14px;
      }
      .pending-banner { border:1px solid rgba(232,147,12,.32); background:var(--shop-sun-soft); }
      .session-error, .session-error-banner { border:1px solid rgba(224,72,63,.28); background:var(--shop-danger-soft); }
      .pending-banner[hidden], .session-error[hidden], .session-error-banner[hidden] { display:none; }
      .pending-banner span, .session-error-banner span, .session-error span { display:block; font:700 10px/1 var(--font-mono); letter-spacing:.08em; text-transform:uppercase; }
      .pending-banner span { color:#a06a08; }
      .session-error-banner span, .session-error span { color:var(--danger-text); }
      .pending-banner strong, .session-error-banner strong, .session-error strong { display:block; margin-top:4px; font:700 1.05rem/1.2 var(--font-sans); letter-spacing:-0.01em; color:var(--paper); }
      .session-error-banner p, .session-error p { margin:4px 0 0; color:var(--paper-soft); font-size:.76rem; line-height:1.4; }
      .pending-banner button, .session-error-banner button, .session-error button { min-height:40px; border-radius:.6rem; padding:0 14px; font:650 11px/1 var(--font-sans); transition:background .18s; }
      .pending-banner button { border:1px solid #e5a23c; background:transparent; color:#a06a08; }
      .pending-banner button:active { background:rgba(232,147,12,.12); }
      .session-error-banner button, .session-error button { border:1px solid var(--danger); background:var(--danger); color:#fff; }

      /* ── View Layout ────────────────────────────────────────────── */
      .view { display:none; padding-bottom:32px; }
      .view.is-active { display:block; animation:viewIn .35s var(--ease) both; }
      @keyframes viewIn { from { opacity:0; transform:translateY(14px); } to { opacity:1; transform:none; } }

      .section-head, .toolbar { display:flex; align-items:flex-end; justify-content:space-between; gap:12px; margin:22px 0 14px; }
      .section-head h2, .toolbar h2 { margin:0; font:800 clamp(1.15rem, 4.5vw, 1.4rem)/1.15 var(--font-sans); letter-spacing:-0.03em; color:var(--paper); }
      .section-head > span, .toolbar p { color:var(--paper-soft); font-size:12px; font-weight:600; padding-bottom:4px; margin:0; }
      .section-head-copy h2 { margin:0 0 4px; }
      .section-head-copy span { color:var(--paper-soft); font:650 10px/1 var(--font-mono); letter-spacing:.06em; text-transform:uppercase; }
      .title-button {
        min-height:38px; padding:0 13px; border:1px solid var(--line-strong); border-radius:999px;
        background:var(--surface); color:var(--paper);
        font:650 11.5px/1 var(--font-sans); white-space:nowrap;
        transition:transform .15s ease, border-color .15s ease, background .15s ease;
      }
      .title-button:active { transform:scale(.96); background:var(--shop-surface-alt); border-color:#b9c2d0; }
      .section-action {
        display:grid; place-items:center; width:42px; height:42px;
        border:1px solid var(--line); border-radius:.7rem;
        background:var(--surface); color:var(--paper); transition:transform .2s;
      }
      .section-action:active { transform:scale(.92); }
      .section-action svg { width:18px; height:18px; fill:none; stroke:currentColor; stroke-width:2; stroke-linecap:round; stroke-linejoin:round; }

      /* ── Featured Rail ──────────────────────────────────────────── */
      .featured-rail { display:flex; overflow-x:auto; scroll-snap-type:x mandatory; gap:12px; padding-bottom:12px; margin:0 -12px; scroll-padding-left:12px; }
      .featured-rail::-webkit-scrollbar { display:none; }
      .featured-rail::before { content:""; flex:0 0 1px; }
      .featured-rail::after { content:""; flex:0 0 1px; }
      .featured-card {
        scroll-snap-align:start; display:grid; grid-template-rows:minmax(200px, 52vw) 1fr;
        flex:0 0 min(280px,80vw); min-width:0;
        border:1px solid var(--line); border-radius:1rem;
        background:var(--surface); overflow:hidden;
        box-shadow:0 1px 2px rgba(16,24,40,0.03);
        transition:transform .18s var(--ease), box-shadow .18s var(--ease);
      }
      .featured-card:active { transform:scale(0.985); }
      .featured-media, .product-media { position:relative; background:var(--shop-bg-soft); overflow:hidden; display:flex; align-items:center; justify-content:center; min-height:0; padding:0; }
      .featured-media img, .product-media img { width:100%; height:100%; object-fit:cover; object-position:center; }
      .media-placeholder, .placeholder { width:100%; height:100%; display:grid; place-items:center; font:800 1.5rem/1 var(--font-sans); color:var(--shop-ink-muted); }
      .featured-rank {
        position:absolute; top:10px; right:10px; display:grid; width:26px; height:26px; place-items:center;
        border-radius:50%; background:rgba(255,255,255,.86); backdrop-filter:blur(8px);
        color:var(--paper); font:800 11px/1 var(--font-mono); border:1px solid var(--line);
      }
      .featured-body, .product-body { padding:12px; display:flex; flex-direction:column; gap:4px; }
      .featured-body h3, .product-body h3 { margin:0; font:700 15px/1.2 var(--font-sans); letter-spacing:-0.015em; color:var(--paper); }
      .product-body h3 { font-size:14px; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; }
      .featured-copy, .product-desc, .product-body p {
        margin:0; color:var(--paper-soft); font-size:11.5px; line-height:1.4;
        display:-webkit-box; -webkit-line-clamp:1; -webkit-box-orient:vertical; overflow:hidden; min-height:0;
      }
      .featured-foot, .product-foot { margin-top:auto; padding-top:10px; display:flex; align-items:center; justify-content:space-between; gap:8px; }
      .featured-price, .price { display:grid; gap:3px; font:800 15px/1.05 var(--font-sans); letter-spacing:-0.02em; color:var(--paper); }
      .featured-price small, .price small { color:var(--shop-mint); font:650 9px/1 var(--font-mono); letter-spacing:.04em; text-transform:uppercase; }
      .price del { display:block; color:var(--paper-soft); font-size:10px; font-weight:700; text-decoration:line-through; }

      /* ── Catalog Tools ──────────────────────────────────────────── */
      .catalog-tools { margin-bottom:16px; display:grid; gap:10px; }
      .search {
        display:flex; align-items:center; gap:10px; min-height:46px;
        padding:0 16px; border:1px solid var(--line-strong); border-radius:999px;
        background:var(--surface); color:var(--paper-soft);
        box-shadow:0 1px 2px rgba(16,24,40,0.03);
        transition:border-color .2s, box-shadow .2s;
      }
      .search:focus-within { border-color:var(--paper); box-shadow:0 0 0 4px rgba(11,15,26,0.07); }
      .search input { width:100%; min-width:0; border:0; outline:0; background:transparent; color:var(--paper); font:14.5px/1 var(--font-sans); }
      .search input::placeholder { color:var(--shop-ink-muted); }
      .filters { display:flex; flex-wrap:wrap; gap:8px; }
      .filters button {
        min-height:34px; padding:0 14px; border:1px solid var(--line);
        border-radius:999px; background:var(--surface); color:var(--paper-soft);
        font:650 11.5px/1 var(--font-sans); letter-spacing:0;
        transition:all .2s;
      }
      .filters button.is-active { border-color:var(--paper); background:var(--paper); color:#fff; box-shadow:0 2px 8px rgba(11,15,26,0.22); }

      /* ── Grid & Products ────────────────────────────────────────── */
      .grid { display:grid; grid-template-columns:1fr; gap:12px; }
      .catalog, .grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:12px; }
      .product {
        display:grid; grid-template-rows:minmax(168px, 42vw) 1fr;
        border:1px solid var(--line); border-radius:1rem;
        background:var(--surface); overflow:hidden;
        box-shadow:0 1px 2px rgba(16,24,40,0.03);
        animation:productUp .4s var(--ease) both;
        transition:transform .18s var(--ease), box-shadow .18s var(--ease);
      }
      @media (min-width:400px) { .product { grid-template-rows:minmax(188px, 44vw) 1fr; } }
      .product:nth-child(2) { animation-delay:.04s; }
      .product:nth-child(3) { animation-delay:.08s; }
      .product:nth-child(4) { animation-delay:.12s; }
      @keyframes productUp { from { opacity:0; transform:translateY(18px) scale(.98); } to { opacity:1; transform:none; } }
      .product:active { transform:scale(0.985); }
      .product-body small, .product-eyebrow { color:var(--shop-ink-muted); font:650 9.5px/1 var(--font-mono); text-transform:uppercase; letter-spacing:.05em; }
      .product-tag {
        display:inline-flex; align-items:center; min-height:20px; padding:0 8px;
        border-radius:999px; background:var(--shop-bg-soft); color:var(--paper-soft);
        font:650 9.5px/1 var(--font-sans);
      }
      .badge, .product-badge {
        display:inline-flex; align-items:center; gap:4px; min-height:20px; padding:0 8px;
        border-radius:999px; background:var(--shop-bg-soft); color:var(--paper-soft);
        font:700 9.5px/1 var(--font-sans); letter-spacing:0.01em;
      }
      .product select { margin-top:12px; width:100%; min-height:36px; border:1px solid var(--line-strong); border-radius:.6rem; background:var(--shop-surface-alt); color:var(--paper); font-size:12px; padding:0 8px; }

      /* ── Bottom Nav ─────────────────────────────────────────────── */
      .bottom-nav { position:fixed; z-index:20; right:12px; bottom:calc(12px + env(safe-area-inset-bottom)); left:12px; pointer-events:none; }
      .bottom-nav-inner {
        display:flex; max-width:400px; margin:auto;
        border:1px solid var(--line); border-radius:999px;
        background:var(--nav); padding:6px;
        backdrop-filter:blur(20px) saturate(1.3); box-shadow:0 4px 12px rgba(16,24,40,0.06), 0 16px 40px -12px rgba(16,24,40,0.22);
        pointer-events:auto;
      }
      .nav-button {
        flex:1; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:4px;
        min-height:54px; border-radius:999px; color:var(--paper-soft); font:650 9.5px/1 var(--font-sans); text-transform:uppercase; letter-spacing:.04em; transition:all .2s;
      }
      .nav-button svg { width:22px; height:22px; fill:none; stroke:currentColor; stroke-width:2.2; stroke-linecap:round; stroke-linejoin:round; }
      .nav-button.is-active { background:var(--paper); color:#fff; box-shadow:0 4px 12px rgba(11,15,26,0.28); }
      .nav-button:active { transform:scale(.92); }
      .cart-count { display:inline-flex; min-width:18px; height:18px; align-items:center; justify-content:center; border-radius:999px; background:var(--shop-mint); color:#fff; font:700 10px/1 var(--font-sans); margin-left:4px; }
      .nav-button.is-active .cart-count { background:#fff; color:var(--paper); }

      /* ── Checkout / Cart Dock ───────────────────────────────────── */
      .checkout-dock, #checkout-dock, .checkout-bar, .cart-dock {
        position:fixed; z-index:15; right:12px; left:12px;
        bottom:calc(72px + env(safe-area-inset-bottom));
        display:flex; align-items:center; justify-content:space-between; gap:12px;
        padding:12px 14px;
        border:1px solid var(--line); border-radius:1.15rem;
        background:rgba(255,255,255,0.96);
        backdrop-filter:blur(18px) saturate(1.15);
        box-shadow:0 2px 6px rgba(16,24,40,0.05), 0 20px 48px -16px rgba(16,24,40,0.24);
        animation:dockUp .35s var(--ease-spring) both;
      }
      @keyframes dockUp { from { transform:translateY(100%); } to { transform:none; } }
      .checkout-dock[hidden], #checkout-dock[hidden], .checkout-bar[hidden], .cart-dock[hidden] { display:none !important; }
      .checkout-dock > div, .checkout-bar > div, .cart-dock > div { min-width:0; display:grid; gap:3px; }
      .checkout-dock span, #checkout-dock-count, .checkout-bar small, .cart-dock-info small { display:block; color:var(--paper-soft); font:650 11px/1.2 var(--font-sans); }
      .checkout-label { color:var(--paper-soft); font:650 11px/1.2 var(--font-sans); }
      .checkout-dock strong, #checkout-dock-total, .checkout-bar strong, .cart-dock-info strong { font:800 19px/1.1 var(--font-sans); color:var(--paper); letter-spacing:-0.02em; }

      /* ── Cart View ──────────────────────────────────────────────── */
      .cart-panel, .orders-panel { display:grid; gap:12px; }
      .cart-list { display:grid; gap:12px; }
      .cart-row { display:grid; grid-template-columns:56px minmax(0,1fr); gap:12px; align-items:start; border:1px solid var(--line); border-radius:1rem; background:var(--surface); padding:12px; box-shadow:0 1px 2px rgba(16,24,40,0.03); }
      .cart-thumb { width:56px; height:56px; border-radius:.7rem; border:1px solid var(--line); background:var(--shop-bg-soft); overflow:hidden; }
      .cart-thumb img { width:100%; height:100%; object-fit:cover; display:block; }
      .cart-thumb .media-placeholder { width:100%; height:100%; display:grid; place-items:center; font:800 1.1rem/1 var(--font-sans); color:var(--shop-ink-muted); }
      .cart-row strong { display:block; font:650 14px/1.25 var(--font-sans); color:var(--paper); margin-bottom:3px; }
      .cart-row small { color:var(--paper-soft); font-size:12px; display:block; }
      .cart-price { font:700 14px/1 var(--font-sans); color:var(--paper); }
      .cart-row-foot { display:flex; align-items:center; justify-content:space-between; gap:8px; margin-top:8px; }
      .qty, .cart-controls, .qty-group { display:inline-flex; align-items:center; gap:2px; background:var(--shop-bg-soft); border:1px solid var(--line); border-radius:999px; padding:3px; }
      .qty button, .cart-controls button, .qty-group button { width:30px; height:30px; border-radius:50%; font-size:17px; display:grid; place-items:center; color:var(--paper); background:transparent; }
      .qty button:active, .cart-controls button:active, .qty-group button:active { background:rgba(11,15,26,0.06); }
      .qty b, .cart-controls b, .qty-group b { min-width:30px; text-align:center; font:650 13px/30px var(--font-mono); color:var(--paper); }
      .qty .remove, .cart-controls button[data-remove], .qty-group button[data-remove] { background:transparent; color:var(--shop-ink-muted); font:650 10px/1 var(--font-sans); text-transform:uppercase; min-width:auto; width:auto; padding:0 8px; border-radius:999px; }
      .qty .remove:active, .cart-controls button[data-remove]:active { color:var(--danger); }
      .cart-summary { display:grid; gap:8px; border:1px solid var(--line); border-radius:1rem; background:var(--shop-surface-alt); padding:14px; }
      .cart-trust { display:flex; flex-wrap:wrap; gap:6px 12px; color:var(--paper-soft); font:600 11px/1.4 var(--font-sans); padding:0 2px; }
      .cart-trust span::before { content:"✓ "; color:var(--shop-mint); font-weight:800; }
      .cart-total { display:flex; justify-content:space-between; margin-top:12px; border-top:1px solid var(--line); padding-top:13px; font-size:13px; font-weight:650; color:var(--paper-soft); }
      .cart-total strong { font-size:20px; color:var(--paper); letter-spacing:-0.02em; }

      /* ── Empty & processing states ─────────────────────────────── */
      .empty { display:grid; justify-items:center; gap:8px; padding:36px 16px; border:1px dashed var(--line-strong); border-radius:1rem; background:var(--shop-surface-alt); color:var(--paper-soft); text-align:center; font:600 13px/1.5 var(--font-sans); }
      .empty-icon { font-size:26px; line-height:1; opacity:.75; }
      .empty strong { color:var(--paper); font-size:14px; }
      .processing { display:grid; justify-items:center; gap:12px; padding:36px 16px; color:var(--paper-soft); text-align:center; font:600 13px/1.5 var(--font-sans); }
      .processing-spinner { width:34px; height:34px; border-radius:50%; border:3px solid var(--line); border-top-color:var(--paper); animation:spin 0.9s linear infinite; }
      @keyframes spin { to { transform:rotate(360deg); } }
      .notice { border:1px solid var(--line); border-radius:.9rem; background:var(--notice); color:var(--paper-soft); padding:12px 14px; font:600 12px/1.5 var(--font-sans); }
      .success-mark { display:grid; place-items:center; width:48px; height:48px; border-radius:50%; background:var(--shop-mint-soft); color:var(--shop-mint); font-size:22px; }

      /* ── Modals (bottom sheets) ─────────────────────────────────── */
      .modal-backdrop { position:fixed; z-index:30; inset:0; display:none; align-items:flex-end; background:rgba(11,15,26,.32); backdrop-filter:blur(6px); }
      .modal-backdrop.is-open { display:flex; animation:fadeIn .2s both; }
      @keyframes fadeIn { from{opacity:0} to{opacity:1} }
      .modal {
        width:100%; max-width:600px; max-height:94dvh; margin:0 auto;
        display:flex; flex-direction:column; overflow:hidden;
        border:1px solid var(--line); border-bottom:0; border-radius:24px 24px 0 0;
        background:var(--shop-bg); padding:16px 16px 0;
        box-shadow:0 -12px 48px rgba(11,15,26,0.22);
        animation:sheetIn .35s var(--ease-spring) both;
      }
      @keyframes sheetIn { from { transform:translateY(100%); } to { transform:none; } }
      .modal-grip { width:40px; height:5px; border-radius:999px; background:var(--line-strong); margin:0 auto 12px; flex:0 0 auto; }
      .modal-head { display:flex; align-items:center; justify-content:space-between; gap:12px; margin-bottom:12px; flex:0 0 auto; }
      .modal-head h2 { margin:0; font:800 clamp(1.15rem, 5vw, 1.4rem)/1.15 var(--font-sans); letter-spacing:-0.02em; color:var(--paper); }
      .modal-close { width:36px; height:36px; border:1px solid var(--line); border-radius:50%; background:var(--surface); color:var(--paper-soft); font-size:20px; display:grid; place-items:center; }
      .modal-close:active { transform:scale(.9); }
      .modal-body {
        flex:1 1 auto; min-height:0; overflow-y:auto;
        padding:0 0 calc(16px + env(safe-area-inset-bottom));
        -webkit-overflow-scrolling:touch;
      }
      .modal-body:has(.product-sheet) { overflow:hidden; display:flex; flex-direction:column; padding-bottom:0; }
      .modal-body:not(:has(.product-sheet)) { overflow-y:auto; }

      /* legacy detail modal (kept for compatibility) */
      .detail-hero { margin:-20px -20px 20px; background:var(--shop-bg-soft); border-bottom:1px solid var(--line); display:flex; flex-direction:column; align-items:center; padding:24px; position:relative; }
      .detail-media { width:200px; height:200px; object-fit:contain; filter:drop-shadow(0 12px 24px rgba(16,24,40,0.12)); }
      .detail-copy { margin:16px 0 0; color:var(--paper-soft); font:14px/1.5 var(--font-sans); text-align:center; max-width:400px; }
      .detail-label { margin:24px 0 12px; color:var(--paper); font:700 11px/1 var(--font-mono); letter-spacing:.08em; text-transform:uppercase; }
      .variant-list { display:grid; gap:8px; }
      .variant-choice {
        display:grid; grid-template-columns:minmax(0,1fr) auto; gap:12px; align-items:center; text-align:left;
        min-height:64px; border:1px solid var(--line-strong); border-radius:1rem;
        background:var(--surface); padding:12px 16px; transition:all .2s;
      }
      .variant-choice:active:not(:disabled) { transform:scale(.98); border-color:var(--paper); }
      .variant-choice:disabled { opacity:.4; cursor:not-allowed; }
      .variant-choice b { font:650 15px/1.2 var(--font-sans); color:var(--paper); }
      .variant-choice small { color:var(--paper-soft); font:500 12px/1 var(--font-sans); }
      .variant-choice strong { font:700 17px/1 var(--font-sans); color:var(--paper); text-align:right; }

      /* ── Payment forms ──────────────────────────────────────────── */
      .method-list { display:grid; gap:8px; margin:16px 0; }
      .method-choice {
        display:grid; grid-template-columns:minmax(0,1fr) auto; gap:12px; align-items:center;
        border:1px solid var(--line); border-radius:1rem; background:var(--surface); padding:14px;
        text-align:left; transition:all .2s;
      }
      .method-choice:active { transform:scale(.98); }
      .method-choice.is-selected { border-color:var(--paper); background:var(--shop-surface-alt); box-shadow:0 0 0 1px var(--paper); }
      .method-choice-main { display:flex; min-width:0; align-items:center; gap:12px; }
      .method-choice strong { display:block; overflow:hidden; font-size:14px; font-weight:700; color:var(--paper); text-overflow:ellipsis; white-space:nowrap; }
      .method-choice small { display:block; margin-top:4px; color:var(--paper-soft); font-size:11px; }
      .method-choice b { font:700 12px/1 var(--font-mono); color:var(--paper-soft); text-transform:uppercase; }

      .network-mark { display:grid; flex:0 0 auto; width:36px; height:36px; place-items:center; border:1px solid var(--line); border-radius:50%; background:var(--shop-bg-soft); color:var(--paper); font-size:13px; font-weight:800; }
      .network-mark svg { width:20px; height:20px; fill:currentColor; }
      .network-mark[data-network="ETHEREUM"] { background:#eff6ff; color:#1d4ed8; border-color:#bfdbfe; }
      .network-mark[data-network="BSC"] { background:#fefce8; color:#a16207; border-color:#fde047; }
      .network-mark[data-network="SOLANA"] { background:#f3e8ff; color:#6b21a8; border-color:#d8b4fe; }
      .network-mark[data-network="POLYGON"] { background:#faf5ff; color:#7e22ce; border-color:#e9d5ff; }
      .network-mark[data-network="TRON"] { background:#fff1f2; color:#be123c; border-color:#fecdd3; }
      .network-line { display:flex; align-items:center; gap:7px; margin-top:6px; color:var(--paper-soft); font-size:11px; }
      .network-line .network-mark { width:20px; height:20px; border-width:1px; font-size:9px; }
      .network-line .network-mark svg { width:12px; height:12px; }

      .payment-box { display:grid; gap:16px; border:1px solid var(--line); border-radius:1.25rem; background:var(--shop-surface-alt); padding:18px; margin-top:16px; }
      .payment-box h3 { color:var(--paper); font:700 18px/1.2 var(--font-sans); margin:0; }
      .payment-box p { margin:0; color:var(--paper-soft); font-size:13px; line-height:1.5; }
      .payment-amount { display:flex; align-items:end; justify-content:space-between; gap:10px; border-bottom:1px solid var(--line); padding-bottom:12px; }
      .payment-amount span { color:var(--paper-soft); font:700 10px/1 var(--font-mono); text-transform:uppercase; letter-spacing:.08em; }
      .payment-amount strong { color:var(--paper); font:800 28px/1 var(--font-sans); font-variant-numeric:tabular-nums; letter-spacing:-0.02em; }
      .payment-qr { display:grid; justify-items:center; gap:12px; padding:16px; background:#ffffff; border:1px solid var(--line); border-radius:1rem; box-shadow:0 1px 2px rgba(16,24,40,0.04); }
      .payment-qr img { display:block; width:min(240px, 100%); aspect-ratio:1; object-fit:contain; }
      .payment-qr small { color:var(--paper-soft); font-size:11px; font-weight:600; text-align:center; }
      .payment-field { display:grid; grid-template-columns:minmax(0,1fr) auto; gap:8px; align-items:center; }
      .payment-field span { min-width:0; overflow-wrap:anywhere; border:1px solid var(--line); border-radius:.6rem; background:var(--surface); padding:12px; color:var(--paper); font:600 12px/1.4 var(--font-mono); }
      .payment-field-label { display:flex; align-items:center; justify-content:space-between; gap:8px; color:var(--paper); font:700 10px/1 var(--font-mono); text-transform:uppercase; letter-spacing:.05em; }
      .payment-field-label small { color:var(--paper-soft); font-size:10px; text-transform:none; letter-spacing:0; }
      .payment-proof { display:grid; gap:12px; border:1px solid var(--line); border-radius:1rem; background:var(--surface); padding:16px; margin-top:16px; }
      .payment-proof label { display:grid; gap:8px; color:var(--paper); font:700 11px/1 var(--font-mono); text-transform:uppercase; letter-spacing:.05em; }
      .payment-proof input { width:100%; min-height:46px; border:1px solid var(--line-strong); border-radius:.6rem; background:var(--shop-bg); color:var(--paper); padding:0 12px; font-size:14px; }
      .payment-proof input:focus { border-color:var(--paper); outline:none; box-shadow:0 0 0 3px rgba(11,15,26,0.08); }
      .payment-proof input[type="file"] { padding:10px; font-size:12px; }
      .payment-proof small { color:var(--paper-soft); font-size:12px; line-height:1.5; }
      .proof-list { display:grid; gap:8px; color:var(--paper-soft); font-size:12px; margin-top:12px; }
      .proof-item { display:flex; align-items:center; justify-content:space-between; gap:8px; border-top:1px solid var(--line); padding-top:8px; }
      .proof-item strong { color:var(--paper); font-weight:700; }
      .payment-status { display:inline-flex; width:max-content; border:1px solid var(--line-strong); border-radius:999px; color:var(--paper-soft); padding:5px 10px; font:700 10px/1 var(--font-mono); letter-spacing:.06em; text-transform:uppercase; }
      .payment-status.is-paid { border-color:transparent; background:var(--shop-mint); color:#fff; }

      /* ── Payment steps (3-step progress) ────────────────────────── */
      .payment-steps { display:grid; grid-template-columns:repeat(3, minmax(0,1fr)); gap:4px; margin:0 0 14px; padding:0; list-style:none; counter-reset:pay-step; }
      .payment-step { position:relative; display:grid; gap:6px; justify-items:center; text-align:center; color:var(--paper-soft); font:650 10px/1.3 var(--font-sans); counter-increment:pay-step; }
      .payment-step::before { content:counter(pay-step); display:grid; width:26px; height:26px; place-items:center; border-radius:50%; border:1.5px solid var(--line-strong); background:var(--surface); color:var(--paper-soft); font:750 11px/1 var(--font-sans); }
      .payment-step:not(:last-child)::after { content:""; position:absolute; top:13px; left:calc(50% + 16px); width:calc(100% - 32px); height:1.5px; background:var(--line-strong); }
      .payment-step.is-active { color:var(--paper); font-weight:750; }
      .payment-step.is-active::before { border-color:var(--paper); background:var(--paper); color:#fff; box-shadow:0 0 0 4px rgba(11,15,26,0.08); }
      .payment-step.is-done::before { border-color:transparent; background:var(--shop-mint); color:#fff; content:"✓"; }
      .payment-step.is-done:not(:last-child)::after { background:var(--shop-mint); }
      .payment-summary { display:grid; gap:6px; border:1px solid var(--line); border-radius:.9rem; background:var(--shop-surface-alt); padding:12px 14px; }
      .payment-total { display:flex; justify-content:space-between; align-items:baseline; gap:10px; font:650 13px/1 var(--font-sans); color:var(--paper-soft); }
      .payment-total strong { font:800 20px/1 var(--font-sans); color:var(--paper); letter-spacing:-0.02em; }

      /* ── Orders view ────────────────────────────────────────────── */
      .order-tools { display:flex; align-items:center; justify-content:space-between; gap:10px; margin-bottom:12px; }
      .order-filters { display:flex; gap:6px; overflow-x:auto; padding-bottom:2px; scrollbar-width:none; }
      .order-filters::-webkit-scrollbar { display:none; }
      .order-filter { min-height:36px; flex:0 0 auto; border:1px solid var(--line); border-radius:999px; background:var(--surface); color:var(--paper); padding:0 13px; font:650 11.5px/1 var(--font-sans); white-space:nowrap; transition:all .18s; }
      .order-filter.is-active { border-color:transparent; background:var(--paper); color:#fff; box-shadow:0 2px 8px rgba(11,15,26,0.2); }
      .order-insights { display:grid; grid-template-columns:repeat(3, minmax(0,1fr)); gap:8px; margin-bottom:14px; }
      .order-insight { display:grid; gap:3px; padding:10px 12px; border:1px solid var(--line); border-radius:.85rem; background:var(--surface); box-shadow:0 1px 2px rgba(16,24,40,0.03); }
      .order-insight b { font:800 17px/1 var(--font-sans); color:var(--paper); letter-spacing:-0.02em; }
      .order-insight span { color:var(--paper-soft); font:650 9.5px/1.2 var(--font-sans); text-transform:uppercase; letter-spacing:.04em; }
      .order-insight.is-good b { color:var(--shop-mint); }
      .order-insight.is-waiting b { color:var(--shop-sun); }
      .order-card { border:1px solid var(--line); border-radius:1.1rem; background:var(--surface); padding:16px; box-shadow:0 1px 2px rgba(16,24,40,0.03); }
      .order-card header { display:flex; align-items:flex-start; justify-content:space-between; gap:12px; margin-bottom:10px; }
      .order-card h3 { margin:0; font:700 15px/1.2 var(--font-sans); color:var(--paper); }
      .order-card time { color:var(--shop-ink-muted); font:500 11.5px/1 var(--font-sans); }
      .order-card p { margin:0; color:var(--paper-soft); font:13px/1.4 var(--font-sans); }
      .status { display:inline-flex; align-items:center; gap:6px; min-height:24px; padding:0 10px; border-radius:999px; background:var(--shop-bg-soft); color:var(--paper-soft); font:700 10px/1 var(--font-sans); text-transform:uppercase; letter-spacing:.04em; }
      .status::before { content:""; width:6px; height:6px; border-radius:50%; background:currentColor; }
      .status.is-pending, .status[data-status="pending"] { background:var(--shop-sun-soft); color:#a06a08; }
      .status.is-paid, .status.is-good, .status[data-status="paid"], .status[data-status="delivered"] { background:var(--shop-mint-soft); color:#0b7a54; }
      .status.is-failed, .status.is-bad, .status[data-status="failed"], .status[data-status="cancelled"], .status[data-status="expired"] { background:var(--shop-danger-soft); color:#b03830; }
      .order-meta { display:flex; flex-wrap:wrap; gap:6px 12px; color:var(--paper-soft); font:600 11.5px/1.4 var(--font-sans); }
      .order-number-wrap { display:flex; align-items:center; gap:8px; min-width:0; }
      .order-number { font:700 12.5px/1 var(--font-mono); color:var(--paper); overflow-wrap:anywhere; }
      .order-number-copy { display:inline-grid; width:34px; height:34px; place-items:center; border:1px solid var(--line); border-radius:.6rem; background:var(--surface); color:var(--paper-soft); padding:0; font-size:14px; }
      .order-number-copy.is-copied { border-color:var(--shop-mint); background:var(--shop-mint-soft); color:#0b7a54; }
      .order-facts { display:grid; grid-template-columns:repeat(auto-fit, minmax(110px, 1fr)); gap:8px; margin:12px 0; }
      .order-fact { display:grid; gap:3px; padding:9px 11px; border-radius:.7rem; background:var(--shop-surface-alt); border:1px solid var(--line); }
      .order-fact span { color:var(--shop-ink-muted); font:650 9px/1 var(--font-sans); text-transform:uppercase; letter-spacing:.05em; }
      .order-fact b { color:var(--paper); font:700 12.5px/1.2 var(--font-sans); overflow-wrap:anywhere; }
      .order-lines { display:grid; gap:8px; margin:12px 0; }
      .order-line { display:flex; align-items:center; justify-content:space-between; gap:10px; padding:10px 12px; border:1px solid var(--line); border-radius:.75rem; background:var(--surface); font:600 12.5px/1.35 var(--font-sans); color:var(--paper); }
      .order-line small { display:block; color:var(--paper-soft); font-size:11px; margin-top:2px; }
      .order-totals { display:grid; gap:6px; border-top:1px solid var(--line); padding-top:12px; margin-top:4px; }
      .order-total { display:flex; justify-content:space-between; align-items:baseline; font:650 13px/1 var(--font-sans); color:var(--paper); }
      .order-total strong { font:800 19px/1 var(--font-sans); letter-spacing:-0.02em; }
      .summary-line { display:flex; justify-content:space-between; gap:10px; color:var(--paper-soft); font:600 12.5px/1.4 var(--font-sans); }
      .summary-line.discount-line { color:#0b7a54; }
      .summary-line.total-line { color:var(--paper); font:700 16px/1.2 var(--font-sans); letter-spacing:-0.01em; }
      .order-detail-summary { display:grid; gap:10px; }
      .order-detail-actions, .order-actions { display:flex; flex-wrap:wrap; gap:8px; margin-top:14px; }
      .order-actions button, .order-detail-actions button {
        flex:1; min-height:42px; border:1px solid var(--line-strong); border-radius:.8rem;
        background:var(--surface); color:var(--paper); font:650 12px/1 var(--font-sans);
        transition:all .2s; padding:0 12px;
      }
      .order-actions button:active, .order-detail-actions button:active { transform:scale(.98); }
      .order-actions button.primary, .order-actions button[data-resume-payment], .order-actions button[data-keys] {
        background:var(--cta-primary); color:#fff; border-color:transparent; box-shadow:var(--cta-shadow);
      }
      .order-actions button.primary:active { background:var(--cta-primary-press); }
      .order-progress { display:grid; grid-template-columns:repeat(4, minmax(0,1fr)); gap:4px; margin:14px 0; padding:0; list-style:none; counter-reset:ord-step; }
      .order-progress-step { position:relative; display:grid; gap:5px; justify-items:center; text-align:center; color:var(--paper-soft); font:650 9.5px/1.25 var(--font-sans); counter-increment:ord-step; }
      .order-progress-step::before { content:counter(ord-step); display:grid; width:24px; height:24px; place-items:center; border-radius:50%; border:1.5px solid var(--line-strong); background:var(--surface); color:var(--paper-soft); font:750 10px/1 var(--font-sans); }
      .order-progress-step:not(:last-child)::after { content:""; position:absolute; top:12px; left:calc(50% + 15px); width:calc(100% - 30px); height:1.5px; background:var(--line-strong); }
      .order-progress-step.is-active { color:var(--paper); }
      .order-progress-step.is-active::before { border-color:var(--paper); background:var(--paper); color:#fff; box-shadow:0 0 0 4px rgba(11,15,26,0.08); }
      .order-progress-step.is-done::before { border-color:transparent; background:var(--shop-mint); color:#fff; content:"✓"; }
      .order-progress-step.is-done:not(:last-child)::after { background:var(--shop-mint); }
      .order-skeleton { display:grid; gap:10px; border:1px solid var(--line); border-radius:1.1rem; padding:16px; background:var(--surface); }
      .order-skeleton::before, .order-skeleton::after { content:""; height:14px; border-radius:999px; background:linear-gradient(90deg, var(--shop-bg-soft) 25%, #fff 50%, var(--shop-bg-soft) 75%); background-size:200% 100%; animation:shop-skel 1.1s ease infinite; }
      .order-skeleton::after { width:65%; }

      /* ── Discount box ───────────────────────────────────────────── */
      .discount-box { display:grid; gap:10px; border:1px dashed var(--line-strong); border-radius:1rem; background:var(--shop-surface-alt); padding:14px; }
      .discount-head { display:flex; align-items:center; justify-content:space-between; gap:8px; }
      .discount-head strong { font:700 12.5px/1 var(--font-sans); color:var(--paper); }
      .discount-form { display:grid; grid-template-columns:minmax(0,1fr) auto; gap:8px; }
      .discount-form input {
        width:100%; min-height:42px; padding:0 13px;
        border:1px solid var(--line-strong); border-radius:.7rem;
        background:var(--surface); color:var(--paper); font:600 13px/1 var(--font-sans);
      }
      .discount-form input:focus { border-color:var(--paper); outline:none; box-shadow:0 0 0 3px rgba(11,15,26,0.08); }
      .discount-applied {
        display:flex; align-items:center; justify-content:space-between; gap:8px;
        padding:10px 12px; border-radius:.7rem; border:1px solid rgba(13,166,120,.3);
        background:var(--shop-mint-soft); color:#0b7a54; font:650 12px/1.3 var(--font-sans);
      }
      .discount-message { margin:0; color:var(--paper-soft); font:550 11.5px/1.45 var(--font-sans); }
      .discount-message.is-error { color:var(--danger-text); }

      /* ── Key sheet (delivery reveal) ────────────────────────────── */
      .key-sheet { display:grid; gap:14px; }
      .key-sheet-actions { display:flex; flex-wrap:wrap; gap:8px; }
      .key-hero { display:grid; gap:8px; justify-items:center; text-align:center; padding:18px 14px; border-radius:1.1rem; border:1px solid rgba(13,166,120,.28); background:linear-gradient(160deg, var(--shop-mint-soft), var(--surface)); }
      .key-hero-top { display:flex; align-items:center; gap:10px; }
      .key-order-number { font:700 12px/1 var(--font-mono); color:var(--paper); overflow-wrap:anywhere; }
      .key-overview { color:var(--paper-soft); font:600 12px/1.5 var(--font-sans); }
      .key-secure { display:inline-flex; align-items:center; gap:6px; color:#0b7a54; font:650 10.5px/1 var(--font-sans); text-transform:uppercase; letter-spacing:.04em; }
      .key-deliveries { display:grid; gap:10px; }
      .key-delivery { display:grid; gap:8px; border:1px solid var(--line); border-radius:.95rem; background:var(--surface); padding:12px; }
      .key-delivery-head { display:flex; align-items:center; justify-content:space-between; gap:8px; }
      .key-delivery-index { display:grid; place-items:center; width:24px; height:24px; border-radius:50%; background:var(--shop-bg-soft); color:var(--paper); font:750 11px/1 var(--font-sans); }
      .key-delivery-copy strong { display:block; font:650 13px/1.2 var(--font-sans); color:var(--paper); }
      .key-delivery-copy small { display:block; margin-top:2px; color:var(--paper-soft); font:500 11px/1.3 var(--font-sans); }
      .key-delivery-status { margin-left:auto; }
      .key-rows { display:grid; gap:6px; }
      .key-row { display:grid; grid-template-columns:minmax(0,1fr) auto; gap:8px; align-items:center; }
      .key-row-number { color:var(--shop-ink-muted); font:650 10px/1 var(--font-mono); }
      .key-code {
        min-width:0; overflow-wrap:anywhere; padding:9px 11px;
        border:1px solid var(--line); border-radius:.6rem; background:var(--shop-bg-soft);
        color:var(--paper); font:600 11.5px/1.4 var(--font-mono);
      }
      .key-copy, .key-copy-all { min-height:36px; border:1px solid var(--line-strong); border-radius:.6rem; background:var(--surface); color:var(--paper); padding:0 12px; font:650 11px/1 var(--font-sans); white-space:nowrap; }
      .key-copy:active, .key-copy-all:active { background:var(--shop-bg-soft); }
      .key-copy.is-copied, .key-copy-all.is-copied { border-color:transparent; background:var(--shop-mint); color:#fff; }
      .key-button-label { display:inline-flex; align-items:center; gap:6px; }
      .key-pending { display:grid; gap:12px; justify-items:center; text-align:center; padding:24px 16px; border:1px dashed var(--line-strong); border-radius:1.1rem; background:var(--shop-surface-alt); }
      .key-pending-orbit { width:38px; height:38px; border-radius:50%; border:3px solid var(--line); border-top-color:var(--shop-mint); animation:spin 0.9s linear infinite; }
      .key-pending-status { color:var(--paper-soft); font:600 12px/1.5 var(--font-sans); }
      .key-pending-actions { display:flex; flex-wrap:wrap; gap:8px; justify-content:center; }

      /* ── Toast ──────────────────────────────────────────────────── */
      .toast {
        position:fixed; z-index:40; right:12px; bottom:calc(90px + env(safe-area-inset-bottom)); left:12px;
        display:none; max-width:400px; margin:auto;
        border:1px solid var(--line); border-radius:1rem;
        background:var(--surface); color:var(--paper);
        padding:14px 16px; font:600 13px/1.4 var(--font-sans); text-align:center;
        box-shadow:0 8px 32px rgba(11,15,26,0.18);
      }
      .toast.is-visible { display:block; animation:toastIn .3s var(--ease-spring) both; }
      @keyframes toastIn { 0%{opacity:0;transform:translateY(24px) scale(.94)} 100%{opacity:1;transform:none} }

      /* ── Unified CTA kit ────────────────────────────────────────── */
      button.primary, .primary, .btn-cta, .btn-cta--primary,
      .hero-cta, .product-action, .add-button, .featured-action,
      .checkout-dock button, #checkout-dock-button, #checkout-button,
      .checkout-bar button, .cart-dock-action,
      .product-sheet__dock .btn-cta--primary,
      .order-actions button.primary {
        appearance:none; -webkit-appearance:none;
        display:inline-flex; align-items:center; justify-content:center; gap:8px;
        min-height:44px; padding:0 16px;
        border:0; border-radius:999px;
        background:var(--cta-primary); color:var(--cta-primary-ink);
        font:650 13px/1 var(--font-sans); letter-spacing:-0.01em;
        box-shadow:var(--cta-shadow);
        transition:transform .16s var(--ease), box-shadow .16s var(--ease), background .16s ease, opacity .16s;
        cursor:pointer;
      }
      button.primary:active, .primary:active, .btn-cta--primary:active, .hero-cta:active,
      .product-action:active, .add-button:active, .featured-action:active,
      .checkout-dock button:active, #checkout-dock-button:active, #checkout-button:active,
      .checkout-bar button:active, .cart-dock-action:active {
        transform:scale(0.97);
        background:var(--cta-primary-press);
        box-shadow:0 1px 4px rgba(11,15,26,0.18);
      }
      button.primary:disabled, .primary:disabled, .btn-cta--primary:disabled,
      .product-action:disabled, .add-button:disabled,
      .checkout-dock button:disabled, #checkout-dock-button:disabled, #checkout-button:disabled {
        opacity:.42; cursor:not-allowed; transform:none; box-shadow:none;
        background:var(--shop-bg-soft); color:var(--shop-ink-muted);
      }
      .product-action, .add-button, .featured-action {
        min-height:42px; min-width:5.5rem; padding:0 12px; font:700 12px/1 var(--font-sans); white-space:nowrap;
      }
      .hero-cta { min-height:40px; padding:0 14px; font-size:12px; }

      button.secondary, .secondary, .btn-cta--secondary,
      .button:not(.primary), .discount-clear, .section-action, .title-button,
      .product-sheet__dock .btn-cta--secondary {
        appearance:none; -webkit-appearance:none;
        display:inline-flex; align-items:center; justify-content:center; gap:6px;
        min-height:44px; padding:0 14px;
        border:1px solid var(--cta-secondary-line); border-radius:999px;
        background:var(--cta-secondary-bg); color:var(--cta-secondary-ink);
        font:650 13px/1 var(--font-sans);
        box-shadow:0 1px 2px rgba(16,24,40,0.04);
        transition:transform .15s ease, background .15s ease, border-color .15s ease;
        cursor:pointer;
      }
      button.secondary:active, .secondary:active, .btn-cta--secondary:active,
      .button:not(.primary):active, .title-button:active {
        transform:scale(0.97); background:var(--shop-surface-alt); border-color:#b9c2d0;
      }
      .modal-close {
        border:1px solid var(--line); background:var(--surface); color:var(--paper-soft);
        box-shadow:none; min-height:36px; border-radius:50%; padding:0;
      }

      /* ── Product sheet (PDP in modal) ───────────────────────────── */
      .product-sheet { flex:1 1 auto; min-height:0; display:flex; flex-direction:column; gap:0; padding-bottom:0; }
      .product-sheet__scroll {
        flex:1 1 auto; min-height:0; overflow-y:auto; -webkit-overflow-scrolling:touch;
        display:grid; gap:14px; padding:2px 2px 16px;
      }
      .product-sheet__hero {
        margin:0 -2px; border-radius:1rem; overflow:hidden;
        aspect-ratio:1 / 1; min-height:min(52vw, 240px); max-height:min(72vw, 340px);
        background:var(--shop-bg-soft); border:1px solid var(--line);
      }
      .product-sheet__hero img { width:100%; height:100%; object-fit:cover; object-position:center; display:block; }
      .product-sheet__head { display:grid; gap:10px; }
      .sheet-chips { display:flex; flex-wrap:wrap; gap:6px; }
      .sheet-chip {
        display:inline-flex; align-items:center; min-height:26px; padding:0 11px;
        border-radius:999px; background:var(--shop-bg-soft); border:1px solid var(--line);
        color:var(--paper-soft); font:650 11px/1 var(--font-sans);
      }
      .product-sheet__lead { margin:0; color:var(--paper); font:600 15px/1.45 var(--font-sans); }
      .product-sheet__section { display:grid; gap:10px; }
      .product-sheet__label { margin:0; color:var(--paper-soft); font:700 10.5px/1 var(--font-sans); letter-spacing:.05em; text-transform:uppercase; }
      .product-sheet__body { color:var(--paper-soft); font:13.5px/1.55 var(--font-sans); max-height:8rem; overflow:auto; padding-right:4px; }
      .product-sheet__trust { padding:12px 14px; border-radius:.9rem; border:1px solid var(--line); background:var(--shop-surface-alt); }
      .product-sheet__trust p { margin:0 0 6px; color:var(--paper); font:600 12.5px/1.4 var(--font-sans); }
      .product-sheet__hint { margin:0; color:var(--paper-soft); font:500 11.5px/1.4 var(--font-sans); }

      .plan-list { display:grid; gap:8px; }
      .plan-card {
        display:grid; grid-template-columns:minmax(0,1fr) auto; gap:10px; align-items:center;
        text-align:left; min-height:64px; padding:12px 14px;
        border:1.5px solid var(--line); border-radius:1rem; background:var(--surface);
        transition:border-color .15s, box-shadow .15s, transform .15s, background .15s;
      }
      .plan-card.is-selected {
        border-color:var(--cta-primary); background:var(--shop-surface-alt);
        box-shadow:0 0 0 1px var(--cta-primary), 0 8px 18px -8px rgba(11,15,26,0.2);
      }
      .plan-card:active:not(:disabled) { transform:scale(.985); }
      .plan-card:disabled { opacity:.45; }
      .plan-card__main { display:grid; gap:4px; min-width:0; }
      .plan-card__main b { font:700 14px/1.2 var(--font-sans); color:var(--paper); }
      .plan-card__main small { color:var(--paper-soft); font:500 12px/1.3 var(--font-sans); }
      .plan-card__price { text-align:right; display:grid; gap:3px; }
      .plan-card__price strong { font:800 16px/1 var(--font-sans); color:var(--paper); }
      .plan-card__price del { color:var(--paper-soft); font:600 11px/1 var(--font-sans); }

      .product-sheet__dock {
        flex:0 0 auto; z-index:4; display:grid; gap:10px;
        margin:0 -16px; padding:12px 16px calc(12px + env(safe-area-inset-bottom));
        border-top:1px solid var(--line);
        background:rgba(255,255,255,.97);
        backdrop-filter:blur(14px);
        box-shadow:0 -10px 28px rgba(11,15,26,0.1);
      }
      .product-sheet__dock-price { min-width:0; display:grid; gap:2px; }
      .product-sheet__dock-price small { color:var(--paper-soft); font:650 11px/1.2 var(--font-sans); white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
      .product-sheet__dock-price strong { font:800 1.2rem/1.1 var(--font-sans); color:var(--paper); letter-spacing:-.02em; }
      .product-sheet__dock-actions { display:grid; grid-template-columns:1fr 1.35fr; gap:8px; }
      .product-sheet__dock-actions .btn-cta--secondary { min-height:50px; }
      .product-sheet__dock-actions .btn-cta--primary { min-height:50px; font-size:15px; letter-spacing:-.01em; }
      .product-sheet__related { padding-bottom:4px; }
      .related-rail {
        display:grid; grid-auto-flow:column; grid-auto-columns:minmax(148px, 62%);
        gap:10px; overflow-x:auto; padding:2px 2px 8px; scroll-snap-type:x mandatory;
        -webkit-overflow-scrolling:touch; scrollbar-width:none;
      }
      .related-rail::-webkit-scrollbar { display:none; }
      .related-card {
        scroll-snap-align:start; display:grid; gap:8px; padding:0; border:1px solid var(--line);
        border-radius:14px; background:var(--surface); overflow:hidden; text-align:left; cursor:pointer;
        color:inherit; font:inherit; box-shadow:0 1px 2px rgba(16,24,40,0.03);
        transition:transform .16s ease;
      }
      .related-card:active { transform:scale(.985); }
      .related-card__media { aspect-ratio:4/3; background:var(--shop-bg-soft); overflow:hidden; }
      .related-card__media img { width:100%; height:100%; object-fit:cover; display:block; }
      .related-card__media .media-placeholder, .related-card__media .placeholder {
        width:100%; height:100%; display:grid; place-items:center;
        font:800 1.4rem/1 var(--font-sans); color:var(--shop-ink-muted);
      }
      .related-card__body { display:grid; gap:4px; padding:0 10px 10px; min-width:0; }
      .related-card__body b {
        font:700 13px/1.25 var(--font-sans); color:var(--paper);
        display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden;
      }
      .related-card__body strong { font:800 14px/1 var(--font-sans); color:var(--paper); }

      /* ── Skeletons ──────────────────────────────────────────────── */
      .catalog-skeleton, .grid-skeleton { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:12px; }
      .catalog-skeleton__card, .grid-skeleton__card {
        min-height:210px; border-radius:1rem; border:1px solid var(--line);
        background:linear-gradient(90deg, var(--shop-bg-soft) 25%, #fff 50%, var(--shop-bg-soft) 75%);
        background-size:200% 100%; animation:shop-skel 1.1s ease infinite;
      }
      @keyframes shop-skel { 0%{background-position:100% 0} 100%{background-position:-100% 0} }

      /* ── Media queries ──────────────────────────────────────────── */
      @media (min-width:600px) {
        .grid, .catalog { grid-template-columns:repeat(3,minmax(0,1fr)); }
        .modal { padding:32px 32px calc(32px + env(safe-area-bottom)); border-radius:32px 32px 0 0; }
        .bottom-nav { padding-bottom:24px; }
        .bottom-nav-inner { padding:8px; gap:12px; max-width:480px; }
      }
      @media (max-width:420px) {
        .checkout-dock, #checkout-dock, .checkout-bar, .cart-dock {
          right:10px; left:10px; bottom:calc(70px + env(safe-area-inset-bottom)); padding:10px 12px;
        }
        .checkout-dock button, #checkout-dock-button, #checkout-button { min-width:6.5rem; }
      }
      @media (max-width:359px) {
        body { padding-right:9px; padding-left:9px; }
        .product-action { width:100%; }
        .order-actions { grid-template-columns:1fr; }
      }
      @media (prefers-reduced-motion:reduce) {
        *,*:before,*:after { animation-duration:.01ms!important; transition-duration:.01ms!important; }
      }
    </style>  </head>
  <body data-session-state="pending" data-locale={miniLocale} data-currency={miniCurrency}>
    <div class="app">
      <header class="topbar"><div class="brand"><span class="brand-mark" id="shop-brand-mark">{shopBranding.mark}</span><span id="shop-brand-name">{shopBranding.shopName}</span></div><div class="identity"><span class="identity-copy"><b id="hello">Telegram</b><small id="identity-status">{miniCopy.identityPending}</small></span><span class="avatar" id="avatar">{shopBranding.mark}</span></div></header>
      <aside class="pending-banner" id="pending-payment-banner" hidden aria-live="polite"><div><span>{miniCopy.pendingOrder}</span><strong id="pending-payment-label">{miniCopy.resumePayment}</strong></div><button data-resume-payment="pending">{miniCopy.reopen}</button></aside>
      <aside class="session-error-banner" id="session-error-banner" hidden role="alert" aria-live="assertive"><div><span id="session-error-kicker">{miniCopy.telegramConnection}</span><strong id="session-error-title">{miniCopy.sessionNotVerified}</strong><p id="session-error-copy">{miniCopy.sessionRetry}</p></div><button type="button" data-session-retry>{miniCopy.retry}</button></aside>
      <div class="home-only"><section class="hero"><p class="hero-kicker" id="hero-kicker">{miniCopy.heroKicker}</p><h1 id="hero-title"><span id="hero-heading">{miniCopy.heroFirst}</span> <em id="hero-emphasis">{miniCopy.heroSecond}</em></h1><div class="hero-foot"><button class="hero-cta" id="hero-featured-cta" type="button">{miniCopy.featuredCta}</button><span class="hero-signal" id="session-signal">{miniCopy.verifying}</span></div></section></div>
      <main>
        <section class="view is-active" data-view="home">
          <section id="featured-section"><div class="section-head"><h2>{miniCopy.featuredHeading}</h2><span id="featured-caption">{miniCopy.featuredCaption}</span></div><div class="featured-rail" id="featured-products"></div></section>
