    <div class="modal-backdrop" id="modal-backdrop" aria-hidden="true"><section class="modal" role="dialog" aria-modal="true" aria-labelledby="modal-title"><div class="modal-grip" aria-hidden="true"></div><header class="modal-head"><h2 id="modal-title">{miniCopy.checkout}</h2><button class="modal-close" id="modal-close" aria-label={miniCopy.close}>×</button></header><div class="modal-body" id="modal-body"></div></section></div>
    <div class="toast" id="toast" role="status"></div>
    <script is:inline type="application/json" id="products-data" set:html={serializedProducts}></script>
    <script is:inline>
      const products = JSON.parse(document.getElementById("products-data").textContent || "[]");
      // This page is the legacy Vietnam Mini App. Keep browser state aligned
      // with the server contract even if a stale cached document or local
      // storage value contains a former global locale/currency.
      const locale = "vi";
      const displayCurrency = "VND";
      const copy = locale === "en" ? {
        available: "Ready to deliver", outOfStock: "Out of stock", remaining: "left", items: "items", all: "All",
        service: "Service", download: "Download", licenseKey: "License key", featured: "Featured", add: "Add",
        choosePlan: "Choose plan", searchEmpty: "No matching products.", searchHint: "Try a shorter search.",
        productEyebrow: "Delivered directly in Telegram", productDescription: "Choose a plan and pay securely.",
        productDetail: "Digital product delivered after payment.", choosePlanLabel: "Choose a plan",
        orderCreated: "Order created", order: "Order", payment: "Payment", paymentPending: "Payment pending",
        paid: "Paid", unpaid: "Unpaid", failed: "Payment failed", refunded: "Refunded", unknown: "Unknown",
        delivery: "Delivery", delivered: "Delivered", processing: "Processing", awaitingPayment: "Awaiting payment",
        refresh: "Refresh", checkout: "Checkout", securePayment: "Secure payment", keyReady: "Key ready",
      } : {
        available: "Sẵn sàng giao", outOfStock: "Hết hàng", remaining: "Còn", items: "sản phẩm", all: "Tất cả",
        service: "Dịch vụ", download: "Download", licenseKey: "License key", featured: "Nổi bật", add: "Thêm",
        choosePlan: "Chọn gói", searchEmpty: "Không tìm thấy sản phẩm phù hợp.", searchHint: "Thử từ khóa ngắn hơn nhé.",
        productEyebrow: "Giao trực tiếp trong Telegram", productDescription: "Chọn gói phù hợp và thanh toán bằng VietQR.",
        productDetail: "Sản phẩm số giao trực tiếp sau khi thanh toán.", choosePlanLabel: "Chọn gói phù hợp",
        orderCreated: "Đơn đã tạo", order: "Đơn", payment: "Thanh toán", paymentPending: "Đang chờ thanh toán",
        paid: "Đã thanh toán", unpaid: "Chưa thanh toán", failed: "Thanh toán lỗi", refunded: "Đã hoàn tiền", unknown: "Chưa rõ",
        delivery: "Giao hàng", ready:"Sẵn sàng phát hành", delivered:"Đã giao đầy đủ", processing: "Đang phát hành", awaitingPayment: "Chờ thanh toán",
        refresh: "Làm mới", checkout: "Thanh toán", securePayment: "Thanh toán an toàn", keyReady: "Key sẵn sàng",
      };
      const readTelegramInitData = () => {
        const sdkValue = window.Telegram?.WebApp?.initData;
        if (typeof sdkValue === "string" && sdkValue) return sdkValue;
        try { return new URLSearchParams(location.hash.replace(/^#/, "")).get("tgWebAppData") || ""; } catch { return ""; }
      };
      const readTelegramUser = (raw) => {
        const sdkUser = window.Telegram?.WebApp?.initDataUnsafe?.user;
        if (sdkUser?.id) return sdkUser;
        try { const value = JSON.parse(new URLSearchParams(raw).get("user") || "null"); return value?.id ? value : null; } catch { return null; }
      };
      const tg = window.Telegram?.WebApp;
      const telegramSupports = (version) => typeof tg?.isVersionAtLeast === "function" && tg.isVersionAtLeast(version);
      const showTelegramBackButton = () => { if (telegramSupports("6.1")) tg.BackButton?.show(); };
      const hideTelegramBackButton = () => { if (telegramSupports("6.1")) tg.BackButton?.hide(); };
      let initData = readTelegramInitData();
      let telegramUser = readTelegramUser(initData);
      const telegramBotConfigId = (() => { try { const value = new URL(location.href).searchParams.get("bot") || ""; return /^[A-Za-z0-9_-]{8,80}$/.test(value) ? value : ""; } catch { return ""; } })();
      const telegramBotHeader = telegramBotConfigId ? { "x-telegram-bot-config": telegramBotConfigId } : {};
      const getTelegramInitData = () => initData || (initData = readTelegramInitData());
      tg?.ready(); tg?.expand();
      let telegramIdentity = String(telegramUser?.id || "guest");
      let cartKey = `tung:telegram-mini-cart:v2:${telegramIdentity}`;
      let pendingPaymentKey = `tung:telegram-mini-pending:v1:${telegramIdentity}`;
      let discountKey = `tung:telegram-mini-discount:v1:${telegramIdentity}`;
      const state = { view:"home", filter:"all", query:"", orderFilter:"all", cart:[], orders:[], pendingPayment:null, sessionReady:false, discountCode:"", discountDraft:"", discountQuote:null, discountQuoteFingerprint:"", discountBusy:false, discountError:"", shop:null };
      const $ = (selector) => document.querySelector(selector);
      const applyShopBranding = (shop, userFirstName = "") => {
        if (!shop || typeof shop !== "object") return;
        const shopName = String(shop.shopName || "").trim().slice(0, 64);
