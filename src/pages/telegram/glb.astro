      async function submitPaymentProof(event) { event?.preventDefault?.(); if (!state.payment || state.proofBusy) return; const file = $("#payment-proof-file")?.files?.[0]; const reference = $("#payment-proof-reference")?.value?.trim() || ""; if (!file && !reference) { showToast("Upload a proof or enter a transaction reference"); return; } if (file && file.size > 8 * 1024 * 1024) { showToast("Proof file must be 8 MB or smaller"); return; } const form = new FormData(); if (file) form.append("proof", file, file.name); if (reference) form.append("transactionReference", reference); const button = $("#submit-payment-proof"); state.proofBusy = true; if (button) { button.disabled = true; button.textContent = "Submitting…"; } try { const result = await api(`orders/${encodeURIComponent(state.payment.orderId)}/payment-proof`, { method:"POST", body:form }); if (result.proof) state.payment.proofs = [result.proof, ...(state.payment.proofs || [])]; const status = $("#payment-status"); if (status) { status.textContent = "Proof submitted · manual review"; status.classList.remove("is-paid"); } const list = $("#proof-list"); if (list) { list.hidden = false; list.outerHTML = proofListHtml(state.payment.proofs); } const help = $("#proof-help"); if (help) help.textContent = "Proof received. Our team will review it manually and update the order status."; showToast("Payment proof submitted"); beginPaymentPolling(); } catch (error) { const code = error?.code; showToast(code === "invalid_payment_proof" ? "Unsupported or invalid proof file" : code === "payment_proof_or_reference_required" ? "Upload a proof or enter a transaction reference" : "Unable to submit proof right now"); } finally { state.proofBusy = false; if (button) { button.disabled = false; button.textContent = "Confirm payment"; } } }
      async function pollPayment(force = false) {
        if (!state.payment || (!state.pollingEnabled && !force)) return;
        if (state.pollTimer) { window.clearTimeout(state.pollTimer); state.pollTimer = null; }
        if (force || !state.pollStartedAt) { state.pollStartedAt = Date.now(); state.pollAttempts = 0; }
        state.pollAttempts += 1;
        try {
          // Poll the compact status contract; payment proofs and order lines
          // stay on the full details request used when opening the modal.
          const result = await api(`orders/${encodeURIComponent(state.payment.orderId)}/status`);
          if (result.payment) {
            state.payment.payment = { ...state.payment.payment, ...result.payment };
          }
          const status = String(result.payment?.state || result.payment?.status || result.order?.payment_status || "awaiting_payment").toLowerCase();
          const node = $("#payment-status");
          if (node) { node.textContent = paymentStatusLabel(status); node.classList.toggle("is-paid", status === "paid"); }
          if (status === "paid") {
            const readiness = String(result.delivery?.readiness || "ready").toLowerCase();
            const help = $("#proof-help");
            if (help) help.textContent = readiness === "delivered" ? "Payment approved. Your keys have been delivered." : "Payment approved. Your keys are ready to reveal.";
            const form = $("#payment-proof-form");
            if (form) form.innerHTML = `<div class="proof-list"><strong>${readiness === "delivered" ? "Keys delivered" : "Payment approved"}</strong><span>${readiness === "delivered" ? "Open Orders to view them again." : "Tap below to reveal your license keys."}</span></div><button class="button primary" type="button" data-keys="${esc(state.payment.orderId)}">${readiness === "delivered" ? "View keys" : "Get keys"}</button>`;
            showToast("Payment approved");
            await loadOrders();
            state.pollingEnabled = false;
            state.pollTimer = null;
            return;
          }
        } catch (error) {
          // Do not keep silently polling when the Mini App session has expired;
          // the customer must reopen the app so Telegram can issue fresh initData.
          const code = error?.code;
          if (["telegram_session_required", "telegram_auth_required", "telegram_auth_invalid", "telegram_registry_unavailable"].includes(code)) {
            state.sessionReady = false;
            state.pollingEnabled = false;
            if (state.pollTimer) { window.clearTimeout(state.pollTimer); state.pollTimer = null; }
            setSessionError(error);
            return;
          }
        }
        // Stop background traffic after ten minutes. A manual Refresh status
        // click can restart the bounded window when the admin is still
        // reviewing the transfer.
        if (state.pollingEnabled && Date.now() - state.pollStartedAt < 10 * 60 * 1_000) {
          const delay = Math.min(15_000, 5_000 + Math.floor(state.pollAttempts / 6) * 1_000);
          state.pollTimer = window.setTimeout(() => { void pollPayment(); }, delay);
        } else {
          const help = $("#proof-help");
          state.pollingEnabled = false;
          if (help) help.textContent = "Still awaiting manual review. Tap Refresh status to check again.";
        }
      }
      async function loadOrders() { const list = $("#orders-list"); list.innerHTML = `<div class="empty">Loading orders…</div>`; try { const result = await api("me"); state.orders = Array.isArray(result.orders) ? result.orders : []; list.innerHTML = state.orders.length ? state.orders.map((order) => { const status = String(order.paymentStatus || order.status || "pending").toLowerCase(); const readiness = String(order.deliveryReadiness || "").toLowerCase(); const displayStatus = status === "paid" ? readiness === "delivered" ? "Delivered" : ["ready", "partial"].includes(readiness) ? "Paid · Keys ready" : "Paid" : ["confirming", "detected", "needs_review"].includes(status) ? "Manual review" : status === "expired" ? "Expired" : "Awaiting payment"; return `<article class="order-card"><header><div><h3>#${esc(order.number)}</h3><time>${esc(new Date(order.createdAt).toLocaleDateString("en-US"))}</time></div><span class="payment-status ${status === "paid" ? "is-paid" : ""}">${esc(displayStatus)}</span></header><p>${esc(order.itemCount || order.lineCount || 0)} item(s) · ${money(order.totalMinor)}</p><div class="order-actions"><button class="button" data-order="${esc(order.id)}" type="button">View details</button>${status === "paid" ? `<button class="button primary" data-keys="${esc(order.id)}" type="button">${readiness === "delivered" ? "View keys" : "Get keys"}</button>` : ""}</div></article>`; }).join("") : `<div class="empty">No orders yet.</div>`; } catch (error) { list.innerHTML = `<div class="empty">${esc(error.code === "telegram_auth_required" ? "Open this page from Telegram to load orders." : "Unable to load orders right now.")}</div>`; } }
      async function showOrder(id) { try { const result = await api(`orders/${encodeURIComponent(id)}`); const payment = result.payment; const number = result.order.order_number || result.order.orderNumber; if (payment) { state.payment = { orderId: id, number, payment, proofs: Array.isArray(payment.paymentProofs) ? payment.paymentProofs : [] }; state.pollingEnabled = false; state.pollStartedAt = 0; state.pollAttempts = 0; openModal("Payment instructions", paymentMarkup()); if (shouldPollPayment(payment, state.payment.proofs)) beginPaymentPolling(); return; } openModal(`Order #${esc(number)}`, `<p class="modal-copy">This order has no active crypto payment attempt.</p><div class="modal-actions"><button class="button" data-close-modal type="button">Close</button></div>`); } catch { showToast("Unable to load this order"); } }
      async function showKeys(id) { try { const result = await api(`orders/${encodeURIComponent(id)}/keys`, { method:"POST", body:"{}" }); const keys = result.delivery?.deliveries?.flatMap((item) => item.keys || []) || []; openModal("Your digital keys", keys.length ? `<div class="payment-box"><span class="payment-status is-paid">Delivered</span>${keys.map((key, index) => paymentField(`Key ${index + 1}`, key)).join("")}</div>` : `<div class="empty">The order is paid, but fulfillment is still processing.</div>`); await loadOrders(); } catch (error) { showToast(error.code === "order_not_paid" ? "Payment is not verified yet" : error.code === "order_delivery_in_progress" ? "Your payment is approved; key delivery is still processing. Try again shortly." : "Keys are not available yet"); } }
      document.addEventListener("click", (event) => { const target = event.target.closest("button,[data-nav]"); if (!target) return; if (target.dataset.nav) { showView(target.dataset.nav); return; } if (target.id === "browse-button") { showView("home"); $("#catalog")?.scrollIntoView({ behavior:"smooth" }); return; } 
        if (target.dataset.shareBridge !== undefined) {
          // Share cart link handler
          void (async () => {
            if (!state.cart.length) { showToast("Cart is empty"); return; }
            try {
              const attr = JSON.parse(localStorage.getItem("tung:shop:attribution:v1") || "null");
              const res = await fetch("/api/shop/bridge", {
                method: "POST",
                headers: { "content-type": "application/json" },
                body: JSON.stringify({
                  items: state.cart.map((item) => {
                    const v = variantById(item.variantId);
                    return {
                      variantId: item.variantId, quantity: item.quantity,
                      title: v?.product?.title, variantTitle: v?.title,
                      priceMinor: v?.priceMinor, currency: "USD",
                      imageUrl: v?.product?.imageUrl || v?.product?.coverUrl,
                      slug: v?.product?.slug, productId: v?.product?.id,
                      maxQuantity: v?.maxPerOrder || 10,
                    };
                  }),
                  attribution: attr, channel: "telegram_glb",
                }),
              });
              const data = await res.json();
              if (!res.ok || !data.url) throw new Error(data.code || "failed");
              if (navigator.clipboard?.writeText) await navigator.clipboard.writeText(data.url);
              showToast("Cart link copied");
            } catch { showToast("Could not create cart link"); }
          })();
          return;
        }
        if (target.dataset.suggestProducts !== undefined) {
          void (async () => {
            try {
              const q = state.query || "ai tools";
              const res = await fetch(`/api/shop/recommend?locale=en&limit=4&q=${encodeURIComponent(q)}`);
              const data = await res.json();
              if (!data.ok) throw new Error("fail");
              const rows = (data.results || []).map((r) => {
                const p = r.product || {};
                return `<button type="button" class="button secondary" data-open-product="${esc(p.slug || "")}" style="width:100%;text-align:left;margin:6px 0"><strong>${esc(p.title || "")}</strong><br><small>${esc((r.reasons||[]).join(" · "))}</small></button>`;
              }).join("");
              openModal("Suggested packages", `<p class="modal-copy">${esc(data.assistantMessage || "")}</p>${rows || "<div class=\"empty\">No suggestions.</div>"}`);
            } catch { showToast("Could not load suggestions"); }
          })();
          return;
        }
if (target.id === "checkout-button") { void checkout(); return; } if (target.id === "confirm-checkout") { void createCheckout(); return; } if (target.id === "refresh-orders") { void loadOrders(); return; } if (target.id === "session-retry") { void bootstrapSession(); return; } if (target.id === "modal-close" || target.dataset.closeModal !== undefined) { closeModal(); return; } if (target.dataset.selectPlan) { selectPlanInSheet(target.dataset.productSlug, target.dataset.selectPlan); return; } if (target.dataset.openProduct) { openProduct(target.dataset.openProduct); return; } if (target.dataset.buyNow) { void buyNow(target.dataset.buyNow); return; } if (target.dataset.add) { if (add(target.dataset.add)) { haptic("light"); closeModal(); } return; } if (target.dataset.qty) { updateQuantity(target.dataset.qty, Number(target.dataset.delta)); return; } if (target.dataset.remove) { state.cart = state.cart.filter((item) => item.variantId !== target.dataset.remove); writeCart(); return; } if (target.dataset.method) { state.selectedMethodId = target.dataset.method; $("#modal-body").innerHTML = checkoutPanel(); return; } if (target.dataset.copy) { void copyValue(target.dataset.copy); return; } if (target.dataset.order) { void showOrder(target.dataset.order); return; } if (target.dataset.keys) { void showKeys(target.dataset.keys); return; } if (target.id === "refresh-payment") { void pollPayment(true); } });
      document.addEventListener("submit", (event) => { if (event.target?.id === "payment-proof-form") void submitPaymentProof(event); });
      $("#search").addEventListener("input", (event) => { state.query = event.currentTarget.value; renderCatalog(); });
      document.addEventListener("change", (event) => { const target = event.target; if (!target.matches("[data-variant]")) return; const addButton = target.closest(".product-body")?.querySelector("[data-add]"); if (addButton) addButton.dataset.add = target.value; });
      $("#modal-backdrop").addEventListener("click", (event) => { if (event.target.id === "modal-backdrop") closeModal(); });
      const haptic = (kind) => { try { if (kind === "success" || kind === "error") tg?.HapticFeedback?.notificationOccurred?.(kind); else tg?.HapticFeedback?.impactOccurred?.(kind || "light"); } catch {} };
      try { tg?.BackButton?.onClick?.(() => closeModal()); } catch {}
      tg?.ready?.(); tg?.expand?.();
      try { tg.setHeaderColor?.("#ffffff"); tg.setBackgroundColor?.("#ffffff"); } catch {}
      document.documentElement.dataset.tgScheme = tg?.colorScheme || "light";
      tg?.onEvent?.("themeChanged", () => { document.documentElement.dataset.tgScheme = tg.colorScheme || "light"; });
      // F1/F8: capture affiliate + promo from deep link / start_param (AI path not used here)
      try {
        const ATTR_KEY = "tung:shop:attribution:v1";
        const params = new URLSearchParams(location.search);
        let start = "";
        try { start = String(window.Telegram?.WebApp?.initDataUnsafe?.start_param || ""); } catch {}
        if (start) {
          start.split(/__|_/).forEach((part) => {
            if (/^ref/i.test(part) && part.length > 3) params.set("ref", part.replace(/^ref[_-]?/i, ""));
            else if (/^discount|promo|code/i.test(part)) params.set("discount", part.replace(/^(discount|promo|code)[_-]?/i, ""));
            else if (/^[A-Z0-9_-]{3,}$/i.test(part) && !params.get("ref")) params.set("ref", part);
          });
        }
        const existing = (() => { try { return JSON.parse(localStorage.getItem(ATTR_KEY) || "{}"); } catch { return {}; } })();
        const clean = (v) => String(v || "").trim().toUpperCase().replace(/[^A-Z0-9_-]/g, "").slice(0, 40);
        const next = {
          ...existing,
          channel: "telegram_glb",
          ref: clean(params.get("ref") || params.get("affiliate") || existing.ref || "") || existing.ref || null,
          discountCode: clean(params.get("discount") || params.get("promo") || params.get("code") || existing.discountCode || "") || existing.discountCode || null,
          capturedAt: existing.capturedAt || new Date().toISOString(),
          landingPath: "/telegram/glb",
        };
        localStorage.setItem(ATTR_KEY, JSON.stringify(next));
      } catch {}
      renderCatalog(); renderCart(); void (async () => { await waitForInitData(); await bootstrapSession(); })();
    </script>
  </body>
