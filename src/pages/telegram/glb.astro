---
import { env } from "cloudflare:workers";
import { serializeMiniCatalog } from "../../lib/shop/product-view";
import { listPublicProducts } from "../../lib/shop/repository";

export const prerender = false;
Astro.response.headers.set("Cache-Control", "private, no-store, max-age=0");
Astro.response.headers.set("Cloudflare-CDN-Cache-Control", "no-store, max-age=0");
Astro.response.headers.set("CDN-Cache-Control", "no-store, max-age=0");
Astro.response.headers.set("Pragma", "no-cache");
Astro.response.headers.set("X-Robots-Tag", "noindex, nofollow");

const botConfigId = Astro.url.searchParams.get("bot")?.match(/^[A-Za-z0-9_-]{8,80}$/)?.[0] ?? "";
const products = env.CONTENT_DB
  ? await listPublicProducts(env.CONTENT_DB, { locale: "en", limit: 60 }).catch(() => [])
  : [];
const serializedCatalog = serializeMiniCatalog(products);
---

<!doctype html>
<html lang="en" data-currency="USD">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="robots" content="noindex,nofollow" />
    <link rel="preconnect" href="https://telegram.org" />
    <title>GLB Store · Global digital goods</title>
    <script is:inline src="https://telegram.org/js/telegram-web-app.js"></script>
<style is:global>

      /* ══════════════════════════════════════════════════════════════
         GLB Store · Telegram Mini App
         Design System v6 — Porcelain White (unified with VN mini app)
         ══════════════════════════════════════════════════════════════ */

      /* ── Design Tokens ─────────────────────────────────────────── */
      :root {
        --shop-bg: #ffffff;
        --shop-bg-soft: #f6f7f9;
        --shop-surface: #ffffff;
        --shop-surface-alt: #fafbfc;
        --shop-ink: #0b0f1a;
        --shop-ink-soft: #4b5565;
        --shop-ink-muted: #9aa3b2;
        --shop-accent: #0b0f1a;
        --shop-accent-hover: #252e42;
        --shop-accent-ink: #ffffff;
        --shop-mint: #0da678;
        --shop-mint-soft: #e8f8f1;
        --shop-sun: #e8930c;
        --shop-sun-soft: #fdf4e3;
        --shop-danger: #e0483f;
        --shop-danger-soft: #fdeeed;
        --ink: var(--shop-bg);
        --ink-soft: var(--shop-bg-soft);
        --surface: var(--shop-surface);
        --paper: var(--shop-ink);
        --paper-soft: var(--shop-ink-soft);
        --line: #e9ecf1;
        --line-strong: #d4dae3;
        --accent: var(--shop-accent);
        --accent-ink: #ffffff;
        --danger: var(--shop-danger);
        --card: var(--shop-surface);
        --card-shadow: 0 1px 2px rgba(16, 24, 40, 0.04), 0 8px 24px -8px rgba(16, 24, 40, 0.08);
        --nav: rgba(255, 255, 255, 0.94);
        --notice: var(--shop-bg-soft);
        --cta-primary: var(--shop-ink);
        --cta-primary-press: var(--shop-accent-hover);
        --cta-primary-ink: #ffffff;
        --cta-secondary-bg: #ffffff;
        --cta-secondary-ink: var(--shop-ink);
        --cta-secondary-line: var(--line-strong);
        --cta-shadow: 0 1px 2px rgba(11, 15, 26, 0.2), 0 10px 24px -10px rgba(11, 15, 26, 0.32);
        --font-sans: "Plus Jakarta Sans", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", sans-serif;
        --font-serif: "Plus Jakarta Sans", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", sans-serif;
        --font-mono: "SFMono-Regular", Menlo, Consolas, monospace;
        --ease: cubic-bezier(0.16, 1, 0.3, 1);
        --ease-spring: cubic-bezier(0.3, 1.4, 0.4, 1);
        color-scheme: light;
      }

      /* ── Reset & Base ──────────────────────────────────────────── */
      * { box-sizing:border-box; }
      html,body {
        margin:0; min-height:100%;
        background-color:var(--shop-bg);
        color:var(--paper);
        font-family:var(--font-sans);
        -webkit-font-smoothing:antialiased;
      }
      body {
        padding:env(safe-area-inset-top) 12px calc(88px + env(safe-area-inset-bottom));
        background-image:radial-gradient(72% 30% at 50% -40px, rgba(59, 130, 246, 0.045), transparent 72%);
        background-repeat:no-repeat;
      }
      body.cart-dock-visible { padding-bottom:calc(168px + env(safe-area-inset-bottom)); }
      body.modal-open { overflow:hidden; }
      button,input,select { font:inherit; }
      button { color:inherit; cursor:pointer; touch-action:manipulation; -webkit-tap-highlight-color:transparent; }
      button:focus-visible,input:focus-visible,select:focus-visible { outline:2px solid var(--accent); outline-offset:2px; }
      img { display:block; }
      .app { width:100%; max-width:760px; margin:0 auto; }
      .shell { width:100%; max-width:860px; margin:0 auto; }

      /* ── Topbar ─────────────────────────────────────────────────── */
      .topbar {
        display:flex; align-items:center; justify-content:space-between;
        margin-bottom:12px; padding:10px 12px;
        border:1px solid var(--line); border-radius:0.95rem;
        background:var(--surface);
        box-shadow:0 1px 2px rgba(16,24,40,0.03);
      }
      .brand { display:flex; align-items:center; gap:10px; min-width:0; font:700 14px/1 var(--font-sans); letter-spacing:-0.01em; color:var(--paper); }
      .brand-mark {
        display:grid; place-items:center; width:28px; height:28px;
        background:linear-gradient(160deg, #1c2536, var(--shop-ink)); color:#fff; border-radius:8px;
        font:800 14px/1 var(--font-sans);
        box-shadow:0 2px 6px -1px rgba(11,15,26,0.3), inset 0 1px 0 rgba(255,255,255,0.14);
      }
      .identity { display:flex; align-items:center; gap:10px; text-align:right; }
      .identity span { display:grid; }
      .identity strong { font:700 13px/1 var(--font-sans); color:var(--paper); }
      .identity small { font:600 10px/1 var(--font-mono); color:var(--shop-ink-muted); text-transform:uppercase; margin-top:3px; letter-spacing:.06em; }
      .identity .avatar {
        display:grid; place-items:center; width:34px; height:34px;
        border-radius:50%; background:var(--notice); border:1px solid var(--line);
        color:var(--paper); font:700 13px/1 var(--font-sans);
      }

      /* ── Hero ───────────────────────────────────────────────────── */
      .hero {
        position:relative; overflow:hidden;
        padding:16px 14px 14px; border:1px solid var(--line); border-radius:1.1rem;
        background:
          radial-gradient(80% 120% at 85% -20%, rgba(59,130,246,0.05), transparent 70%),
          radial-gradient(60% 100% at 10% 120%, rgba(13,166,120,0.05), transparent 70%),
          var(--surface);
        text-align:left; margin-bottom:4px;
        box-shadow:0 1px 2px rgba(16,24,40,0.03);
      }
      .hero-kicker, .kicker {
        display:inline-flex; align-items:center; gap:6px;
        font:700 10px/1 var(--font-sans); letter-spacing:.05em;
        text-transform:uppercase; color:var(--paper-soft); margin-bottom:8px;
        padding:5px 10px; border:1px solid var(--line); border-radius:999px;
        background:var(--shop-surface-alt);
      }
      .hero h1 { margin:0 0 10px; font:800 clamp(1.3rem, 5.5vw, 1.65rem)/1.15 var(--font-sans); letter-spacing:-0.03em; color:var(--paper); }
      .hero h1 em { font-style:normal; color:var(--paper); background:linear-gradient(120deg, var(--shop-mint), #3b82f6); -webkit-background-clip:text; background-clip:text; -webkit-text-fill-color:transparent; }
      .hero p { margin:0 auto 16px; max-width:480px; color:var(--paper-soft); font:13px/1.6 var(--font-sans); }
      .hero-foot { display:flex; flex-direction:row; align-items:center; justify-content:space-between; gap:10px; width:100%; }
      .signal { display:flex; align-items:center; gap:8px; color:var(--paper-soft); font:700 10px/1 var(--font-mono); letter-spacing:.06em; text-transform:uppercase; }
      .signal:before { width:8px; height:8px; border-radius:50%; background:var(--shop-mint); box-shadow:0 0 0 4px rgba(13,166,120,0.14); content:""; flex:0 0 auto; }

      /* ── Session error ──────────────────────────────────────────── */
      .session-error {
        display:grid; grid-template-columns:minmax(0,1fr) auto; gap:12px; align-items:center;
        margin-top:12px; border-radius:0.9rem; padding:14px;
        border:1px solid rgba(224,72,63,.28); background:var(--shop-danger-soft);
      }
      .session-error span { display:block; font:700 10px/1 var(--font-mono); letter-spacing:.08em; text-transform:uppercase; color:#b03830; }
      .session-error strong { display:block; margin-top:4px; font:700 1.05rem/1.2 var(--font-sans); color:var(--paper); }
      .session-error p { margin:4px 0 0; color:var(--paper-soft); font-size:.76rem; line-height:1.4; }
      .session-error button { min-height:40px; border:1px solid var(--danger); border-radius:.6rem; background:var(--danger); color:#fff; font:650 11px/1 var(--font-sans); padding:0 14px; }

      /* ── View layout ────────────────────────────────────────────── */
      .view { display:none; padding-bottom:32px; }
      .view.is-active { display:block; animation:viewIn .35s var(--ease) both; }
      @keyframes viewIn { from { opacity:0; transform:translateY(14px); } to { opacity:1; transform:none; } }
      .section-head, .toolbar { display:flex; align-items:flex-end; justify-content:space-between; gap:12px; margin:22px 0 14px; }
      .section-head h2, .toolbar h2 { margin:0; font:800 clamp(1.15rem, 4.5vw, 1.4rem)/1.15 var(--font-sans); letter-spacing:-0.03em; color:var(--paper); }
      .section-head > span, .toolbar p { color:var(--paper-soft); font-size:12px; font-weight:600; padding-bottom:4px; margin:0; }
      .title-button {
        min-height:38px; padding:0 13px; border:1px solid var(--line-strong); border-radius:999px;
        background:var(--surface); color:var(--paper);
        font:650 11.5px/1 var(--font-sans); white-space:nowrap;
        transition:transform .15s ease, border-color .15s ease, background .15s ease;
      }
      .title-button:active { transform:scale(.96); background:var(--shop-surface-alt); border-color:#b9c2d0; }

      /* ── Catalog ────────────────────────────────────────────────── */
      .search {
        display:flex; align-items:center; gap:10px; min-height:46px;
        padding:0 16px; border:1px solid var(--line-strong); border-radius:999px;
        background:var(--surface); color:var(--paper-soft);
        box-shadow:0 1px 2px rgba(16,24,40,0.03);
        transition:border-color .2s, box-shadow .2s;
      }
      .search:focus-within { border-color:var(--paper); box-shadow:0 0 0 4px rgba(11,15,26,0.07); }
      .search input { width:100%; min-width:0; border:0; outline:0; background:transparent; color:var(--paper); font:14.5px/1 var(--font-sans); }
      .search input::placeholder { color:var(--shop-ink-muted); }
      .grid, .catalog { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:12px; }
      .product {
        display:grid; grid-template-rows:minmax(168px, 42vw) 1fr;
        border:1px solid var(--line); border-radius:1rem;
        background:var(--surface); overflow:hidden;
        box-shadow:0 1px 2px rgba(16,24,40,0.03);
        animation:productUp .4s var(--ease) both;
        transition:transform .18s var(--ease), box-shadow .18s var(--ease);
      }
      @media (min-width:400px) { .product { grid-template-rows:minmax(188px, 44vw) 1fr; } }
      .product:nth-child(2) { animation-delay:.04s; }
      .product:nth-child(3) { animation-delay:.08s; }
      .product:nth-child(4) { animation-delay:.12s; }
      @keyframes productUp { from { opacity:0; transform:translateY(18px) scale(.98); } to { opacity:1; transform:none; } }
      .product:active { transform:scale(0.985); }
      .product-media { position:relative; background:var(--shop-bg-soft); overflow:hidden; display:flex; align-items:center; justify-content:center; min-height:0; padding:0; }
      .product-media img { width:100%; height:100%; object-fit:cover; object-position:center; }
      .media-placeholder, .placeholder { width:100%; height:100%; display:grid; place-items:center; font:800 1.5rem/1 var(--font-sans); color:var(--shop-ink-muted); }
      .product-body { padding:12px; display:flex; flex-direction:column; gap:4px; }
      .product-body h3 { margin:0; font:700 14px/1.2 var(--font-sans); letter-spacing:-0.015em; color:var(--paper); display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; }
      .product-body p { margin:0; color:var(--paper-soft); font-size:11.5px; line-height:1.4; display:-webkit-box; -webkit-line-clamp:1; -webkit-box-orient:vertical; overflow:hidden; }
      .product-foot { margin-top:auto; padding-top:10px; display:flex; align-items:center; justify-content:space-between; gap:8px; }
      .price { display:grid; gap:3px; font:800 15px/1.05 var(--font-sans); letter-spacing:-0.02em; color:var(--paper); }
      .price small { color:var(--shop-mint); font:650 9px/1 var(--font-mono); letter-spacing:.04em; text-transform:uppercase; }
      .price del { display:block; color:var(--paper-soft); font-size:10px; font-weight:700; text-decoration:line-through; }
      .badge, .product-badge { display:inline-flex; align-items:center; min-height:20px; padding:0 8px; border-radius:999px; background:var(--shop-bg-soft); color:var(--paper-soft); font:700 9.5px/1 var(--font-sans); }

      /* ── Bottom Nav ─────────────────────────────────────────────── */
      .bottom-nav { position:fixed; z-index:20; right:12px; bottom:calc(12px + env(safe-area-inset-bottom)); left:12px; pointer-events:none; }
      .bottom-nav-inner {
        display:flex; max-width:400px; margin:auto;
        border:1px solid var(--line); border-radius:999px;
        background:var(--nav); padding:6px;
        backdrop-filter:blur(20px) saturate(1.3); box-shadow:0 4px 12px rgba(16,24,40,0.06), 0 16px 40px -12px rgba(16,24,40,0.22);
        pointer-events:auto;
      }
      .nav-button {
        flex:1; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:4px;
        min-height:54px; border-radius:999px; color:var(--paper-soft); font:650 9.5px/1 var(--font-sans); text-transform:uppercase; letter-spacing:.04em; transition:all .2s;
      }
      .nav-button svg { width:22px; height:22px; fill:none; stroke:currentColor; stroke-width:2.2; stroke-linecap:round; stroke-linejoin:round; }
      .nav-button.is-active { background:var(--paper); color:#fff; box-shadow:0 4px 12px rgba(11,15,26,0.28); }
      .nav-button:active { transform:scale(.92); }
      .cart-count { display:inline-flex; min-width:18px; height:18px; align-items:center; justify-content:center; border-radius:999px; background:var(--shop-mint); color:#fff; font:700 10px/1 var(--font-sans); margin-left:4px; }
      .nav-button.is-active .cart-count { background:#fff; color:var(--paper); }

      /* ── Checkout bar ───────────────────────────────────────────── */
      .checkout-bar {
        position:fixed; z-index:15; right:12px; left:12px;
        bottom:calc(72px + env(safe-area-inset-bottom));
        display:flex; align-items:center; justify-content:space-between; gap:12px;
        padding:12px 14px;
        border:1px solid var(--line); border-radius:1.15rem;
        background:rgba(255,255,255,0.96);
        backdrop-filter:blur(18px) saturate(1.15);
        box-shadow:0 2px 6px rgba(16,24,40,0.05), 0 20px 48px -16px rgba(16,24,40,0.24);
        animation:dockUp .35s var(--ease-spring) both;
      }
      @keyframes dockUp { from { transform:translateY(100%); } to { transform:none; } }
      .checkout-bar[hidden] { display:none !important; }
      .checkout-bar > div { min-width:0; display:grid; gap:3px; }
      .checkout-bar small { display:block; color:var(--paper-soft); font:650 11px/1.2 var(--font-sans); }
      .checkout-bar strong { font:800 19px/1.1 var(--font-sans); color:var(--paper); letter-spacing:-0.02em; }

      /* ── Cart ───────────────────────────────────────────────────── */
      .cart-list { display:grid; gap:12px; }
      .cart-row { display:grid; grid-template-columns:minmax(0,1fr) auto; gap:12px; align-items:center; border:1px solid var(--line); border-radius:1rem; background:var(--surface); padding:14px; box-shadow:0 1px 2px rgba(16,24,40,0.03); }
      .cart-row strong { display:block; font:650 14px/1.25 var(--font-sans); color:var(--paper); margin-bottom:3px; }
      .cart-row small { color:var(--paper-soft); font-size:12px; }
      .cart-controls { display:inline-flex; align-items:center; gap:2px; background:var(--shop-bg-soft); border:1px solid var(--line); border-radius:999px; padding:3px; }
      .cart-controls button { width:30px; height:30px; border-radius:50%; font-size:17px; display:grid; place-items:center; color:var(--paper); background:transparent; }
      .cart-controls button:active { background:rgba(11,15,26,0.06); }
      .cart-controls b { min-width:30px; text-align:center; font:650 13px/30px var(--font-mono); }
      .cart-controls button[data-remove] { background:transparent; color:var(--shop-ink-muted); font:650 10px/1 var(--font-sans); text-transform:uppercase; min-width:auto; width:auto; padding:0 8px; border-radius:999px; }
      .cart-total { display:flex; justify-content:space-between; margin-top:12px; border-top:1px solid var(--line); padding-top:13px; font-size:13px; font-weight:650; color:var(--paper-soft); }
      .cart-total strong { font-size:20px; color:var(--paper); letter-spacing:-0.02em; }
      .empty { display:grid; justify-items:center; gap:8px; padding:36px 16px; border:1px dashed var(--line-strong); border-radius:1rem; background:var(--shop-surface-alt); color:var(--paper-soft); text-align:center; font:600 13px/1.5 var(--font-sans); }

      /* ── Modals (bottom sheets) ─────────────────────────────────── */
      .modal-backdrop { position:fixed; z-index:30; inset:0; display:none; align-items:flex-end; background:rgba(11,15,26,.32); backdrop-filter:blur(6px); }
      .modal-backdrop.is-open { display:flex; animation:fadeIn .2s both; }
      @keyframes fadeIn { from{opacity:0} to{opacity:1} }
      .modal {
        width:100%; max-width:600px; max-height:94dvh; margin:0 auto;
        display:flex; flex-direction:column; overflow:hidden;
        border:1px solid var(--line); border-bottom:0; border-radius:24px 24px 0 0;
        background:var(--shop-bg); padding:16px 16px 0;
        box-shadow:0 -12px 48px rgba(11,15,26,0.22);
        animation:sheetIn .35s var(--ease-spring) both;
      }
      @keyframes sheetIn { from { transform:translateY(100%); } to { transform:none; } }
      .modal-grip { width:40px; height:5px; border-radius:999px; background:var(--line-strong); margin:0 auto 12px; flex:0 0 auto; }
      .modal-head { display:flex; align-items:center; justify-content:space-between; gap:12px; margin-bottom:12px; flex:0 0 auto; }
      .modal-head h2 { margin:0; font:800 clamp(1.15rem, 5vw, 1.4rem)/1.15 var(--font-sans); letter-spacing:-0.02em; color:var(--paper); }
      .modal-close { width:36px; height:36px; border:1px solid var(--line); border-radius:50%; background:var(--surface); color:var(--paper-soft); font-size:20px; display:grid; place-items:center; }
      .modal-close:active { transform:scale(.9); }
      .modal-body { flex:1 1 auto; min-height:0; overflow-y:auto; padding:0 0 calc(16px + env(safe-area-inset-bottom)); -webkit-overflow-scrolling:touch; }
      .modal-body:has(.product-sheet) { overflow:hidden; display:flex; flex-direction:column; padding-bottom:0; }
      .modal-copy { color:var(--paper-soft); font:13.5px/1.55 var(--font-sans); margin:0 0 12px; }
      .modal-actions { display:flex; flex-wrap:wrap; gap:8px; margin-top:14px; }

      /* ── Payment ────────────────────────────────────────────────── */
      .method-list { display:grid; gap:8px; margin:16px 0; }
      .method-choice {
        display:grid; grid-template-columns:minmax(0,1fr) auto; gap:12px; align-items:center;
        border:1px solid var(--line); border-radius:1rem; background:var(--surface); padding:14px;
        text-align:left; transition:all .2s;
      }
      .method-choice:active { transform:scale(.98); }
      .method-choice.is-selected { border-color:var(--paper); background:var(--shop-surface-alt); box-shadow:0 0 0 1px var(--paper); }
      .method-choice-main { display:flex; min-width:0; align-items:center; gap:12px; }
      .method-choice strong { display:block; overflow:hidden; font-size:14px; font-weight:700; color:var(--paper); text-overflow:ellipsis; white-space:nowrap; }
      .method-choice small { display:block; margin-top:4px; color:var(--paper-soft); font-size:11px; }
      .method-choice b { font:700 12px/1 var(--font-mono); color:var(--paper-soft); text-transform:uppercase; }
      .network-mark { display:grid; flex:0 0 auto; width:36px; height:36px; place-items:center; border:1px solid var(--line); border-radius:50%; background:var(--shop-bg-soft); color:var(--paper); font-size:13px; font-weight:800; }
      .network-mark svg { width:20px; height:20px; fill:currentColor; }
      .network-mark[data-network="ETHEREUM"] { background:#eff6ff; color:#1d4ed8; border-color:#bfdbfe; }
      .network-mark[data-network="BSC"] { background:#fefce8; color:#a16207; border-color:#fde047; }
      .network-mark[data-network="SOLANA"] { background:#f3e8ff; color:#6b21a8; border-color:#d8b4fe; }
      .network-mark[data-network="POLYGON"] { background:#faf5ff; color:#7e22ce; border-color:#e9d5ff; }
      .network-mark[data-network="TRON"] { background:#fff1f2; color:#be123c; border-color:#fecdd3; }
      .network-line { display:flex; align-items:center; gap:7px; margin-top:6px; color:var(--paper-soft); font-size:11px; }
      .network-line .network-mark { width:20px; height:20px; border-width:1px; font-size:9px; }
      .network-line .network-mark svg { width:12px; height:12px; }
      .payment-box { display:grid; gap:16px; border:1px solid var(--line); border-radius:1.25rem; background:var(--shop-surface-alt); padding:18px; margin-top:16px; }
      .payment-box h3 { color:var(--paper); font:700 18px/1.2 var(--font-sans); margin:0; }
      .payment-box p { margin:0; color:var(--paper-soft); font-size:13px; line-height:1.5; }
      .payment-amount { display:flex; align-items:end; justify-content:space-between; gap:10px; border-bottom:1px solid var(--line); padding-bottom:12px; }
