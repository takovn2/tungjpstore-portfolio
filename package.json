{
  "name": "tungjpstore-portfolio",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "postbuild": "node scripts/prepare-worker-entry.mjs",
    "check": "astro check",
    "test:smoke": "node --experimental-strip-types --test tests/*.smoke.test.mjs",
    "test:e2e": "node --experimental-strip-types --test tests/*.e2e.test.mjs",
    "test:all": "npm run test:smoke && npm run test:e2e",
    "cms:seed:dry-run": "node --experimental-strip-types scripts/seed-content.mjs --dry-run",
    "cms:seed:generate": "node --experimental-strip-types scripts/seed-content.mjs --write",
    "cms:seed:check": "node --experimental-strip-types scripts/seed-content.mjs --check",
    "cms:seed:apply": "node --experimental-strip-types scripts/seed-content.mjs --apply",
    "deploy": "npm run build && wrangler deploy --config dist/server/wrangler.json",
    "preview": "astro preview",
    "astro": "astro",
    "image:generate": "node scripts/generate-image.mjs",
    "image:brand": "node scripts/build-brand-assets.mjs",
    "image:project-covers": "node scripts/build-project-covers.mjs",
    "image:logivn-showcase": "node scripts/build-logivn-showcase.mjs",
    "image:fball-showcase": "node scripts/build-fball-showcase.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.1.4",
    "@astrojs/react": "^6.0.2",
    "@lobehub/icons-static-svg": "^1.94.0",
    "astro": "^7.1.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@cloudflare/workers-types": "^5.20260723.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "typescript": "^6.0.3",
    "wrangler": "^4.113.0"
  }
}
